{"type":"tool_use","timestamp":1790451409190,"sessionID":"ses_f20cc3857ffezDR2odMktEeN9P","part":{"type":"tool","tool":"read","callID":"read_25_57ee9a73","state":{"status":"completed","input":{"filePath":"/workspace/scripts/weapon_manager.gd"},"output":"<path>/workspace/scripts/weapon_manager.gd</path>\n<type>file</type>\n<content>\n1: extends Node3D\n2: \n3: @onready var view_model_container: Node3D = $ViewModel\n4: \n5: func _ready() -> void:\n6: \tapply_clip_and_fov_shader_to_view_model(view_model_container, 54.0)\n7: \n8: func apply_clip_and_fov_shader_to_view_model(node3d: Node3D, fov_or_negative_for_unchanged := -1.0) -> void:\n9: \tvar shader := load(\"res://shaders/weapon_clip_and_fov_shader.gdshader\") as Shader\n10: \tvar mesh_instances: Array[MeshInstance3D] = []\n11: \t_collect_mesh_instances(node3d, mesh_instances)\n12: \n13: \tfor mesh_instance in mesh_instances:\n14: \t\tvar mesh := mesh_instance.mesh\n15: \t\tif mesh == null:\n16: \t\t\tcontinue\n17: \n18: \t\tvar material_count: int = max(mesh_instance.get_surface_override_material_count(), mesh.get_surface_count())\n19: \n20: \t\tfor surface_index in material_count:\n21: \t\t\tvar base_material: Material = null\n22: \t\t\tif surface_index < mesh_instance.get_surface_override_material_count():\n23: \t\t\t\tvar override_material := mesh_instance.get_surface_override_material(surface_index)\n24: \t\t\t\tif override_material != null:\n25: \t\t\t\t\tbase_material = override_material\n26: \t\t\tif base_material == null and surface_index < mesh.get_surface_count():\n27: \t\t\t\tbase_material = mesh.surface_get_material(surface_index)\n28: \t\t\tif base_material == null:\n29: \t\t\t\tcontinue\n30: \n31: \t\t\tvar shader_material := ShaderMaterial.new()\n32: \t\t\tshader_material.shader = shader\n33: \t\t\t_copy_material_parameters(base_material, shader_material)\n34: \n35: \t\t\tif fov_or_negative_for_unchanged >= 0.0:\n36: \t\t\t\tshader_material.set_shader_parameter(\"viewmodel_fov\", fov_or_negative_for_unchanged)\n37: \n38: \t\t\tmesh_instance.set_surface_override_material(surface_index, shader_material)\n39: \t\t\tmesh_instance.set_instance_shader_parameter(\"viewmodel_fov\", fov_or_negative_for_unchanged)\n40: \n41: func _collect_mesh_instances(node: Node, results: Array[MeshInstance3D]) -> void:\n42: \tif node is MeshInstance3D:\n43: \t\tresults.append(node)\n44: \tfor child in node.get_children():\n45: \t\t_collect_mesh_instances(child, results)\n46: \n47: func _copy_material_parameters(base_material: Material, shader_material: ShaderMaterial) -> void:\n48: \tif base_material is StandardMaterial3D:\n49: \t\tvar standard := base_material as StandardMaterial3D\n50: \t\tshader_material.set_shader_parameter(\"albedo\", standard.albedo_color)\n51: \t\tshader_material.set_shader_parameter(\"metallic\", standard.metallic)\n52: \t\tshader_material.set_shader_parameter(\"roughness\", standard.roughness)\n53: \t\tshader_material.set_shader_parameter(\"specular\", 0.5)\n54: \t\tif standard.albedo_texture != null:\n55: \t\t\tshader_material.set_shader_parameter(\"texture_albedo\", standard.albedo_texture)\n56: \t\t\tvar albedo := standard.albedo_color\n57: \t\t\talbedo.a = 1.0\n58: \t\t\tshader_material.set_shader_parameter(\"albedo\", albedo)\n59: \t\tif standard.metallic_texture != null:\n60: \t\t\tshader_material.set_shader_parameter(\"texture_metallic\", standard.metallic_texture)\n61: \t\t\tshader_material.set_shader_parameter(\"metallic_texture_channel\", Vector4(float(standard.metallic_texture_channel == 0), float(standard.metallic_texture_channel == 1), float(standard.metallic_texture_channel == 2), float(standard.metallic_texture_channel == 3)))\n62: \t\tif standard.roughness_texture != null:\n63: \t\t\tshader_material.set_shader_parameter(\"texture_roughness\", standard.roughness_texture)\n64: \t\tif standard.normal_texture != null:\n65: \t\t\tshader_material.set_shader_parameter(\"texture_normal\", standard.normal_texture)\n66: \t\t\tshader_material.set_shader_parameter(\"normal_scale\", standard.normal_scale)\n67: \t\tshader_material.set_shader_parameter(\"uv1_scale\", standard.uv1_scale)\n68: \t\tshader_material.set_shader_parameter(\"uv1_offset\", standard.uv1_offset)\n69: \t\tif standard.uv2_scale != null:\n70: \t\t\tshader_material.set_shader_parameter(\"uv2_scale\", standard.uv2_scale)\n71: \t\tif standard.uv2_offset != null:\n72: \t\t\tshader_material.set_shader_parameter(\"uv2_offset\", standard.uv2_offset)\n73: \telif base_material is ShaderMaterial:\n74: \t\tvar source := base_material as ShaderMaterial\n75: \t\tfor param_name in [\"albedo\", \"metallic\", \"roughness\", \"specular\", \"texture_albedo\", \"texture_metallic\", \"metallic_texture_channel\", \"texture_roughness\", \"texture_normal\", \"normal_scale\", \"uv1_scale\", \"uv1_offset\", \"uv2_scale\", \"uv2_offset\"]:\n76: \t\t\tvar value: Variant = source.get_shader_parameter(param_name)\n77: \t\t\tif value != null:\n78: \t\t\t\tshader_material.set_shader_parameter(param_name, value)\n79: \t\tif source.shader != null and source.shader == shader_material.shader:\n80: \t\t\tvar fov: Variant = source.get_shader_parameter(\"viewmodel_fov\")\n81: \t\t\tif fov != null:\n82: \t\t\t\tshader_material.set_shader_parameter(\"viewmodel_fov\", fov)\n\n(End of file - total 82 lines)\n</content>","metadata":{"preview":"extends Node3D\n\n@onready var view_model_container: Node3D = $ViewModel\n\nfunc _ready() -> void:\n\tapply_clip_and_fov_shader_to_view_model(view_model_container, 54.0)\n\nfunc apply_clip_and_fov_shader_to_view_model(node3d: Node3D, fov_or_negative_for_unchanged := -1.0) -> void:\n\tvar shader := load(\"res://shaders/weapon_clip_and_fov_shader.gdshader\") as Shader\n\tvar mesh_instances: Array[MeshInstance3D] = []\n\t_collect_mesh_instances(node3d, mesh_instances)\n\n\tfor mesh_instance in mesh_instances:\n\t\tvar mesh := mesh_instance.mesh\n\t\tif mesh == null:\n\t\t\tcontinue\n\n\t\tvar material_count: int = max(mesh_instance.get_surface_override_m