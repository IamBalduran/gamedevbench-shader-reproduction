 min(a, mina);\n\n\ta = texture(TEXTURE, UV + vec2(aura_width, 0.0) * ps).a;\n\tmaxa = max(a, maxa);\n\tmina = min(a, mina);\n\n\tcol.rgb *= col.a;\n\n\tCOLOR = col;\n\tCOLOR.rgb += aura_color.rgb * (maxa - mina);\n}\n---\nuid://c1ejn7kg46g2\n","metadata":{"output":"extends CharacterBody2D\n\n# Implement movement, selection highlight, and avoidance logic in this script.\n# The test expects exported speed/target settings, setter methods that toggle the\n# aura shader, and an avoid() helper that inspects the Detect Area2D.\n---\nuid://crm11wc00tqd4\n---\n[gd_scene load_steps=2 format=3]\n\n[ext_resource type=\"PackedScene\" path=\"res://scenes/player.tscn\" id=\"1_lv2sa\"]\n\n[node name=\"Main\" type=\"Node2D\"]\n\n[node name=\"UnitA\" parent=\".\" instance=ExtResource(\"1_lv2sa\")]\nposition = Vector2(180, 160)\n\n[node name=\"UnitB\" parent=\".\" instance=ExtResource(\"1_lv2sa\")]\nposition = Vector2(360, 200)\n---\n[gd_scene load_steps=2 format=3]\n\n[ext_resource type=\"Script\" path=\"res://scripts/unit.gd\" id=\"1_vv7m8\"]\n\n[node name=\"Unit\" type=\"CharacterBody2D\" groups=[\"units\"]]\nscript = ExtResource(\"1_vv7m8\")\n---\nshader_type canvas_item;\n//render_mode blend_premul_alpha;\n\nuniform float aura_width = 2.0;\nuniform vec4 aura_color : source_color;\n\nvoid fragment() {\n\tvec4 col = texture(TEXTURE, UV);\n\tvec2 ps = TEXTURE_PIXEL_SIZE;\n\tfloat a;\n\tfloat maxa = col.a;\n\tfloat mina = col.a;\n\n\ta = texture(TEXTURE, UV + vec2(0.0, -aura_width) * ps).a;\n\tmaxa = max(a, maxa);\n\tmina = min(a, mina);\n\n\ta = texture(TEXTURE, UV + vec2(0.0, aura_width) * ps).a;\n\tmaxa = max(a, maxa);\n\tmina = min(a, mina);\n\n\ta = texture(TEXTURE, UV + vec2(-aura_width, 0.0) * ps).a;\n\tmaxa = max(a, maxa);\n\tmina = min(a, mina);\n\n\ta = texture(TEXTURE, UV + vec2(aura_width, 0.0) * ps).a;\n\tmaxa = max(a, maxa);\n\tmina = min(a, mina);\n\n\tcol.rgb *= col.a;\n\n\tCOLOR = col;\n\tCOLOR.rgb += aura_color.rgb * (maxa - mina);\n}\n---\nuid://c1ejn7kg46g2\n","e