i) -> bool:\n-\treturn (c.x >= 14 and c.x <= 15 and c.y >= 1 and c.y <= 6\n-\t\tor c.x == 13 and c.y >= 4 and c.y <= 6\n-\t\tor c == Vector2i(12, 6)\n-\t\tor c.x >= 16 and c.x <= 19 and c.y <= 3)\n-\n-func _initialize() -> void:\n-\tcall_deferred(\"verify\")\n-\n-func verify() -> void:\n-\tdebug_collisions_hint = true\n-\troot.size = Vector2i(1440, 720)\n-\tvar tileset = load(\"res://assets/tile_set.tres\") as TileSet\n-\tassert(tileset != null)\n-\tassert(tileset.get_physics_layer_collision_layer(0) == 2)\n-\tvar atlas = tileset.get_source(0) as TileSetAtlasSource\n-\tassert(atlas.get_tiles_count() == 180)\n-\tvar layer = TileMapLayer.new()\n-\tlayer.tile_set = tileset\n-\tlayer.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST\n-\tlayer.position = Vector2(8, 36)\n-\tlayer.scale = Vector2(2, 2)\n-\tlayer.collision_visibility_mode = TileMapLayer.DEBUG_VISIBILITY_MODE_FORCE_SHOW\n-\troot.add_child(layer)\n-\tvar added = 0\n-\tvar solids = 0\n-\tfor i in atlas.get_tiles_count():\n-\t\tvar c = atlas.get_tile_id(i)\n-\t\tvar data = atlas.get_tile_data(c, 0)\n-\t\tvar solid = original_solid(c) or new_solid(c)\n-\t\tassert(data.get_collision_polygons_count(0) == int(solid), \"Wrong collision count: %s\" % c)\n-\t\tif solid:\n-\t\t\tassert(data.get_collision_polygon_points(0, 0) == box, \"Wrong box: %s\" % c)\n-\t\t\tsolids += 1\n-\t\tif new_solid(c):\n-\t\t\tadded += 1\n-\t\tlayer.set_cell(c * 2, 0, c)\n-\t\tvar label = Label.new()\n-\t\tlabel.text = \"%d,%d\" % [c.x, c.y]\n-\t\tlabel.position = Vector2(c * 72) + Vector2(8, 74)\n-\t\tlabel.add_theme_font_size_override(\"font_size\", 14)\n-\t\troot.add_child(label)\n-\tassert(added == 32)\n-\tassert(solids == 86)\n-\tvar heading = Label.new()\n-\theading.text = \"Collision preview: 86 full-tile boxes (32 added); 94 tiles without collision\"\n-\theading.position = Vector2(8, 4)\n-\troot.add_child(heading)\n-\tlayer.update_internals()\n-\tawait physics_frame\n-\tawait physics_frame\n-\tvar space = layer.get_world_2d().direc