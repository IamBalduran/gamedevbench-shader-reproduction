(H):\n    for x in range(W):\n        i = y*W+x\n        if visited[i] or not yellow(px[x,y]):\n            continue\n        # flood\n        q = deque([(x,y)]); visited[i]=1\n        minx=maxx=x; miny=maxy=y; n=0\n        while q:\n            cx,cy = q.popleft(); n+=1\n            if cx<minx:minx=cx\n            if cx>maxx:maxx=cx\n            if cy<miny:miny=cy\n            if cy>maxy:maxy=cy\n            for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):\n                nx,ny=cx+dx,cy+dy\n                if 0<=nx<W and 0<=ny<H:\n                    j=ny*W+nx\n                    if not visited[j] and yellow(px[nx,ny]):\n                        visited[j]=1; q.append((nx,ny))\n        if n>30:\n            comps.append((n,minx,miny,maxx,maxy))\ncomps.sort(reverse=True)\nprint(\"num comps>30:\", len(comps))\nfor c in comps[:40]:\n    n,minx,miny,maxx,maxy = c\n    print(n, \"bbox native\", minx//4, miny//4, maxx//4, maxy//4, \"w,h\", (maxx-minx)//4, (maxy-miny)//4)\nEOF","time":{"start":1790457656635,"end":1790457657773}},"metadata":{"openai":{"itemId":"fc_bash_9_355f4c35"}},"id":"prt_0df97b535001nBPvK1P6Zw8U1g","sessionID":"ses_f206ac9d4ffeAjQt04ebupVgDg","messageID":"msg_0df97768f0015jurp4HuXDKG5B"}}
