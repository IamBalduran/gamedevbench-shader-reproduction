ePath":"workspace/verify_camera_shake.gd","type":"delete","patch":"Index: /workspace/verify_camera_shake.gd\n===================================================================\n--- /workspace/verify_camera_shake.gd\n+++ /workspace/verify_camera_shake.gd\n@@ -1,58 +0,0 @@\n-extends SceneTree\n-\n-func _initialize():\n-\t_run.call_deferred()\n-\n-func _capture(path: String):\n-\tawait RenderingServer.frame_post_draw\n-\troot.get_texture().get_image().save_png(path)\n-\n-func _settle(camera):\n-\tfor frame in range(90):\n-\t\tawait physics_frame\n-\tassert(absf(camera.displacement) < 0.001, \"Spring must return to center\")\n-\tassert(absf(camera.velocity) < 0.001, \"Spring velocity must decay\")\n-\tassert(is_equal_approx(camera.position.y, 200.0), \"Shake must stay horizontal\")\n-\n-func _run():\n-\tvar game = load(\"res://scenes/main.tscn\").instantiate()\n-\troot.add_child(game)\n-\tcurrent_scene = game\n-\tvar camera = game.get_node(\"Camera2D\")\n-\tvar ball = game.get_node(\"Ball\")\n-\tball.set_process(false)\n-\tawait process_frame\n-\tcamera.force_update_scroll()\n-\tassert(camera.get_screen_center_position().is_equal_approx(Vector2(320, 200)))\n-\tawait _capture(\"res://camera_rest.png\")\n-\n-\tball.position = Vector2(-1, 100)\n-\tgame.get_node(\"LeftWall\").rightPointUp.emit()\n-\tassert(game.right_points == 1)\n-\tassert(ball.position == Vector2(320, 200))\n-\tassert(ball.direction.x > 0)\n-\tassert(camera.displacement == -20.0)\n-\tawait physics_frame\n-\tawait _capture(\"res://camera_right_score.png\")\n-\tassert(camera.get_screen_center_position().x < 320)\n-\tawait _settle(camera)\n-\n-\tball.position = Vector2(641, 100)\n-\tgame.get_node(\"RightWall\").leftPointUp.emit()\n-\tassert(game.left_points == 1)\n-\tassert(ball.position == Vector2(320, 200))\n-\tassert(ball.direction.x < 0)\n-\tassert(camera.displacement == 20.0)\n-\tawait physics_frame\n-\tawait _capture(\"res://camera_left_score.png\")\n-\tassert(camera.get_screen_center_position().x > 320)\n-\tawait _settle(camera)\n-\tawait _capture(\"res://camera_settled.png\")\n-\n-\tgame.left_points = game.MAX_POINTS - 1\n-\tgame.get_node(\"RightWall\").leftPointUp.emit()\n-\tassert(game.left_points == 0 and game.right_points == 0)\n-\tassert(ball.position == Vector2(320, 200))\n-\tassert(camera.displacement == 20.0)\n-\tprint(\"PASS: centered camera, both scoring signals, ball respawns, opposite shakes, spring decay, and match reset\")\n-\tquit()\n","additions":0,"deletions":59},{"filePath":"/workspace/camera_rest.png","relativePath":"workspace/camera_rest.png","type":"delete","patch":"Index: /workspace/camera_rest.png\n===================================================================\n--- /workspace/camera_rest.png\n+++ /workspace/camera_rest.png\n@@ -1,3 +0,0 @@\n-�PNG\r\n-\u001a\n-\u0000\u0000\u0000\rIHDR\u0000\u0000\u0002�\u0000\u0000\u0001�\b\u0006\u0000\u0000\u0000>��%\u0000\u0000\u0000\u0001sRGB\u0000��\u001c�\u0000\u0000\u000e*IDATx���]l�u\u001d\u0006�o�9�n\u001d¶�H�7'�B\u0018�\u0018e�\u0002c�\u0010\u0018^�h\u0002�\u000bcЄ�D1J\u0004\u0012H4Q\u0014A!�&��@�\u0013y�\u0018�#!�0�\u0002\u00126]��֍m�u�\u0001�7\u000e=;�ڞ�mv�����s���b���ӧg\u001d�\u0016�1T\u0000\u0000���\u0007\u0000\u0000`b\t�@�͛^�͛^���\u0000�\u0014\u0002 \u0000@�\u000e\u001b@\u0000�,\u001a@\u0000�0\u0002 \u0010�\u0006\u0010H&\u0000\u0002\u0000��\u0001\u0004\u0000\b�\u0001\u0004\u0000\b#\u0000\u0002�l\u0000�d\u0002 \u0000@\u0018\u001b@\u0000�0\u001a@\u0000�0\u0002 \u0010�\u0006\u0010H&\u0000\u0002\u0000��\u0001\u0004\u0000\b�\u0001\u0004\u0000\b#\u0000\u0002�l\u0000�d\u0002 \u0000@\u0018\u001b@\u0000�0\u001a@\u0000�0\u0002 \u0010�\u0006\u0010H&\u0000\u0002\u0000��\u0001\u0004\u0000\b�\u0001\u0004\u0000\b#\u0000\u0002�l\u0000�d\u0002 \u0000@\u0018\u001b@\u0000�0\u001a@\u0000�0\u0002 \u0010�\u0006\u0010H&\u0000\u0002\u0000��\u0001\u0004\u0000\b�\u0001\u0004\u0000\b#\u0000\u0002�l\u0000�d\u0002 \u0000@\u0018\u001b@\u0000�0\u001a@\u0000�0\u0002 \u0010�\u0006\u0010H&\u0000\u0002\u0000��\u0001\u000