"truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/scripts/tank.gd","text":"extends CharacterBody2D\nclass_name Tank\n\nconst SPEED = 64.0\nconst TURN_SPEED = 2.0\n\nvar direction := Vector2.RIGHT\n\nfunc _physics_process(delta):\n\tvar drive_input := 0.0\n\tvar turn_input := 0.0\n\tif InputMap.has_action(\"move_backward\") and InputMap.has_action(\"move_forward\"):\n\t\tdrive_input = Input.get_axis(\"move_backward\", \"move_forward\")\n\tif InputMap.has_action(\"turn_left\") and InputMap.has_action(\"turn_right\"):\n\t\tturn_input = Input.get_axis(\"turn_left\", \"turn_right\")\n\tif turn_input != 0.0:\n\t\tdirection = direction.rotated(turn_input * (PI / 2.0) * TURN_SPEED * delta)\n\t\trotation = direction.angle()\n\tif drive_input != 0.0:\n\t\tvelocity = direction.normalized() * drive_input * SPEED\n\telse:\n\t\tvelocity = Vector2.ZERO\n\tmove_and_slide()","lineStart":1,"lineEnd":23,"totalLines":23,"truncated":false}},"title":"workspace/scripts/tank.gd","time":{"start":1790451199230,"end":1790451199254}},"metadata":{"openai":{"itemId":"fc_read_4_0238467f"}},"id":"prt_0df352cfa00143yT1Z0LgbQhXP","sessionID":"ses_f20cb0830ffetdMOmwjc45P2MA","messageID":"msg_0df350e43001XbPSuBvBNksw9q"}}
