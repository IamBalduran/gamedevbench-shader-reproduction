\n func _on_mouse_exited() -> void:\n-\tpass\n+\tcard_state_machine.on_mouse_exited()\n@@\n-func _on_drop_point_detector_area_entered(_area: Area2D) -> void:\n-\tpass\n+func _on_drop_point_detector_area_entered(area: Area2D) -> void:\n+\tif not targets.has(area):\n+\t\ttargets.append(area)\n \n \n-func _on_drop_point_detector_area_exited(_area: Area2D) -> void:\n-\tpass\n+func _on_drop_point_detector_area_exited(area: Area2D) -> void:\n+\ttargets.erase(area)\n*** Update File: /workspace/scenes/card_ui/card_states/card_base_state.gd\n@@\n extends \"res://scenes/card_ui/card_states/card_state.gd\"\n+\n+\n+func enter() -> void:\n+\tcard_ui.drop_point_detector.monitoring = false\n+\tcard_ui.targets.clear()\n+\tcard_ui.reparent_requested.emit(card_ui)\n+\n+\n+func on_gui_input(event: InputEvent) -> void:\n+\tif event.is_action_pressed(\"left_mouse\"):\n+\t\ttransition_requested.emit(self, State.CLICKED)\n*** Update File: /workspace/scenes/card_ui/card_states/card_clicked_state.gd\n@@\n extends \"res://scenes/card_ui/card_states/card_state.gd\"\n+\n+\n+func enter() -> void:\n+\tcard_ui.original_index = card_ui.get_index()\n+\tcard_ui.drop_point_detector.monitoring = true\n+\n+\n+func on_input(event: InputEvent) -> void:\n+\tif event is InputEventMouseMotion:\n+\t\ttransition_requested.emit(self, State.DRAGGING)\n*** Update File: /workspace/scenes/card_ui/card_states/card_dragging_state.gd\n@@\n const DRAG_MINIMUM_THRESHOLD := 0.04\n+\n+var drag_started_at := 0\n+\n+\n+func enter() -> void:\n+\tdrag_started_at = Time.get_ticks_msec()\n+\tvar overlay_layer := card_ui.get_tree().get_first_node_in_group(\"overlay_layer\")\n+\tif overlay_layer:\n+\t\tcard_ui.reparent(overlay_layer)\n+\t_follow_mouse()\n+\n+\n+func exit() -> void:\n+\tdrag_started_at = 0\n+\n+\n+func on_input(event: InputEvent) -> void:\n+\tif event.is_action_pressed(\"right_mouse\"):\n+\t\ttransition_requested.emit(self, State.BASE)\n+\t\treturn\n+\n+\tif event is InputEventMouseMotion:\n+\t\t_follow_mouse()\n