{"type":"tool_use","timestamp":1790444901739,"sessionID":"ses_f212d3ba9ffeyO8eKKCixip51E","part":{"type":"tool","tool":"write","callID":"write_17_341bbf72","state":{"status":"completed","input":{"content":"extends SceneTree\n\nvar frames := 0\nvar main: Node\n\nfunc _initialize() -> void:\n\tmain = load(\"res://scenes/main.tscn\").instantiate()\n\troot.add_child(main)\n\nfunc _process(_delta: float) -> bool:\n\tframes += 1\n\tvar weapon: Node = main.get_node(\"WeaponEffects\")\n\tvar player: Node = main.get_node(\"PlayerBody\")\n\tvar cam_actual: Node3D = player.get_node(\"CameraNode/CameraActual\")\n\n\tif frames == 2:\n\t\t# Check camera_shake_power export\n\t\tvar power: float = weapon.get(\"camera_shake_power\")\n\t\tprint(\"camera_shake_power = \", power)\n\t\tif abs(power - 0.3) > 0.0001:\n\t\t\tprint(\"FAIL: camera_shake_power != 0.3\")\n\t\t\tquit(1)\n\t\t\treturn true\n\n\t\t# Check signal connection exists\n\t\tvar conns: Array = weapon.get_signal_connection_list(\"on_shot_camera_impulse\")\n\t\tvar ok := false\n\t\tfor c in conns:\n\t\t\tif c[\"callable\"].get_object() == player and c[\"callable\"].get_method() == \"apply_weapon_impulse\":\n\t\t\t\tok = true\n\t\tprint(\"signal connected to apply_weapon_impulse: \", ok)\n\t\tif not ok:\n\t\t\tprint(\"FAIL: no connection\")\n\t\t\tquit(1)\n\t\t\treturn true\n\n\t\t# Fire the weapon and check camera_shake_position response\n\t\tweapon.fire_weapon()\n\t\tvar shake: Vector3 = player.get(\"camera_shake_position\")\n\t\tprint(\"after fire camera_shake_position = \", shake, \" len=\", shake.length())\n\t\tif shake.length() <= 0.2:\n\t\t\tprint(\"FAIL: no recoil impulse applied\")\n\t\t\tquit(1)\n\t\t\treturn true\n\t\t# -forward of raycast: WeaponEffects has identity rotation, so -(-z) = +z\n\t\tif shake.z <= 0.0:\n\t\t\tprint(\"FAIL: impulse should push camera backward (+z local)\")\n\t\t\tquit(1)\n\t\t\treturn true\n\t\tprint(\"recoil z (backward) = \", shake.z)\n\t\tprint(\"up recoil y = \", shake.y)\n\n\tif frames == 10:\n\t\t# camera_actual should have moved from ZERO toward the shake position\n\t\tprint(\"camera_actual.position = \", cam_actual.position)\n\t\tif cam_actual.position.length() < 0.001:\n\t\t\tprint(\"FAIL: camera did not move\")\n\t\t\tquit(1)\n\t\t\treturn true\n\t\tprint(\"PASS: everything works\")\n\t\treturn true  # quit with 0\n\n\treturn false\n","filePath":"/tmp/opencode/test_fire.gd"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/tmp/opencode/test_fire.gd","exists":true,"truncated":false},"title":"tmp/opencode/test_fire.gd","time":{"start":1790444901717,"end":1790444901724}},"metadata":{"openai":{"itemId":"fc_write_17_341bbf72"}},"id":"prt_0ded5154e001C9m8nsaZ47RZUY","sessionID":"ses_f212d3ba9ffeyO8eKKCixip51E","messageID":"msg_0ded4b6910019OxU9Oa6ZuR3hI"}}
