()\n\tnew_card_ui.home_parent = self\n\tnew_card_ui.reparent_requested.connect(_on_card_ui_reparent_requested)\n\tadd_child(new_card_ui)\n\tnew_card_ui.card_title = card_title\n\n\nfunc _on_card_ui_reparent_requested(which_card_ui: Control) -> void:\n\tif which_card_ui.get_parent() == self:\n\t\treturn\n\n\twhich_card_ui.reparent(self)\n\tmove_child(which_card_ui, clampi(which_card_ui.original_index, 0, get_child_count() - 1))","lineStart":1,"lineEnd":19,"totalLines":19,"truncated":false}},"title":"workspace/scenes/ui/hand.gd","time":{"start":1790379970291,"end":1790379970299}},"metadata":{"openai":{"itemId":"fc_0a3f128532fd4686016ab707c1cd2c8196b5ac03376f90cd52"}},"id":"prt_0daf64ef1001GGC0NxfiruR0ZL","sessionID":"ses_f250d30c2ffevWu073yvu40SAQ","messageID":"msg_0daf62977001R7GHUNtwm9og2n"}}
