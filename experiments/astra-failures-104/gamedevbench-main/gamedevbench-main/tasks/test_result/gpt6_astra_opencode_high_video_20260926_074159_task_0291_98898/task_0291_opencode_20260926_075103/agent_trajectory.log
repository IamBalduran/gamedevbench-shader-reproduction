_exited() -> void:\n-\tpass\n+\tcard_state_machine.on_mouse_exited()\n@@\n-func _on_drop_point_detector_area_entered(_area: Area2D) -> void:\n-\tpass\n+func _on_drop_point_detector_area_entered(area: Area2D) -> void:\n+\tif not targets.has(area):\n+\t\ttargets.append(area)\n@@\n-func _on_drop_point_detector_area_exited(_area: Area2D) -> void:\n-\tpass\n+func _on_drop_point_detector_area_exited(area: Area2D) -> void:\n+\ttargets.erase(area)\n*** Update File: /workspace/scenes/card_ui/card_states/card_base_state.gd\n@@\n extends \"res://scenes/card_ui/card_states/card_state.gd\"\n+\n+\n+func enter() -> void:\n+\tcard_ui.reparent_requested.emit(card_ui)\n+\tcard_ui.pivot_offset = Vector2.ZERO\n+\tcard_ui.drop_point_detector.monitoring = false\n+\tcard_ui.targets.clear()\n+\tcard_ui.state_label.text = \"Base\"\n+\n+\n+func on_gui_input(event: InputEvent) -> void:\n+\tif event.is_action_pressed(\"left_mouse\"):\n+\t\tcard_ui.pivot_offset = card_ui.get_global_mouse_position() - card_ui.global_position\n+\t\ttransition_requested.emit(self, State.CLICKED)\n*** Update File: /workspace/scenes/card_ui/card_states/card_clicked_state.gd\n@@\n extends \"res://scenes/card_ui/card_states/card_state.gd\"\n+\n+\n+func enter() -> void:\n+\tcard_ui.original_index = card_ui.get_index()\n+\tcard_ui.drop_point_detector.monitoring = true\n+\tcard_ui.state_label.text = \"Clicked\"\n+\n+\n+func on_input(event: InputEvent) -> void:\n+\tif event is InputEventMouseMotion:\n+\t\ttransition_requested.emit(self, State.DRAGGING)\n*** Update File: /workspace/scenes/card_ui/card_states/card_dragging_state.gd\n@@\n const DRAG_MINIMUM_THRESHOLD := 0.055\n+\n+var drag_started_at: int\n+\n+\n+func enter() -> void:\n+\tdrag_started_at = Time.get_ticks_usec()\n+\tvar drag_overlay := get_tree().get_first_node_in_group(\"drag_overlay\")\n+\tif drag_overlay:\n+\t\tcard_ui.reparent(drag_overlay)\n+\tcard_ui.global_position = card_ui.get_global_mouse_position() - card_ui.pivot_offset\n+\tcard_ui.state_label.tex