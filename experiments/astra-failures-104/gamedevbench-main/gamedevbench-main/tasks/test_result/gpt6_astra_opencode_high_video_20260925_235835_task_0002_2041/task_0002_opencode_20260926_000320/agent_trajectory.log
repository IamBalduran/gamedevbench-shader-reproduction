{"type":"tool_use","timestamp":1790351962139,"sessionID":"ses_f26b565efffeD4GhTU1poM6EJn","part":{"type":"tool","tool":"read","callID":"call_84fJPHcxf2X1M9h6dCJuKVrq","state":{"status":"completed","input":{"filePath":"/workspace/addons/quest_manager/QuestManager.gd"},"output":"<path>/workspace/addons/quest_manager/QuestManager.gd</path>\n<type>file</type>\n<content>\n1: @tool\n2: extends Node\n3: #Adds each quest as children to be updated\n4: #Each Quest adds its current step add its child\n5: \n6: signal quest_completed(quest:Dictionary)\n7: signal quest_failed(quest:Dictionary)\n8: signal step_complete(step:Dictionary)\n9: signal next_step(step:Dictionary)\n10: signal step_updated(step:Dictionary)\n11: signal new_quest_added(quest_name:String)\n12: signal quest_reset(quest_name:String)\n13: \n14: const ACTION_STEP = \"action_step\"\n15: const INCREMENTAL_STEP = \"incremental_step\"\n16: const ITEMS_STEP = \"items_step\"\n17: const TIMER_STEP = \"timer_step\"\n18: const BRANCH_STEP = \"branch_step\"\n19: const CALLABLE_STEP = \"callable_step\"\n20: const END = \"end\"\n21: \n22: #Helper variable for searching for quest\n23: var active_quest = \"\"\n24: var current_resource\n25: var player_quests = {}\n26: #For timer step\n27: var counter = 0.0\n28: #get quest to view data\n29: func get_quest_from_resource(quest_name:String,resource=current_resource):\n30: \treturn resource.get_quest_by_name(quest_name)\n31: #creates all instanced of uncompleted player quests\n32: #loads and add a quest and quest instance to player quests from quest_resource\n33: func add_quest(quest_name:String,resource=current_resource) -> void:\n34: \tvar node_data = resource.get_quest_by_name(quest_name)\n35: \tplayer_quests[node_data.quest_id] = node_data.duplicate(true)\n36: \tnew_quest_added.emit(quest_name)\n37: \tactive_quest = quest_name\n38: \tvar quest_id = get_quest_id(quest_name)\n39: \tvar step = get_current_step(quest_id,true)\n40: \tstep_updated.emit(step)\n41: \n42: func load_quest_resource(quest_res) -> void:\n43: \tcurrent_resource = quest_res\n44: \n45: #Get a quest that the player has accepted\n46: func get_player_quest(quest_name:String,is_id:bool=false) -> Dictionary:\n47: \tif is_id:\n48: \t\treturn player_quests[quest_name]\n49: \tvar quest = {}\n50: \tfor quest_id in player_quests:\n51: \t\tif player_quests[quest_id].quest_name == quest_name:\n52: \t\t\tquest = player_quests[quest_id]\n53: \t\t\tbreak\n54: \treturn quest\n55: \n56: \n57: #all the current quests the player has\n58: func get_all_player_quests() -> Dictionary:\n59: \treturn player_quests\n60: \t\n61: func progress_quest_by_name(quest_name,item_name:String=\"\",quantity:int=1,collected:bool=true)->void:\n62: \tvar quest_id = get_quest_id(quest_name)\n63: \tvar current_step = get_current_step(quest_id,true)\n64: \tprogress_quest(quest_id,current_step.id,item_name,quantity,collected)\n65: \n66: func progress_quest(quest_id:String,step_id:String, item_name:String=\"\",quantity:int=1,collected:bool=true):\n67: \tif has_quest(quest_id,true) == false:\n68: \t\treturn\n69: \tif player_quests[quest_id].completed == true:\n70: \t\treturn\n71: \tif player_quests[quest_id].quest_steps.has(step_id) != true:\n72: \t\treturn\n73: \tvar step = player_quests[quest_id].quest_steps[step_id]\n74: \tmatch step.step_type:\n75: \t\tACTION_STEP:\n76: \t\t\tcomplete_step(quest_id,step)\n77: \t\tINCREMENTAL_STEP:\n78: \t\t\tstep.collected += quantity\n79: \t\t\tstep_updated.emit(step)\n80: \t\t\tif step.collected >= step.required:\n81: \t\t\t\tcomplete_step(quest_id,step)\n82: \t\tITEMS_STEP:\n83: \t\t\tvar all_item_collected = true\n84: \t\t\tfor item in step.item_list:\n85: \t\t\t\tif item.name == item_name:\n86: \t\t\t\t\titem.complete = true\n87: \t\t\t\t\tbreak\n88: \t\t\tfor item in step.item_list:\n89: \t\t\t\tif item.complete == false:\n90: \t\t\t\t\tall_item_collected = false\n91: \t\t\t\t\tbreak\n92: \t\t\tstep_updated.emit(step)\n93: \t\t\tif all_item_collected:\n94: \t\t\t\tcomplete_step(quest_id,step)\n95: \t\t\t\t\n96: \t\tTIMER_STEP:\n97: \t\t\tstep.completed = true\n98: \t\t\tcomplete_step(quest_id,step)\n99: \t\t\t\n100: \t\tCALLABLE_STEP:\n101: \t\t\t#call function\n102: \t\t\tcall_function(step.detail,step.params)\n103: \t\t\tcomplete_step(quest_id,step)\n104: \t\tBRANCH_STEP:\n105: \t\t\tstep.completed = true\n106: \t\t\tcomplete_step(quest_id,step)\n107: \t\tEND:\n108: \t\t\tstep_complete.emit(step)\n109: \tvar next_step = player_quests[quest_id].quest_steps[step.next_id]\n110: \tif next_step.step_type == CALLABLE_STEP and step.completed:\n111: \t\tcall_function(next_step.details,next_step.params.funcparams)\n112: \t\tcomplete_step(quest_id,next_step)\n113: \tif next_step.step_type == END and step.completed:\n114: \t\tcomplete_quest(quest_id,true)\n115: #Updates Timer_Steps\n116: func _process(delta):\n117: \tif Engine.is_editor_hint():\n118: \t\treturn\n119: \tcounter += delta\n120: \tif counter >= 1.0:\n121: \t\tcounter = 0.0\n122: \t\tfor quest_id in player_quests:\n123: \t\t\tif player_quests[quest_id].failed or player_quests[quest_id].completed:\n124: \t\t\t\tcontinue\n125: \t\t\tvar current_step = player_quests[quest_id].next_id\n126: \t\t\t\n127: \t\t\tvar step = player_quests[quest_id].quest_steps[current_step]\n128: \t\t\t\n129: \t\t\tif step.is_empty():\n130: \t\t\t\treturn\n131: \t\t\tif step.step_type != TIMER_STEP:\n132: \t\t\t\treturn\n133: \t\t\tif step.is_count_down:\n134: \t\t\t\tstep.time -= 1\n135: \t\t\t\tif step.time <= 0:\n136: \t\t\t\t\tif step.fail_on_timeout:\n137: \t\t\t\t\t\tfail_quest(player_quests[quest_id].quest_name)\n138: \t\t\t\t\telse:\n139: \t\t\t\t\t\tprogress_quest(player_quests[quest_id].quest_id,step.id)\n140: \t\t\telse:\n141: \t\t\t\tstep.time += 1\n142: \t\t\t\tif step.time >= step.total_time:\n143: \t\t\t\t\tif step.fail_on_timeout:\n144: \t\t\t\t\t\tfail_quest(player_quests[quest_id].quest_name)\n145: \t\t\t\t\telse:\n146: \t\t\t\t\t\tprogress_quest(player_quests[quest_id].quest_id,step.id)\n147: \t\t\tstep_updated.emit(step)\n148: \n149: func get_quest_id(quest_name:String)->String:\n150: \tvar id = \"\"\n151: \tfor quest_id in player_quests:\n152: \t\tif player_quests[quest_id].quest_name == quest_name:\n153: \t\t\tid = quest_id\n154: \t\t\tbreak\n155: \treturn id\n156: \n157: #returns all player quests names as array\n158: func get_all_player_quests_names() -> Array:\n159: \tvar quests = []\n160: \tfor i in player_quests:\n161: \t\tquests.append(player_quests[i].quest_name)\n162: \treturn quests\n163: #set if a branch step should branch\n164: func set_branch_step(quest_id,step_id, should_branch:bool=true) -> void:\n165: \tvar step = player_quests[quest_id].quest_steps[step_id]\n166: \tif step.step_type == BRANCH_STEP:\n167: \t\tstep.branch = should_branch\n168: \n169: #Optionally get quests that were grouped by group name grouped to all by default\n170: func get_quest_list(quest_resource=current_resource, group:String=\"\") -> Dictionary:\n171: \tassert(quest_resource != null, \"Quest Resource not Loaded\")\n172: \treturn quest_resource.get_quests(group)\n173: \n174: func has_quest(quest_name:String,is_id:bool = false)->bool:\n175: \tif is_id:\n176: \t\treturn player_quests.has(quest_name)\n177: \telse:\n178: \t\tfor quest in player_quests:\n179: \t\t\tif player_quests[quest].quest_name == quest_name:\n180: \t\t\t\treturn true\n181: \t\treturn false\n182: #Add a quest that was created from script/at runtime\n183: func is_quest_complete(quest_name:String,is_id:bool=false) -> bool:\n184: \tif is_id:\n185: \t\tif player_quests.has(quest_name):\n186: \t\t\treturn player_quests[quest_name].completed\n187: \tvar quest = get_player_quest(quest_name,is_id)\n188: \treturn quest.completed\n189: #returns true if quest was failed\n190: func is_quest_failed(quest_name:String,is_id:bool=false) -> bool:\n191: \tvar quest = get_player_quest(quest_name,is_id)\n192: \tif quest.is_empty():\n193: \t\treturn false\n194: \treturn quest.failed\n195: \t\n196: #get the current step in quest\n197: func get_current_step(quest_name:String,is_id = false) -> Dictionary:\n198: \tif is_id:\n199: \t\tvar next_id = player_quests[quest_name].next_id\n200: \t\treturn player_quests[quest_name].quest_steps[next_id]\n201: \tvar quest = get_player_quest(quest_name,is_id)\n202: \treturn quest.quest_steps[quest.next_id]\n203: \n204: #Remove quest from player quests including steps/items and metadata\n205: func remove_quest(quest_name:String) -> void:\n206: \tfor i in player_quests:\n207: \t\tif player_quests[i].quest_name == quest_name:\n208: \t\t\tplayer_quests.erase(i)\n209: \t\t\t\n210: func get_quest_steps_from_resource(quest_name,quest_res=current_resource) -> Array:\n211: \treturn current_resource.get_quest_steps_sorted(quest_name)\n212: \n213: #returns a dictionary of all the rewards of a player quest\n214: func get_quest_rewards(quest_name:String,id_id:bool=false) -> Dictionary:\n215: \tvar quest_rewards ={}\n216: \tif id_id:\n217: \t\tquest_rewards = player_quests[quest_name].quest_rewards\n218: \t\treturn quest_rewards\n219: \tfor quest in player_quests:\n220: \t\tif player_quests[quest].quest_name == quest_name:\n221: \t\t\tquest_rewards = player_quests[quest].quest_rewards\n222: \t\t\tbreak\n223: \treturn quest_rewards\n224: \t\n225: func complete_step(quest_id:String,step:Dictionary):\n226: \tstep.completed = true\n227: \tstep_complete.emit(step)\n228: \tvar next_id = step.next_id\n229: \tif step.step_type == BRANCH_STEP:\n230: \t\tif step.branch:\n231: \t\t\tnext_id = step.branch_step_id\n232: \t\telse:\n233: \t\t\tnext_id = step.next_id\n234: \tplayer_quests[quest_id].next_id = next_id\n235: \tnext_step.emit(player_quests[quest_id].quest_steps[next_id])\n236: #Completes a quest if every required step was completed\n237: func complete_quest(quest_name:String,is_id:bool = false) -> void:\n238: \tif is_id:\n239: \t\tplayer_quests[quest_name].completed = true\n240: \telse:\n241: \t\tget_player_quest(quest_name).completed = true\n242: \t#emits quest dictionary\n243: \t\n244: \tquest_completed.emit(get_player_quest(quest_name,is_id))\n245: \n246: #get all the meta data stored for this quest\n247: func get_meta_data(quest_name:String) -> Dictionary:\n248: \tvar meta_data ={}\n249: \tfor quest in player_quests:\n250: \t\tif player_quests[quest].quest_name == quest_name:\n251: \t\t\tmeta_data = player_quests[quest].meta_data\n252: \t\t\tbreak\n253: \treturn meta_data\n254: \n255: #sets or create new quests meta data\n256: func set_meta_data(quest_name:String,meta_data:String, value:Variant) -> void:\n257: \tvar id = get_player_quest(quest_name).quest_id\n258: \tplayer_quests[id].metadata[meta_data] = value\n259: \n260: #Fails a quest\n261: func fail_quest(quest_name:String,is_id=false) -> void:\n262: \tvar quest = get_player_quest(quest_name,is_id)\n263: \tquest.failed = true\n264: \tquest_failed.emit(quest)\n265: \t\n266: #Reset Quest Values\n267: func reset_quest(quest_name:String) -> void:\n268: \tvar id = get_player_quest(quest_name).quest_id\n269: \tplayer_quests[id].completed = false\n270: \tplayer_quests[id].failed = false\n271: \tplayer_quests[id].next_id = player_quests[id].first_step\n272: \tfor step in player_quests[id].quest_steps:\n273: \t\tvar replace_step = player_quests[id].quest_steps[step]\n274: \t\tmatch replace_step.step_type:\n275: \t\t\tACTION_STEP:\n276: \t\t\t\treplace_step.complete = false\n277: \t\t\tINCREMENTAL_STEP:\n278: \t\t\t\treplace_step.collected = 0\n279: \t\t\tITEMS_STEP:\n280: \t\t\t\tfor i in replace_step.items_list:\n281: \t\t\t\t\treplace_step.item_list[i].complete = false\n282: \t\t\tTIMER_STEP:\n283: \t\t\t\tif replace_step.is_count_down:\n284: \t\t\t\t\treplace_step.time = replace_step.total_time\n285: \t\t\t\telse:\n286: \t\t\t\t\treplace_step.time = 0\n287: \t\t\tBRANCH_STEP:\n288: \t\t\t\treplace_step.branch = false\n289: \t\tplayer_quests[id].quest_steps[step] = replace_step\n290: \tquest_reset.emit(quest_name)\n291: \t\n292: \n293: #helper function to save player data\n294: func get_save_quest_data() -> Dictionary:\n295: \treturn player_quests\n296: #helper function to load player data\n297: func load_saved_quest_data(data:Dictionary) -> void:\n298: \tplayer_quests = data.duplicate(true)\n299: #Removes Every Quest from player \n300: #Usefull for new game files if neccessary\n301: func wipe_player_data() -> void:\n302: \tplayer_quests = {}\n303: \n304: \n305: func testfunc(v:Array=[]):\n306: \tprint(\"Hello QuestManager \"+str(v))\n307: \n308: func call_function(autoloadfunction:String,params:Array) -> void:\n309: \t#split function from autoload script name\n310: \tvar autofuncsplit = autoloadfunction.split(\".\")\n311: \tvar singleton_name = autofuncsplit[0]\n312: \tvar function = autofuncsplit[1]\n313: \t#get only function name without ()\n314: \tvar callable = function.split(\"(\")[0]\n315: \t#Autoload name needs to be the same as script or use name of Node instead.\n316: \tassert(Engine.has_singleton(singleton_name)==false, \"Singleton %s Not Loaded or invalid\" % singleton_name)\n317: \tvar auto_load = get_tree().root.get_node(singleton_name)\n318: \t#if array has values pass array otherwise call function normally\n319: \tif params.size()>0:\n320: \t\tauto_load.call(callable,params)\n321: \telse:\n322: \t\tauto_load.call(callable)\n\n(End of file - total 322 lines)\n</content>","metadata":{"preview":"@tool\nextends Node\n#Adds each quest as children to be updated\n#Each Quest adds its current step add its child\n\nsignal quest_completed(quest:Dictionary)\nsignal quest_failed(quest:Dictionary)\nsignal step_complete(step:Dictionary)\nsignal next_step(step:Dictionary)\nsignal step_updated(step:Dictionary)\nsignal new_quest_added(quest_name:String)\nsignal quest_reset(quest_name:String)\n\nconst ACTION_STEP = \"action_step\"\nconst INCREMENTAL_STEP = \"incremental_step\"\nconst ITEMS_STEP = \"items_step\"\nconst TIMER_STEP = \"timer_step\"\nconst BRANCH_STEP = \"branch_step\"\nconst CALLABLE_STEP = \"callable_step\"\nconst END = \"end\"","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/addons/quest_manager/QuestManager.gd","text":"@tool\nextends Node\n#Adds each quest as children to be updated\n#Each Quest adds its current step add its child\n\nsignal quest_completed(quest:Dictionary)\nsignal quest_failed(quest:Dictionary)\nsignal step_complete(step:Dictionary)\nsignal next_step(step:Dictionary)\nsignal step_updated(step:Dictionary)\nsignal new_quest_added(quest_name:String)\nsignal quest_reset(quest_name:String)\n\nconst ACTION_STEP = \"action_step\"\nconst INCREMENTAL_STEP = \"incremental_step\"\nconst ITEMS_STEP = \"items_step\"\nconst TIMER_STEP = \"timer_step\"\nconst BRANCH_STEP = \"branch_step\"\nconst CALLABLE_STEP = \"callable_step\"\nconst END = \"end\"\n\n#Helper variable for searching for quest\nvar active_quest = \"\"\nvar current_resource\nvar player_quests = {}\n#For timer step\nvar counter = 0.0\n#get quest to view data\nfunc get_quest_from_resource(quest_name:String,resource=current_resource):\n\treturn resource.get_quest_by_name(quest_name)\n#creates all instanced of uncompleted player quests\n#loads and add a quest and quest instance to player quests from quest_resource\nfunc add_quest(quest_name:String,resource=current_resource) -> void:\n\tvar node_data = resource.get_quest_by_name(quest_name)\n\tplayer_quests[node_data.quest_id] = node_data.duplicate(true)\n\tnew_quest_added.emit(quest_name)\n\tactive_quest = quest_name\n\tvar quest_id = get_quest_id(quest_name)\n\tvar step = get_current_step(quest_id,true)\n\tstep_updated.emit(step)\n\nfunc load_quest_resource(quest_res) -> void:\n\tcurrent_resource = quest_res\n\n#Get a quest that the player has accepted\nfunc get_player_quest(quest_name:String,is_id:bool=false) -> Dictionary:\n\tif is_id:\n\t\treturn player_quests[quest_name]\n\tvar quest = {}\n\tfor quest_id in player_quests:\n\t\tif player_quests[quest_id].quest_name == quest_name:\n\t\t\tquest = player_quests[quest_id]\n\t\t\tbreak\n\treturn quest\n\n\n#all the current quests the player has\nfunc get_all_player_quests() -> Dictionary:\n\treturn player_quests\n\t\nfunc progress_quest_by_name(quest_name,item_name:String=\"\",quantity:int=1,collected:bool=true)->void:\n\tvar quest_id = get_quest_id(quest_name)\n\tvar current_step = get_current_step(quest_id,true)\n\tprogress_quest(quest_id,current_step.id,item_name,quantity,collected)\n\nfunc progress_quest(quest_id:String,step_id:String, item_name:String=\"\",quantity:int=1,collected:bool=true):\n\tif has_quest(quest_id,true) == false:\n\t\treturn\n\tif player_quests[quest_id].completed == true:\n\t\treturn\n\tif player_quests[quest_id].quest_steps.has(step_id) != true:\n\t\treturn\n\tvar step = player_quests[quest_id].quest_steps[step_id]\n\tmatch step.step_type:\n\t\tACTION_STEP:\n\t\t\tcomplete_step(quest_id,step)\n\t\tINCREMENTAL_STEP:\n\t\t\tstep.collected += quantity\n\t\t\tstep_updated.emit(step)\n\t\t\tif step.collected >= step.required:\n\t\t\t\tcomplete_step(quest_id,step)\n\t\tITEMS_STEP:\n\t\t\tvar all_item_collected = true\n\t\t\tfor item in step.item_list:\n\t\t\t\tif item.name == item_name:\n\t\t\t\t\titem.complete = true\n\t\t\t\t\tbreak\n\t\t\tfor item in step.item_list:\n\t\t\t\tif item.complete == false:\n\t\t\t\t\tall_item_collected = false\n\t\t\t\t\tbreak\n\t\t\tstep_updated.emit(step)\n\t\t\tif all_item_collected:\n\t\t\t\tcomplete_step(quest_id,step)\n\t\t\t\t\n\t\tTIMER_STEP:\n\t\t\tstep.completed = true\n\t\t\tcomplete_step(quest_id,step)\n\t\t\t\n\t\tCALLABLE_STEP:\n\t\t\t#call function\n\t\t\tcall_function(step.detail,step.params)\n\t\t\tcomplete_step(quest_id,step)\n\t\tBRANCH_STEP:\n\t\t\tstep.completed = true\n\t\t\tcomplete_step(quest_id,step)\n\t\tEND:\n\t\t\tstep_complete.emit(step)\n\tvar next_step = player_quests[quest_id].quest_steps[step.next_id]\n\tif next_step.step_type == CALLABLE_STEP and step.completed:\n\t\tcall_function(next_step.details,next_step.params.funcparams)\n\t\tcomplete_step(quest_id,next_step)\n\tif next_step.step_type == END and step.completed:\n\t\tcomplete_quest(quest_id,true)\n#Updates Timer_Steps\nfunc _process(delta):\n\tif Engine.is_editor_hint():\n\t\treturn\n\tcounter += delta\n\tif counter >= 1.0:\n\t\tcounter = 0.0\n\t\tfor quest_id in player_quests:\n\t\t\tif player_quests[quest_id].failed or player_quests[quest_id].completed:\n\t\t\t\tcontinue\n\t\t\tvar current_step = player_quests[quest_id].next_id\n\t\t\t\n\t\t\tvar step = player_quests[quest_id].quest_steps[current_step]\n\t\t\t\n\t\t\tif step.is_empty():\n\t\t\t\treturn\n\t\t\tif step.step_type != TIMER_STEP:\n\t\t\t\treturn\n\t\t\tif step.is_count_down:\n\t\t\t\tstep.time -= 1\n\t\t\t\tif step.time <= 0:\n\t\t\t\t\tif step.fail_on_timeout:\n\t\t\t\t\t\tfail_quest(player_quests[quest_id].quest_name)\n\t\t\t\t\telse:\n\t\t\t\t\t\tprogress_quest(player_quests[quest_id].quest_id,step.id)\n\t\t\telse:\n\t\t\t\tstep.time += 1\n\t\t\t\tif step.time >= step.total_time:\n\t\t\t\t\tif step.fail_on_timeout:\n\t\t\t\t\t\tfail_quest(player_quests[quest_id].quest_name)\n\t\t\t\t\telse:\n\t\t\t\t\t\tprogress_quest(player_quests[quest_id].quest_id,step.id)\n\t\t\tstep_updated.emit(step)\n\nfunc get_quest_id(quest_name:String)->String:\n\tvar id = \"\"\n\tfor quest_id in player_quests:\n\t\tif player_quests[quest_id].quest_name == quest_name:\n\t\t\tid = quest_id\n\t\t\tbreak\n\treturn id\n\n#returns all player quests names as array\nfunc get_all_player_quests_names() -> Array:\n\tvar quests = []\n\tfor i in player_quests:\n\t\tquests.append(player_quests[i].quest_name)\n\treturn quests\n#set if a branch step should branch\nfunc set_branch_step(quest_id,step_id, should_branch:bool=true) -> void:\n\tvar step = player_quests[quest_id].quest_steps[step_id]\n\tif step.step_type == BRANCH_STEP:\n\t\tstep.branch = should_branch\n\n#Optionally get quests that were grouped by group name grouped to all by default\nfunc get_quest_list(quest_resource=current_resource, group:String=\"\") -> Dictionary:\n\tassert(quest_resource != null, \"Quest Resource not Loaded\")\n\treturn quest_resource.get_quests(group)\n\nfunc has_quest(quest_name:String,is_id:bool = false)->bool:\n\tif is_id:\n\t\treturn player_quests.has(quest_name)\n\telse:\n\t\tfor quest in player_quests:\n\t\t\tif player_quests[quest].quest_name == quest_name:\n\t\t\t\treturn true\n\t\treturn false\n#Add a quest that was created from script/at runtime\nfunc is_quest_complete(quest_name:String,is_id:bool=false) -> bool:\n\tif is_id:\n\t\tif player_quests.has(quest_name):\n\t\t\treturn player_quests[quest_name].completed\n\tvar quest = get_player_quest(quest_name,is_id)\n\treturn quest.completed\n#returns true if quest was failed\nfunc is_quest_failed(quest_name:String,is_id:bool=false) -> bool:\n\tvar quest = get_player_quest(quest_name,is_id)\n\tif quest.is_empty():\n\t\treturn false\n\treturn quest.failed\n\t\n#get the current step in quest\nfunc get_current_step(quest_name:String,is_id = false) -> Dictionary:\n\tif is_id:\n\t\tvar next_id = player_quests[quest_name].next_id\n\t\treturn player_quests[quest_name].quest_steps[next_id]\n\tvar quest = get_player_quest(quest_name,is_id)\n\treturn quest.quest_steps[quest.next_id]\n\n#Remove quest from player quests including steps/items and metadata\nfunc remove_quest(quest_name:String) -> void:\n\tfor i in player_quests:\n\t\tif player_quests[i].quest_name == quest_name:\n\t\t\tplayer_quests.erase(i)\n\t\t\t\nfunc get_quest_steps_from_resource(quest_name,quest_res=current_resource) -> Array:\n\treturn current_resource.get_quest_steps_sorted(quest_name)\n\n#returns a dictionary of all the rewards of a player quest\nfunc get_quest_rewards(quest_name:String,id_id:bool=false) -> Dictionary:\n\tvar quest_rewards ={}\n\tif id_id:\n\t\tquest_rewards = player_quests[quest_name].quest_rewards\n\t\treturn quest_rewards\n\tfor quest in player_quests:\n\t\tif player_quests[quest].quest_name == quest_name:\n\t\t\tquest_rewards = player_quests[quest].quest_rewards\n\t\t\tbreak\n\treturn quest_rewards\n\t\nfunc complete_step(quest_id:String,step:Dictionary):\n\tstep.completed = true\n\tstep_complete.emit(step)\n\tvar next_id = step.next_id\n\tif step.step_type == BRANCH_STEP:\n\t\tif step.branch:\n\t\t\tnext_id = step.branch_step_id\n\t\telse:\n\t\t\tnext_id = step.next_id\n\tplayer_quests[quest_id].next_id = next_id\n\tnext_step.emit(player_quests[quest_id].quest_steps[next_id])\n#Completes a quest if every required step was completed\nfunc complete_quest(quest_name:String,is_id:bool = false) -> void:\n\tif is_id:\n\t\tplayer_quests[quest_name].completed = true\n\telse:\n\t\tget_player_quest(quest_name).completed = true\n\t#emits quest dictionary\n\t\n\tquest_completed.emit(get_player_quest(quest_name,is_id))\n\n#get all the meta data stored for this quest\nfunc get_meta_data(quest_name:String) -> Dictionary:\n\tvar meta_data ={}\n\tfor quest in player_quests:\n\t\tif player_quests[quest].quest_name == quest_name:\n\t\t\tmeta_data = player_quests[quest].meta_data\n\t\t\tbreak\n\treturn meta_data\n\n#sets or create new quests meta data\nfunc set_meta_data(quest_name:String,meta_data:String, value:Variant) -> void:\n\tvar id = get_player_quest(quest_name).quest_id\n\tplayer_quests[id].metadata[meta_data] = value\n\n#Fails a quest\nfunc fail_quest(quest_name:String,is_id=false) -> void:\n\tvar quest = get_player_quest(quest_name,is_id)\n\tquest.failed = true\n\tquest_failed.emit(quest)\n\t\n#Reset Quest Values\nfunc reset_quest(quest_name:String) -> void:\n\tvar id = get_player_quest(quest_name).quest_id\n\tplayer_quests[id].completed = false\n\tplayer_quests[id].failed = false\n\tplayer_quests[id].next_id = player_quests[id].first_step\n\tfor step in player_quests[id].quest_steps:\n\t\tvar replace_step = player_quests[id].quest_steps[step]\n\t\tmatch replace_step.step_type:\n\t\t\tACTION_STEP:\n\t\t\t\treplace_step.complete = false\n\t\t\tINCREMENTAL_STEP:\n\t\t\t\treplace_step.collected = 0\n\t\t\tITEMS_STEP:\n\t\t\t\tfor i in replace_step.items_list:\n\t\t\t\t\treplace_step.item_list[i].complete = false\n\t\t\tTIMER_STEP:\n\t\t\t\tif replace_step.is_count_down:\n\t\t\t\t\treplace_step.time = replace_step.total_time\n\t\t\t\telse:\n\t\t\t\t\treplace_step.time = 0\n\t\t\tBRANCH_STEP:\n\t\t\t\treplace_step.branch = false\n\t\tplayer_quests[id].quest_steps[step] = replace_step\n\tquest_reset.emit(quest_name)\n\t\n\n#helper function to save player data\nfunc get_save_quest_data() -> Dictionary:\n\treturn player_quests\n#helper function to load player data\nfunc load_saved_quest_data(data:Dictionary) -> void:\n\tplayer_quests = data.duplicate(true)\n#Removes Every Quest from player \n#Usefull for new game files if neccessary\nfunc wipe_player_data() -> void:\n\tplayer_quests = {}\n\n\nfunc testfunc(v:Array=[]):\n\tprint(\"Hello QuestManager \"+str(v))\n\nfunc call_function(autoloadfunction:String,params:Array) -> void:\n\t#split function from autoload script name\n\tvar autofuncsplit = autoloadfunction.split(\".\")\n\tvar singleton_name = autofuncsplit[0]\n\tvar function = autofuncsplit[1]\n\t#get only function name without ()\n\tvar callable = function.split(\"(\")[0]\n\t#Autoload name needs to be the same as script or use name of Node instead.\n\tassert(Engine.has_singleton(singleton_name)==false, \"Singleton %s Not Loaded or invalid\" % singleton_name)\n\tvar auto_load = get_tree().root.get_node(singleton_name)\n\t#if array has values pass array otherwise call function normally\n\tif params.size()>0:\n\t\tauto_load.call(callable,params)\n\telse:\n\t\tauto_load.call(callable)","lineStart":1,"lineEnd":322,"totalLines":322,"truncated":false}},"title":"workspace/addons/quest_manager/QuestManager.gd","time":{"start":1790351962073,"end":1790351962125}},"metadata":{"openai":{"itemId":"fc_039d8066661ce1e5016ab69a59503481969f49a295126ff63a"}},"id":"prt_0d94aefd4001po7IydztFBPN7l","sessionID":"ses_f26b565efffeD4GhTU1poM6EJn","messageID":"msg_0d94ad8fd0011ofyfKqVrhoDQO"}}
