e recorded\")\n\tcheck(draggable.initial_scale == Vector2.ONE, \"Initial scale should be recorded\")\n\tcheck(draggable.scale.is_zero_approx(), \"Spawn should start at zero scale\")\n\tawait create_timer(0.4).timeout\n\tcheck(draggable.scale.is_equal_approx(draggable.initial_scale), \"Spawn should restore initial scale\")\n\tvar sprite: Sprite2D = draggable.get_node(\"Sprite\")\n\tvar collider: CollisionShape2D = draggable.get_node(\"CollisionShape\")\n\tcheck(collider.shape.size == Vector2(72, 72), \"Collision shape should remain 72x72\")\n\tvar collider_bounds := Rect2(-collider.shape.size * collider.scale / 2, collider.shape.size * collider.scale)\n\tvar sprite_bounds := Rect2(sprite.get_rect().position * sprite.scale, sprite.get_rect().size * sprite.scale)\n\tcheck(collider_bounds.encloses(sprite_bounds), \"Collision bounds should cover the scaled sprite\")\n\n\t# Press near an outer star point to verify the full sprite is pickable.\n\tmove_mouse(draggable.global_position + Vector2(0, -75))\n\tawait wait_for_physics()\n\tclick(draggable.global_position + Vector2(0, -75), true)\n\tawait wait_for_physics()\n\tcheck(draggable.dragging, \"Mouse press on the outer star should begin dragging\")\n\tmove_mouse(target.global_position)\n\tvar distance_before: float = draggable.global_position.distance_to(target.global_position)\n\tawait wait_for_physics()\n\tcheck(draggable.global_position.distance_to(target.global_position) < distance_before, \"Dragging should move toward the mouse\")\n\tawait create_timer(0.5).timeout\n\tcheck(draggable.global_position.distance_to(target.global_position) < 1.0, \"Dragging should converge on the mouse\")\n\tclick(target.global_position, false)\n\tawait wait_for_physics()\n\tcheck(not draggable.dragging, \"Release should stop dragging\")\n\tcheck(reports.size() == 1, \"Valid drop should emit exactly one report\")\n\tif reports.size() == 1:\n\t\tcheck(reports[0].item == draggable, \"Drop report should contain the draggable\")\n\t\tcheck(reports[0].areas.has(target), \"Drop report should contain the overlapping target\")\n\tawait create_timer(0.4).timeout\n\tcheck(is_instance_valid(draggable), \"Valid drop should keep the decoration alive\")\n\tif not is_instance_valid(draggable):\n\t\tquit(1)\n\t\treturn\n\n\t# An unrelated layer-2 area must not be accepted as a DropTarget.\n\tvar unrelated := Area2D.new()\n\tunrelated.name = \"OtherArea\"\n\tunrelated.collision_layer = 2\n\tunrelated.position = Vector2(850, 450)\n\tvar unrelated_shape := CollisionShape2D.new()\n\tvar rectangle := RectangleShape2D.new()\n\trectangle.size = Vector2(140, 140)\n\tunrelated_shape.shape = rectangle\n\tunrelated.add_child(unrelated_shape)\n\tmain.add_child(unrelated)\n\tmove_mouse(draggable.global_position)\n\tawait wait_for_physics()\n\tclick(draggable.global_position, true)\n\tawait wait_for_physics()\n\tcheck(draggable.dragging, \"A validly dropped decoration should be draggable again\")\n\tmove_mouse(unrelated.global_position)\n\tawait create_timer(0.6).timeout\n\t# Release far from the sprite to check the global _input handler.\n\tmove_mouse(Vector2(1100, 600))\n\tclick(Vector2(1100, 600), false)\n\tawait wait_for_physics()\n\tcheck(reports.size() == 2, \"Invalid drop should emit exactly one additional report\")\n\tif reports.size() == 2:\n\t\tcheck(reports[1].areas.has(unrelated), \"Invalid drop should report other overlapping areas\")\n\t\tcheck(not reports[1].areas.has(target), \"Invalid drop should not report the distant target\")\n\tcheck(not draggable.dragging, \"Release away from the sprite should stop dragging\")\n\tcheck(not draggable.input_pickable, \"Destructing decoration should stop accepting clicks\")\n\tawait create_timer(0.3).timeout\n\tcheck(not is_instance_valid(draggable), \"Invalid drop should shrink and free the decoration\")\n\tif failures.is_empty():\n\t\tprint(\"PASS: spawn, collision coverage, mouse picking, smooth dragging, drop reports, valid retention, invalid destruction\")\n\tquit(0 if fa