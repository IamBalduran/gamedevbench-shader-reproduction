n\": 1.0, \"texture\": SubResource(\"{f}\")}}' for f in walk_frames[d])\n    entries.append(f'\"frames\": [{fb}],\\n\"loop\": true,\\n\"name\": &\"run{d}\",\\n\"speed\": 5.0')\nlines.append(',\\n'.join(entries))\nlines.append('}]')\nlines.append('')\n\nr = math.sqrt(33*33+12*12)\nlines.append('[sub_resource type=\"RectangleShape2D\" id=\"RectangleShape2D_1\"]')\nlines.append('size = Vector2(%s, 24)' % ('%.3f' % r).rstrip('0').rstrip('.'))\nlines.append('')\n\nlines.append('[node name=\"Player\" type=\"CharacterBody2D\"]')\nlines.append('motion_mode = 1')\nlines.append('')\nlines.append('[node name=\"AnimatedSprite2D\" type=\"AnimatedSprite2D\" parent=\".\"]')\nlines.append('sprite_frames = SubResource(\"SpriteFrames_1\")')\nlines.append('animation = &\"idle0\"')\nlines.append('speed_scale = 2.0')\nlines.append('')\nlines.append('[node name=\"CollisionShape2D\" type=\"CollisionShape2D\" parent=\".\"]')\nlines.append('position = Vector2(7, 44)')\nlines.append('rotation = 0.785398')\nlines.append('shape = SubResource(\"RectangleShape2D_1\")')\n\nwith open('/workspace/scenes/Player.tscn','w') as f:\n    f.write('\\n'.join(lines)+'\\n')\nprint('written, subresources:', sid-10)\nEOF\npython3 /tmp/opencode/gen_player.py"},"output":"written, subresources: 248\n","metadata":{"output":"written, subresources: 248\n","exit":0,"truncated":false},"title":"cat > /tmp/opencode/gen_player.py << 'EOF'\nimport math\n\nIDLE_W, IDLE_H = 4784, 1920\nWALK_W, WALK_H = 4485, 1920\n\nlines = []\nlines.append('[gd_scene load_steps=20 format=3 uid=\"uid://btc1dq4goqw7s\"]')\nlines.append('')\nlines.append('[ext_resource type=\"Texture2D\" path=\"res://assets/isometric_Mini-Crusader/crusader_idle.png\" id=\"1_idle\"]')\nlines.append('[ext_resource type=\"Texture2D\" path=\"res://assets/isometric_Mini-Crusader/crusader_walk.png\" id=\"2_walk\"]')\nlines.append('')\n\nsid = 10\ndef add_atlas(tex, region):\n    global sid\n    name = f'f{sid}'; sid += 1\n    lines.append(f'[sub_resource type=\"Atl