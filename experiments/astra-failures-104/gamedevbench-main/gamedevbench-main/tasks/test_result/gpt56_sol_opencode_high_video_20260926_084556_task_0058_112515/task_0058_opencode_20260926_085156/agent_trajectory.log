ayer) -> void:","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/scripts/audio_manager.gd","text":"extends Node\n\nvar num_players := 8\nvar bus := \"master\"\n\nvar available: Array = []\nvar queue: Array = []\n\n\nfunc _ready() -> void:\n\t# Build pooled AudioStreamPlayers so sounds can finish after emitters free themselves.\n\tfor i in num_players:\n\t\tvar player := AudioStreamPlayer.new()\n\t\tadd_child(player)\n\t\tavailable.append(player)\n\t\tplayer.finished.connect(on_stream_finished.bind(player))\n\t\tplayer.bus = bus\n\n\nfunc on_stream_finished(stream: AudioStreamPlayer) -> void:\n\t# Return finished players to the available pool.\n\tavailable.append(stream)\n\n\nfunc play(sound_path: String) -> void:\n\tqueue.append(sound_path)\n\n\nfunc _process(_delta: float) -> void:\n\t# Consume queued paths whenever a pooled player is free.\n\tif not queue.is_empty() and not available.is_empty():\n\t\tvar next_player: AudioStreamPlayer = available[0]\n\t\tnext_player.stream = load(queue.pop_front())\n\t\tnext_player.play()\n\t\tavailable.pop_front()","lineStart":1,"lineEnd":35,"totalLines":35,"truncated":false}},"title":"workspace/scripts/audio_manager.gd","time":{"start":1790383758868,"end":1790383758905}},"metadata":{"openai":{"itemId":"fc_0bd8570bba380a17016ab7168cfec0819399f0f090b4990df6"}},"id":"prt_0db301e11001HT3CPltuVczHF7","sessionID":"ses_f24d2af91ffeunLtwcYpBXKMFs","messageID":"msg_0db2d6ea0001iBZiJezHdaAXCw"}}
