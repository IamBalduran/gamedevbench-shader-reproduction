0\u0000�\u0004 \u0000\u0000\u0000�8\u0001\b\u0000\u0000\u0000 N\u0000\u0002\u0000\u0000\u0000�\u0013�\u0000\u0000\u0000\u0000�\u0004 \u0000\u0000\u0000�8\u0001\b\u0000\u0000\u0000 N\u0000\u0002\u0000\u0000\u0000�\u0013�\u0000\u0000\u0000\u0000�\u0004 \u0000\u0000\u0000�8\u0001\b\u0000\u0000\u0000 N\u0000\u0002\u0000\u0000\u0000�\u0013�\u0000\u0000\u0000\u0000�\u0004 \u0000\u0000\u0000�8\u0001\b\u0000\u0000\u0000 N\u0000\u0002\u0000\u0000\u0000�\u0013�\u0000\u0000\u0000\u0000�\u0004 \u0000\u0000\u0000�8\u0001\b\u0000\u0000\u0000 N\u0000\u0002\u0000\u0000\u0000�\u0013�\u0000\u0000\u0000\u0000�\u0004 \u0000\u0000\u0000�8\u0001\b\u0000\u0000\u0000 N\u0000\u0002\u0000\u0000\u0000�\u0013�\u0000\u0000\u0000\u0000�\u0004 \u0000\u0000\u0000�8\u0001\b\u0000\u0000\u0000 N\u0000\u0002\u0000\u0000\u0000�\u0013�\u0000\u0000\u0000\u0000�\u0004 \u0000\u0000\u0000�8\u0001\b\u0000\u0000\u0000 N\u0000\u0002\u0000\u0000\u0000�\u0013�\u0000\u0000\u0000\u0000�\u0004 \u0000\u0000\u0000�8\u0001\b\u0000\u0000\u0000 N\u0000\u0002\u0000\u0000\u0000�\u0013�\u0000\u0000\u0000\u0000�\u0004 \u0000\u0000\u0000�8\u0001\b\u0000\u0000\u0000 N\u0000\u0002\u0000\u0000\u0000�\u0013�\u0000\u0000\u0000\u0000�\u0004 \u0000\u0000\u0000�8\u0001\b\u0000\u0000\u0000 N\u0000\u0002\u0000\u0000\u0000�\u0013�\u0000\u0000\u0000\u0000�\u0004 \u0000\u0000\u0000�8\u0001\b\u0000\u0000\u0000 N\u0000\u0002\u0000\u0000\u0000�\u0013�\u0000\u0000\u0000\u0000�\u0004 \u0000\u0000\u0000�8\u0001\b\u0000\u0000\u0000 N\u0000\u0002\u0000\u0000\u0000�\u0013�\u0000\u0000\u0000\u0000�\u0004 \u0000\u0000\u0000�8\u0001\b\u0000\u0000\u0000 N\u0000\u0002\u0000\u0000\u0000�\u0013�\u0000\u0000\u0000\u0000�\u0004 \u0000\u0000\u0000�8\u0001\b\u0000\u0000\u0000 N\u0000\u0002\u0000\u0000\u0000�\u0013�\u0000\u0000\u0000\u0000�\u0004 \u0000\u0000\u0000�8\u0001\b\u0000\u0000\u0000 N\u0000\u0002\u0000\u0000\u0000�\u0013�\u0000\u0000\u0000\u0000�\u0004 \u0000\u0000\u0000�8\u0001\b\u0000\u0000\u0000 N\u0000\u0002\u0000\u0000\u0000�\u0013�\u0000\u0000\u0000\u0000�\u0004 \u0000\u0000\u0000�8\u0001\b\u0000\u0000\u0000 N\u0000\u0002\u0000\u0000\u0000�\u0013�\u0000\u0000\u0000\u0000��\u0007L[��4˵�\u0000\u0000\u0000\u0000IEND�B`�\n\\ No newline at end of file\n\n","files":[{"filePath":"/workspace/.godot/verify_radar.gd","relativePath":"workspace/.godot/verify_radar.gd","type":"delete","patch":"Index: /workspace/.godot/verify_radar.gd\n===================================================================\n--- /workspace/.godot/verify_radar.gd\n+++ /workspace/.godot/verify_radar.gd\n@@ -1,80 +0,0 @@\n-extends SceneTree\n-\n-var failures: Array[String] = []\n-var range_changes: int = 0\n-\n-\n-func _initialize() -> void:\n-\tdebug_collisions_hint = true\n-\t_run.call_deferred()\n-\n-\n-func _check(condition: bool, message: String) -> void:\n-\tif not condition:\n-\t\tfailures.append(message)\n-\t\tpush_error(message)\n-\n-\n-func _settle() -> void:\n-\tfor frame in range(4):\n-\t\tawait physics_frame\n-\n-\n-func _run() -> void:\n-\tvar main := load(\"res://scenes/main.tscn\").instantiate() as Node2D\n-\tmain.position = Vector2(280, 260)\n-\troot.add_child(main)\n-\tvar player := main.get_node(\"Flagship\") as BattleUnit\n-\tvar near := main.get_node(\"EnemyShipNear\") as BattleUnit\n-\tvar far := main.get_node(\"EnemyShipFar\") as BattleUnit\n-\tvar finder := player.target_finder\n-\tfinder.targets_in_range_changed.connect(func(): range_changes += 1)\n-\tawait _settle()\n-\t_check(player.detect_range.collision_layer == 4 and player.detect_range.collision_mask == 2, \"Player radar filtering\")\n-\t_check(near.detect_range.collision_layer == 8 and near.detect_range.collision_mask == 1, \"Enemy radar filtering\")\n-\t_check(is_equal_approx(player.detect_range.col_shape.shape.radius, 64.0), \"Player radius scales with attack range\")\n-\t_check(is_equal_approx(near.detect_range.col_shape.shape.radius, 32.0), \"Enemy radius scales with attack range\")\n-\t_check(player.detect_range.col_shape.shape != near.detect_range.col_shape.shape, \"Radar shapes are independent\")\n-\t_check(finder.has_target_in_range() and finder.targets_in_range == [near], \"Initial overlap detects only nearby enemy\")\n-\t_check(range_changes == 1, \"Entry emits range-change signal\")\n-\tfinder.find_target()\n-\t_check(finder.target == near, \"Player chooses closest opposing unit\")\n-\tnear.target_finder.find_target()\n-\t_check(near.target_finder.target == player, \"Enemy chooses player fleet\")\n-\tvar unrelated := Area2D.new()\n-\tmain.add_child(unrelated)\n-\tfinder._on_area_entered(unrelated)\n-\tfinder._on_area_exited(unrelated)\n-\t_check(finder.targets_in_range == [near] and range_changes == 1, \"Non-unit areas are ignored\")\n-\tunrelated.queue_free()\n-\tnear.position = Vector2(220, 0)\n-\tawait _settle()\n-\t_check(not finder.has_target_in_range() and range_changes == 2, \"Exit removes unit and emits range-change signal\")\n-\tfinder.find_target()\n-\t_check(finder.target == far, \"Nearest target updates even outside radar range\")\n-\tnear.remove_from_group(\"fleet_b\")\n-\tfar.remove_from_group(\"fleet_b\")\n-\tfinder.find_target()\n-\t_check(finder.target == null, \"Empty opposing fleet clears previous target\")\n-\tnear.add_to_group(\"fleet_b\")\n-\tfar.add_to_group(\"fleet_b\")\n-\tvar updated_stats := player.stats.duplicate() as UnitStats\n-\tupdated_stats.attack_range = 5\n-\tplayer.stats = updated_stats\n-\tawait _settle()\n-\t_check(is_equal_approx(player.detect_range.col_shape.shape.radius, 160.0), \"Reassigned stats resize radar\")\n-\t_check(finder.targets_in_range == [far] and range_changes == 3, \"Expanded radar acquires newly reachable enemy\")\n-\tupdated_stats = player.stats.duplicate() as UnitStats\n-\tupdated_stats.attack_range = 2\n-\tplayer.stats = updated_stats\n-\tnear.position = Vector2(60, 0)\n-\tawait _settle()\n-\tfinder.find_target()\n-\t_check(finder.target == near and finder.targets_in_range == [near], \"Restored scene reacquires nearby enemy\")\n-\tawait process_frame\n-\tawait RenderingServer.frame_post_draw\n-\tvar image := root.get_texture().get_image()\n-\t_check(image.save_png(\"res://.godot/radar_verification.png\") == OK, \"Save visual verification frame\")\n-\tif failures.is_empty():\n-\t\tprint(\"PASS: radar filtering, radii, independent shapes, nearest targets, empty fleets, entry/exit signals, type filtering, and stat reassignment; captured .godot/radar_verification.png\")\n-\tquit(0 if failures.is_empty() else 1)\n","additions":0,"deletions":81},{"filePath":"/workspace/.godot/radar_verification.png","relativePath":"workspace/.godot/radar_verification.png","type":"delete","patch":"Index: /workspace/.godot/radar_verification.png\n===================================================================\n--- /workspace/.godot/radar_verification.png\n+++ /workspace/.godot/radar_verification.png\n@@ -1,5 +0,0 @@\n-�PNG\r\n-\u001a\n-\u0000\u0000\u0000\rIHDR\u0000\u0000\u0004�\u0000\u0000\u0002�\b\u0006\u0000\u0000\u0000\b+�\r\u0000\u0000\u0000\u0001sRGB\u0000��\u001c�\u0000\u0000\u0016�IDATx��ݱq\u0013[\u0003��!'��Cbw�\u0016P\u0019TE\u0019�\u0002\u001d8&tv\u0003*�\u000f\u0018�Ⱦ�H�J�����`\u00068^���Hov���\t\u0000\u0000\u0000���K\u001f\u0000\u0000\u0000\u0000��\u0012�\u0000\u0000\u0000\u0000�\u0004 \u0000\u0000\u0000�8\u0001\b\u0000\u0000\u0000 N\u0000\u0002\u0000\u0000\u0000�\u0013�\u0000\u0000\u0000\u0000�\u0004 \u0000\u0000\u0000�8\u0001\b\u0000\u0000\u0000 N\u0000\u0002\u0000\u0000\u0000�\u0013�\u0000\u0000\u0000\u0000�\u0004 \u0000\u0000\u0000�8\u0001\b\u0000\u0000\u0000 N\u0000\u0002\u0000\u0000\u0000�\u0013�\u0000\u0000\u0000\u0000�\u0004 \u0000\u0000\u0000�8\u0001\b\u0000\u0000\u0000 N\u0000\u0002\u0000\u0000\u0000�\u0013�\u0000\u0000\u0000\u0000�\u0004 \u0000\u0000\u0000�8\u0001\b\u0000\u0000\u0000 N\u0000\u0002\u0000\u0000\u0000�\u0013�\u0000\u0000\u0000\u0000�\u0004 \u0000\u0000\u0000�8\u0001\b\u0000\u0000\u0000 N\u0000\u0002\u0000\u0000\u0000�\u0013�\u0000\u0000\u0000\u0000�\u0004 \u0000\u0000\u0000�8\u0001\b\u0000\u0000