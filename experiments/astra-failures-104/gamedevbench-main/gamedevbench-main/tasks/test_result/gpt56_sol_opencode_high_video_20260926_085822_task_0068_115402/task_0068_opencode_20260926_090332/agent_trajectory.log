"text":"[gd_scene load_steps=5 format=3 uid=\"uid://codex0207main\"]\n\n[ext_resource type=\"Script\" path=\"res://scripts/entities/tank/tank.gd\" id=\"1_tank\"]\n[ext_resource type=\"PackedScene\" uid=\"uid://codex0207bulletgt\" path=\"res://scenes/entities/tank/weapon/bullet.tscn\" id=\"2_bullet\"]\n[ext_resource type=\"PackedScene\" uid=\"uid://codexcratebulletstub\" path=\"res://scenes/entities/world/crate.tscn\" id=\"3_crate\"]\n\n[sub_resource type=\"GDScript\" id=\"GDScript_demo\"]\nscript/source = \"extends Node2D\n\n@export var bullet_scene: PackedScene\nvar tank: Tank\nvar time_elapsed := 0.0\n\nfunc _ready():\n\t# Position camera to see the action\n\tvar camera = Camera2D.new()\n\tcamera.enabled = true\n\tadd_child(camera)\n\n\t# Get tank reference\n\ttank = $Tank\n\n\t# Spawn initial bullet\n\tspawn_bullet()\n\nfunc _process(delta):\n\ttime_elapsed += delta\n\t# Spawn a new bullet every 2 seconds\n\tif time_elapsed > 2.0:\n\t\ttime_elapsed = 0.0\n\t\tspawn_bullet()\n\nfunc spawn_bullet():\n\tif bullet_scene:\n\t\tvar bullet = bullet_scene.instantiate()\n\t\tbullet.position = tank.global_position + Vector2(50, 0)\n\t\tbullet.direction = Vector2.RIGHT\n\t\tbullet.tank = tank\n\t\tadd_child(bullet)\n\"\n\n[node name=\"Main\" type=\"Node2D\"]\nscript = SubResource(\"GDScript_demo\")\nbullet_scene = ExtResource(\"2_bullet\")\n\n[node name=\"Tank\" type=\"Node2D\" parent=\".\"]\nposition = Vector2(100, 300)\nscript = ExtResource(\"1_tank\")\n\n[node name=\"TankVisual\" type=\"ColorRect\" parent=\"Tank\"]\noffset_left = -15.0\noffset_top = -15.0\noffset_right = 15.0\noffset_bottom = 15.0\ncolor = Color(0.3, 0.6, 0.9, 1)\n\n[node name=\"Label\" type=\"Label\" parent=\"Tank\"]\noffset_left = -30.0\noffset_top = -40.0\noffset_right = 30.0\noffset_bottom = -20.0\ntext = \"Tank\"\nhorizontal_alignment = 1\n\n[node name=\"Crate1\" parent=\".\" instance=ExtResource(\"3_crate\")]\nposition = Vector2(400, 250)\n\n[node name=\"Crate2\" parent=\".\" instance=ExtResource(\"3_crate\")]\nposition = Vector2(450, 300)\n\n[node name=\"Crate3\" parent=\".\" instance=ExtResource(\"3_crate\")]\nposition = Vector2(500, 350)\n\n[node name=\"Instructions\" type=\"Label\" parent=\".\"]\noffset_left = 20.0\noffset_top = 20.0\noffset_right = 600.0\noffset_bottom = 80.0\ntext = \"Bullet Collision Test Demo\nBullets spawn from the tank and travel right.\nThey should disappear when hitting crates (and destroy them).\"","lineStart":1,"lineEnd":81,"totalLines":81,"truncated":false}},"title":"workspace/scenes/main.tscn","time":{"start":1790384371786,"end":1790384371815}},"metadata":{"openai":{"itemId":"fc_0e9c8914fca17ada016ab718f347a88197b78d5fc48c69d68a"}},"id":"prt_0db3978440014ivUPYwYyyFvop","sessionID":"ses_f24c75dc5ffeigNuz8ytcRE5zl","messageID":"msg_0db396170001VkwKKFS8wnYVk1"}}
