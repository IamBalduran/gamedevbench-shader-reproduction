.emit(card_ui)\n\n\nfunc on_input(event: InputEvent) -> void:\t\n\tvar mouse_motion := event is InputEventMouseMotion","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/scenes/card_ui/card_states/card_aiming_state.gd","text":"extends CardState\n\nconst MOUSE_Y_SNAPBACK_THRESHOLD := 138\n\n\nfunc enter() -> void:\n\tcard_ui.targets.clear()\n\tvar offset := Vector2(card_ui.parent.size.x / 2, -card_ui.size.y / 2)\n\toffset.x -= card_ui.size.x / 2\n\tcard_ui.animate_to_position(card_ui.parent.global_position + offset, 0.2)\n\tcard_ui.drop_point_detector.monitoring = false\n\tEvents.card_aim_started.emit(card_ui)\n\n\nfunc exit() -> void:\n\tEvents.card_aim_ended.emit(card_ui)\n\n\nfunc on_input(event: InputEvent) -> void:\t\n\tvar mouse_motion := event is InputEventMouseMotion\n\tvar mouse_at_bottom := card_ui.get_global_mouse_position().y > MOUSE_Y_SNAPBACK_THRESHOLD\n\t\n\tif (mouse_motion and mouse_at_bottom) or event.is_action_pressed(\"right_mouse\"):\n\t\ttransition_requested.emit(self, CardState.State.BASE)\n\telif event.is_action_released(\"left_mouse\") or event.is_action_pressed(\"left_mouse\"):\n\t\tget_viewport().set_input_as_handled()\n\t\ttransition_requested.emit(self, CardState.State.RELEASED)","lineStart":1,"lineEnd":27,"totalLines":27,"truncated":false}},"title":"workspace/scenes/card_ui/card_states/card_aiming_state.gd","time":{"start":1790378886283,"end":1790378886351}},"metadata":{"openai":{"itemId":"fc_0f76bd1f89ba432e016ab70385f8bc87d29112aa4ca5c85bfa"}},"id":"prt_0dae5c4880010gJr7pA9ycat08","sessionID":"ses_f251bf6b6ffeWIYIIntuXQvo9d","messageID":"msg_0dae5b2d9001iZSN6wPhv3VScV"}}
