 - card_ui.pivot_offset\n\tcard_ui.state_label.text = \"Dragging\"\n\n\nfunc on_input(event: InputEvent) -> void:\n\tif event is InputEventMouseMotion:\n\t\tcard_ui.global_position = card_ui.get_global_mouse_position() - card_ui.pivot_offset\n\telif event.is_action_pressed(\"right_mouse\"):","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/scenes/card_ui/card_states/card_dragging_state.gd","text":"extends \"res://scenes/card_ui/card_states/card_state.gd\"\n\nconst DRAG_MINIMUM_THRESHOLD := 0.05\n\nvar drag_started_at := 0\n\n\nfunc enter() -> void:\n\tdrag_started_at = Time.get_ticks_msec()\n\tvar drag_layer := get_tree().get_first_node_in_group(\"hud_drag_layer\")\n\tif drag_layer:\n\t\tcard_ui.reparent(drag_layer)\n\tcard_ui.global_position = card_ui.get_global_mouse_position() - card_ui.pivot_offset\n\tcard_ui.state_label.text = \"Dragging\"\n\n\nfunc on_input(event: InputEvent) -> void:\n\tif event is InputEventMouseMotion:\n\t\tcard_ui.global_position = card_ui.get_global_mouse_position() - card_ui.pivot_offset\n\telif event.is_action_pressed(\"right_mouse\"):\n\t\tget_viewport().set_input_as_handled()\n\t\ttransition_requested.emit(self, State.BASE)\n\telif event.is_action_released(\"left_mouse\") or event.is_action_pressed(\"left_mouse\"):\n\t\tget_viewport().set_input_as_handled()\n\t\tif (Time.get_ticks_msec() - drag_started_at) / 1000.0 >= DRAG_MINIMUM_THRESHOLD:\n\t\t\ttransition_requested.emit(self, State.RELEASED)","lineStart":1,"lineEnd":26,"totalLines":26,"truncated":false}},"title":"workspace/scenes/card_ui/card_states/card_dragging_state.gd","time":{"start":1790379305911,"end":1790379305948}},"metadata":{"openai":{"itemId":"fc_0f76bd1f89ba432e016ab7052989d487d2ac755371f35aa8ee"}},"id":"prt_0daec2bb4001SoOhP6BthUCnat","sessionID":"ses_f251bf6b6ffeWIYIIntuXQvo9d","messageID":"msg_0daea2a35001yYPA3UrxcGrF2A"}}
