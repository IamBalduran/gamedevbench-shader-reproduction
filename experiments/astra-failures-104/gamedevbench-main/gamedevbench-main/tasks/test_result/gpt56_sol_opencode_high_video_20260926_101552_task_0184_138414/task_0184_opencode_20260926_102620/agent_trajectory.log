ate == State.WALK:\n \t\tanimation_player.play(\"walk\")\n-\telif state == State.ATTACK:\n-\t\tanimation_player.play(\"punch\")\n+ elif state == State.ATTACK:\n+  animation_player.play(\"punch\")\n+ elif state == State.HURT:\n+  animation_player.play(\"hurt\")\n \n func flip_sprites() -> void:\n \tif velocity.x > 0:\n \t\tcharacter_sprite.flip_h = false\n@@ -59,10 +67,18 @@\n func can_attack() -> bool:\n \treturn state == State.IDLE or state == State.ATTACK\n \n func on_action_complete() -> void:\n-\tstate = State.IDLE\n+ if state == State.HURT and health <= 0:\n+  queue_free()\n+  return\n+ state = State.IDLE\n \n func on_emit_damage(damage_receiver: DamageReceiver) -> void:\n-\tvar direction := Vector2.LEFT if damage_receiver.global_position.x < global_position.x else Vector2.RIGHT\n-\tdamage_receiver.damage_received.emit(damage, direction)\n-\tprint(damage_receiver)\n+ var direction := Vector2.LEFT if damage_receiver.global_position.x < global_position.x else Vector2.RIGHT\n+ damage_receiver.damage_received.emit(damage, direction)\n+\n+func on_receive_damage(received_damage: int, direction: Vector2) -> void:\n+ health -= received_damage\n+ state = State.HURT\n+ velocity = direction.normalized() * knockback_intensity\n+ damage_emitter.set_deferred(\"monitoring\", false)\n","additions":30,"deletions":14},{"filePath":"/workspace/scenes/characters/character.tscn","relativePath":"workspace/scenes/characters/character.tscn","type":"update","patch":"Index: /workspace/scenes/characters/character.tscn\n===================================================================\n--- /workspace/scenes/characters/character.tscn\n+++ /workspace/scenes/characters/character.tscn\n@@ -1,9 +1,10 @@\n-[gd_scene load_steps=4 format=3 uid=\"uid://h4wo2mqnh48o\"]\n+[gd_scene load_steps=5 format=3 uid=\"uid://h4wo2mqnh48o\"]\n \n [ext_resource type=\"Script\" path=\"res://scenes/characters/character.gd\" id=\"1_cqjif\"]\n [ext_resource type=\"Texture2D\" uid=\"uid://d0jo43xa8ljw5\" path=\"res