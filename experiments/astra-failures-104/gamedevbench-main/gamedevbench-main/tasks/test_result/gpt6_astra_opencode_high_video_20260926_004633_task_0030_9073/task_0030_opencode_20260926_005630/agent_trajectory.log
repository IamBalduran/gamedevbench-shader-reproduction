{"type":"tool_use","timestamp":1790354826175,"sessionID":"ses_f26899619ffecqyLhbTRWoo0Np","part":{"type":"tool","tool":"read","callID":"call_LGRBvqvNLHoIrMytQtD6FEu0","state":{"status":"completed","input":{"filePath":"/workspace/addons/SunshineClouds2/SunshineCloudsDriver.gd"},"output":"<path>/workspace/addons/SunshineClouds2/SunshineCloudsDriver.gd</path>\n<type>file</type>\n<content>\n1: @tool\n2: @icon(\"res://addons/SunshineClouds2/CloudsDriverIcon.svg\")\n3: extends Node\n4: class_name SunshineCloudsDriverGD\n5: \n6: @export var update_continuously: bool = false:\n7: \tget:\n8: \t\treturn update_continuously\n9: \tset(value):\n10: \t\tupdate_continuously = value\n11: \t\tretrieve_texture_data()\n12: \n13: @export_tool_button(\"Generate Clouds Resource\", \"Add\") var generate_action = build_new_clouds\n14: #@export_tool_button(\"Test Clouds Position Sample\", \"Add\") var position_sample = sample_clouds\n15: \n16: \n17: @export_group(\"Compositor Resource\")\n18: @export var clouds_resource: SunshineCloudsGD\n19: @export_group(\"Optional World Environment\")\n20: @export var ambience_sample_environment: Environment\n21: @export var use_enviornment_ambience_for_fog: bool = false\n22: @export_group(\"Light Controls\")\n23: @export var tracked_directional_lights: Array[DirectionalLight3D] = []:\n24: \tget:\n25: \t\treturn tracked_directional_lights\n26: \tset(value):\n27: \t\ttracked_directional_lights = value\n28: \t\tretrieve_texture_data()\n29: \n30: @export var tracked_directional_light_shadow_steps: Array[int] = []:\n31: \tget:\n32: \t\treturn tracked_directional_light_shadow_steps\n33: \tset(value):\n34: \t\ttracked_directional_light_shadow_steps = value\n35: \t\tretrieve_texture_data()\n36: \n37: @export var tracked_point_lights: Array[OmniLight3D] = []:\n38: \tget:\n39: \t\treturn tracked_point_lights\n40: \tset(value):\n41: \t\ttracked_point_lights = value\n42: \t\tretrieve_texture_data()\n43: \n44: @export var tracked_point_effectors: Array[SunshineCloudsEffector] = []:\n45: \tget:\n46: \t\treturn tracked_point_effectors\n47: \tset(value):\n48: \t\ttracked_point_effectors = value\n49: \t\tretrieve_texture_data()\n50: \n51: @export var directional_light_power_multiplier: float = 1.0\n52: @export var point_light_power_multiplier: float = 1.0\n53: @export_group(\"Wind Controls\")\n54: @export var origin_offset : Vector3 = Vector3.ZERO\n55: @export var wind_direction: Vector3 = Vector3(1.0, 0.0, 1.0)\n56: @export var extra_large_structures_wind_speed: float = 140.0\n57: @export var large_structures_wind_speed: float = 100.0\n58: @export var medium_structures_wind_speed: float = 40.0\n59: @export var small_structures_wind_speed: float = 12.0\n60: @export_group(\"Internal Use\")\n61: var extra_large_clouds_pos: Vector3 = Vector3.ZERO\n62: var large_clouds_pos: Vector3 = Vector3.ZERO\n63: var medium_clouds_pos: Vector3 = Vector3.ZERO\n64: var small_clouds_pos: Vector3 = Vector3.ZERO\n65: \n66: var _extralarge_clouds_domain: float = 0.0\n67: var _large_clouds_domain: float = 0.0\n68: var _medium_clouds_domain: float = 0.0\n69: var _small_clouds_domain: float = 0.0\n70: \n71: var _updating_settings: bool = false\n72: \n73: func _ready():\n74: \t\n75: \tif update_continuously:\n76: \t\t\n77: \t\tif clouds_resource == null:\n78: \t\t\tupdate_continuously = false\n79: \t\t\treturn\n80: \t\tcall_deferred(\"retrieve_texture_data\")\n81: \n82: \n83: func _process(delta : float):\n84: \tif clouds_resource != null:\n85: \t\tclouds_resource.current_time = wrap(clouds_resource.current_time + delta * clouds_resource.dither_speed, 0.0, clouds_resource.dither_speed * 64.0)\n86: \t\t\n87: \t\tif update_continuously:\n88: \t\t\t_updating_settings = false\n89: \t\t\textra_large_clouds_pos += wind_direction * extra_large_structures_wind_speed * delta\n90: \t\t\textra_large_clouds_pos = wrap_vector(extra_large_clouds_pos, _extralarge_clouds_domain)\n91: \t\t\tlarge_clouds_pos += wind_direction * large_structures_wind_speed * delta\n92: \t\t\tlarge_clouds_pos = wrap_vector(large_clouds_pos, _large_clouds_domain)\n93: \t\t\tmedium_clouds_pos += wind_direction * medium_structures_wind_speed * delta\n94: \t\t\tmedium_clouds_pos = wrap_vector(medium_clouds_pos, _medium_clouds_domain)\n95: \t\t\tsmall_clouds_pos += ((wind_direction * small_structures_wind_speed) + (Vector3.UP * abs(small_structures_wind_speed))) * delta\n96: \t\t\tsmall_clouds_pos = wrap_vector(small_clouds_pos, _small_clouds_domain)\n97: \t\t\t\n98: \t\t\tclouds_resource.origin_offset = origin_offset\n99: \t\t\tclouds_resource.extra_large_scale_clouds_position = origin_offset + extra_large_clouds_pos\n100: \t\t\tclouds_resource.large_scale_clouds_position = origin_offset + large_clouds_pos\n101: \t\t\tclouds_resource.medium_scale_clouds_position = origin_offset + medium_clouds_pos\n102: \t\t\tclouds_resource.detail_clouds_position = origin_offset + small_clouds_pos\n103: \t\t\t\n104: \t\t\tclouds_resource.wind_direction = wind_direction\n105: \t\t\t\n106: \t\t\tif use_enviornment_ambience_for_fog and ambience_sample_environment != null:\n107: \t\t\t\tclouds_resource.atmosphere_color = ambience_sample_environment.fog_light_color\n108: \t\t\t\tclouds_resource.cloud_ambient_color = ambience_sample_environment.fog_light_color\n109: \t\t\t\n110: \t\t\tif (tracked_directional_lights.size() * 2.0 != clouds_resource.directional_lights_data.size() \\\n111: \t\t\tor tracked_point_lights.size() * 2.0 != clouds_resource.point_lights_data.size()\\\n112: \t\t\tor tracked_directional_lights.size() != tracked_directional_light_shadow_steps.size()):\n113: \t\t\t\t\n114: \t\t\t\tretrieve_texture_data()\n115: \t\t\t\treturn\n116: \t\t\t\n117: \t\t\tfor i in range(tracked_directional_lights.size()):\n118: \t\t\t\tif tracked_directional_lights[i] == null:\n119: \t\t\t\t\tcontinue\n120: \t\t\t\tif direction_light_data_changed(tracked_directional_lights[i], tracked_directional_light_shadow_steps[i], clouds_resource.directional_lights_data[i * 2], clouds_resource.directional_lights_data[i * 2 + 1]):\n121: \t\t\t\t\tretrieve_texture_data()\n122: \t\t\t\t\treturn\n123: \t\t\t\n124: \t\t\tfor i in range(tracked_point_lights.size()):\n125: \t\t\t\tif tracked_point_lights[i] == null:\n126: \t\t\t\t\tcontinue\n127: \t\t\t\tif point_light_data_changed(tracked_point_lights[i], clouds_resource.point_lights_data[i * 2], clouds_resource.point_lights_data[i * 2 + 1]):\n128: \t\t\t\t\tretrieve_texture_data()\n129: \t\t\t\t\treturn\n130: \t\t\t\n131: \t\t\tfor i in range(tracked_point_effectors.size()):\n132: \t\t\t\tif tracked_point_effectors[i] == null:\n133: \t\t\t\t\tcontinue\n134: \t\t\t\tif point_effector_data_changed(tracked_point_effectors[i], clouds_resource.point_effector_data[i * 2], clouds_resource.point_effector_data[i * 2 + 1]):\n135: \t\t\t\t\tretrieve_texture_data()\n136: \t\t\t\t\treturn\n137: \t\t\t\n138: \telse:\n139: \t\tupdate_continuously = false\n140: \n141: func sample_clouds():\n142: \tfor i in range(64):\n143: \t\tclouds_resource.add_sample(return_data.bind(), Vector3(i * 1000, 6000.0, 0.0))\n144: \n145: func return_data(position : Vector3, sampledensity : float):\n146: \tprint(position, \" \", sampledensity)\n147: \tpass\n148: \n149: func build_new_clouds():\n150: \tif (is_inside_tree()):\n151: \t\tvar env : WorldEnvironment = recursively_find_env(get_tree().root)\n152: \t\tif (env):\n153: \t\t\tif not ambience_sample_environment:\n154: \t\t\t\tambience_sample_environment = env.environment\n155: \t\t\t\n156: \t\t\tvar newClouds = SunshineCloudsGD.new()\n157: \t\t\tResourceSaver.save(newClouds, \"res://NewCloudsGD.tres\")\n158: \t\t\tclouds_resource = ResourceLoader.load(\"res://NewCloudsGD.tres\")\n159: \t\t\t\n160: \t\t\tif not env.compositor:\n161: \t\t\t\tenv.compositor = Compositor.new()\n162: \t\t\tenv.compositor.compositor_effects = [clouds_resource]\n163: \t\t\t\n164: \t\t\tupdate_continuously = true\n165: \t\telse:\n166: \t\t\tprinterr(\"No world environment found.\")\n167: \n168: \n169: func recursively_find_env(thisNode: Node) -> WorldEnvironment:\n170: \tfor child in thisNode.get_children():\n171: \t\tif child is WorldEnvironment:\n172: \t\t\treturn child\n173: \t\telse:\n174: \t\t\tvar result = recursively_find_env(child)\n175: \t\t\tif (result):\n176: \t\t\t\treturn result\n177: \t\n178: \treturn null\n179: \n180: func retrieve_texture_data():\n181: \tif _updating_settings || !is_inside_tree():\n182: \t\treturn\n183: \t_updating_settings = true\n184: \tif clouds_resource != null:\n185: \t\t_extralarge_clouds_domain = clouds_resource.extra_large_noise_scale / 2.0\n186: \t\t_large_clouds_domain = clouds_resource.large_noise_scale / 2.0\n187: \t\t_medium_clouds_domain = clouds_resource.medium_noise_scale / 2.0\n188: \t\t_small_clouds_domain = clouds_resource.small_noise_scale / 2.0\n189: \t\t\n190: \t\tclouds_resource.directional_lights_data.clear()\n191: \t\tclouds_resource.point_lights_data.clear()\n192: \t\tclouds_resource.point_effector_data.clear()\n193: \t\t\n194: \t\tif not tracked_directional_light_shadow_steps:\n195: \t\t\ttracked_directional_light_shadow_steps = []\n196: \t\t\n197: \t\tif tracked_directional_light_shadow_steps.size() < tracked_directional_lights.size():\n198: \t\t\tfor i in range(tracked_directional_lights.size() - tracked_directional_light_shadow_steps.size()):\n199: \t\t\t\ttracked_directional_light_shadow_steps.append(12)\n200: \t\t\n201: \t\tfor i in range(tracked_directional_lights.size()):\n202: \t\t\tif tracked_directional_lights[i] != null:\n203: \t\t\t\tvar light = tracked_directional_lights[i]\n204: \t\t\t\tvar look_dir = light.global_transform.basis.z.normalized()\n205: \t\t\t\tclouds_resource.directional_lights_data.append(Vector4(look_dir.x, look_dir.y, look_dir.z, tracked_directional_light_shadow_steps[i]))\n206: \t\t\t\tclouds_resource.directional_lights_data.append(Vector4(light.light_color.r, light.light_color.g, light.light_color.b, round(light.light_color.a * light.light_energy * directional_light_power_multiplier * 10.0) / 10.0))\n207: \t\t\n208: \t\tfor i in range(tracked_point_lights.size()):\n209: \t\t\tif tracked_point_lights[i] != null:\n210: \t\t\t\tvar light = tracked_point_lights[i]\n211: \t\t\t\tvar light_pos = light.global_position\n212: \t\t\t\tclouds_resource.point_lights_data.append(Vector4(light_pos.x, light_pos.y, light_pos.z, light.omni_range))\n213: \t\t\t\tclouds_resource.point_lights_data.append(Vector4(light.light_color.r, light.light_color.g, light.light_color.b, round(light.light_color.a * light.light_energy * point_light_power_multiplier * 10.0) / 10.0))\n214: \t\t\n215: \t\t\n216: \t\tfor i in range(tracked_point_effectors.size()):\n217: \t\t\tif tracked_point_effectors[i] != null:\n218: \t\t\t\tvar node = tracked_point_effectors[i]\n219: \t\t\t\tvar node_pos = node.global_position\n220: \t\t\t\tclouds_resource.point_effector_data.append(Vector4(node_pos.x, node_pos.y, node_pos.z, node.Radius))\n221: \t\t\t\tclouds_resource.point_effector_data.append(Vector4(node.Power, 0.0, 0.0, 0.0))\n222: \t\t\n223: \t\t\n224: \t\tclouds_resource.lights_updated = true\n225: \t\n226: \t_updating_settings = false\n227: \n228: func wrap_vector(target, domain_size):\n229: \tif target.x > domain_size:\n230: \t\ttarget.x -= domain_size * 2.0\n231: \telif target.x < -domain_size:\n232: \t\ttarget.x += domain_size * 2.0\n233: \n234: \tif target.y > domain_size:\n235: \t\ttarget.y -= domain_size * 2.0\n236: \telif target.y < -domain_size:\n237: \t\ttarget.y += domain_size * 2.0\n238: \n239: \tif target.z > domain_size:\n240: \t\ttarget.z -= domain_size * 2.0\n241: \telif target.z < -domain_size:\n242: \t\ttarget.z += domain_size * 2.0\n243: \n244: \treturn target\n245: \n246: func direction_light_data_changed(light : DirectionalLight3D, shadowCount : int, dirData : Vector4, colorData : Vector4):\n247: \treturn light.global_transform.basis.z.x != dirData.x \\\n248: \t\tor light.global_transform.basis.z.y != dirData.y \\\n249: \t\tor light.global_transform.basis.z.z != dirData.z \\\n250: \t\tor float(shadowCount) != dirData.w \\\n251: \t\tor light.light_color.r != colorData.x \\\n252: \t\tor light.light_color.g != colorData.y \\\n253: \t\tor light.light_color.b != colorData.z \\\n254: \t\tor round(light.light_color.a * light.light_energy * directional_light_power_multiplier * 10.0) / 10.0 != round(colorData.w * 10.0) / 10.0\n255: \n256: \n257: func point_light_data_changed(light : OmniLight3D, dirData : Vector4, colorData : Vector4):\n258: \treturn light.global_position.x != dirData.x \\\n259: \t\tor light.global_position.y != dirData.y \\\n260: \t\tor light.global_position.z != dirData.z \\\n261: \t\tor light.omni_range != dirData.w \\\n262: \t\tor light.light_color.r != colorData.x \\\n263: \t\tor light.light_color.g != colorData.y \\\n264: \t\tor light.light_color.b != colorData.z \\\n265: \t\tor round(light.light_color.a * light.light_energy * point_light_power_multiplier * 10.0) / 10.0 != round(colorData.w * 10.0) / 10.0\n266: \n267: func point_effector_data_changed(node : SunshineCloudsEffector, dirData : Vector4, colorData : Vector4):\n268: \treturn node.global_position.x != dirData.x \\\n269: \t\tor node.global_position.y != dirData.y \\\n270: \t\tor node.global_position.z != dirData.z \\\n271: \t\tor node.Radius != dirData.w \\\n272: \t\tor node.Power != colorData.x\n\n(End of file - total 272 lines)\n</content>","metadata":{"preview":"@tool\n@icon(\"res://addons/SunshineClouds2/CloudsDriverIcon.svg\")\nextends Node\nclass_name SunshineCloudsDriverGD\n\n@export var update_continuously: bool = false:\n\tget:\n\t\treturn update_continuously\n\tset(value):\n\t\tupdate_continuously = value\n\t\tretrieve_texture_data()\n\n@export_tool_button(\"Generate Clouds Resource\", \"Add\") var generate_action = build_new_clouds\n#@export_tool_button(\"Test Clouds Position Sample\", \"Add\") var position_sample = sample_clouds\n\n\n@export_group(\"Compositor Resource\")\n@export var clouds_resource: SunshineCloudsGD\n@export_group(\"Optional World Environment\")\n@export var ambience_sample_environment: Environment","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/addons/SunshineClouds2/SunshineCloudsDriver.gd","text":"@tool\n@icon(\"res://addons/SunshineClouds2/CloudsDriverIcon.svg\")\nextends Node\nclass_name SunshineCloudsDriverGD\n\n@export var update_continuously: bool = false:\n\tget:\n\t\treturn update_continuously\n\tset(value):\n\t\tupdate_continuously = value\n\t\tretrieve_texture_data()\n\n@export_tool_button(\"Generate Clouds Resource\", \"Add\") var generate_action = build_new_clouds\n#@export_tool_button(\"Test Clouds Position Sample\", \"Add\") var position_sample = sample_clouds\n\n\n@export_group(\"Compositor Resource\")\n@export var clouds_resource: SunshineCloudsGD\n@export_group(\"Optional World Environment\")\n@export var ambience_sample_environment: Environment\n@export var use_enviornment_ambience_for_fog: bool = false\n@export_group(\"Light Controls\")\n@export var tracked_directional_lights: Array[DirectionalLight3D] = []:\n\tget:\n\t\treturn tracked_directional_lights\n\tset(value):\n\t\ttracked_directional_lights = value\n\t\tretrieve_texture_data()\n\n@export var tracked_directional_light_shadow_steps: Array[int] = []:\n\tget:\n\t\treturn tracked_directional_light_shadow_steps\n\tset(value):\n\t\ttracked_directional_light_shadow_steps = value\n\t\tretrieve_texture_data()\n\n@export var tracked_point_lights: Array[OmniLight3D] = []:\n\tget:\n\t\treturn tracked_point_lights\n\tset(value):\n\t\ttracked_point_lights = value\n\t\tretrieve_texture_data()\n\n@export var tracked_point_effectors: Array[SunshineCloudsEffector] = []:\n\tget:\n\t\treturn tracked_point_effectors\n\tset(value):\n\t\ttracked_point_effectors = value\n\t\tretrieve_texture_data()\n\n@export var directional_light_power_multiplier: float = 1.0\n@export var point_light_power_multiplier: float = 1.0\n@export_group(\"Wind Controls\")\n@export var origin_offset : Vector3 = Vector3.ZERO\n@export var wind_direction: Vector3 = Vector3(1.0, 0.0, 1.0)\n@export var extra_large_structures_wind_speed: float = 140.0\n@export var large_structures_wind_speed: float = 100.0\n@export var medium_structures_wind_speed: float = 40.0\n@export var small_structures_wind_speed: float = 12.0\n@export_group(\"Internal Use\")\nvar extra_large_clouds_pos: Vector3 = Vector3.ZERO\nvar large_clouds_pos: Vector3 = Vector3.ZERO\nvar medium_clouds_pos: Vector3 = Vector3.ZERO\nvar small_clouds_pos: Vector3 = Vector3.ZERO\n\nvar _extralarge_clouds_domain: float = 0.0\nvar _large_clouds_domain: float = 0.0\nvar _medium_clouds_domain: float = 0.0\nvar _small_clouds_domain: float = 0.0\n\nvar _updating_settings: bool = false\n\nfunc _ready():\n\t\n\tif update_continuously:\n\t\t\n\t\tif clouds_resource == null:\n\t\t\tupdate_continuously = false\n\t\t\treturn\n\t\tcall_deferred(\"retrieve_texture_data\")\n\n\nfunc _process(delta : float):\n\tif clouds_resource != null:\n\t\tclouds_resource.current_time = wrap(clouds_resource.current_time + delta * clouds_resource.dither_speed, 0.0, clouds_resource.dither_speed * 64.0)\n\t\t\n\t\tif update_continuously:\n\t\t\t_updating_settings = false\n\t\t\textra_large_clouds_pos += wind_direction * extra_large_structures_wind_speed * delta\n\t\t\textra_large_clouds_pos = wrap_vector(extra_large_clouds_pos, _extralarge_clouds_domain)\n\t\t\tlarge_clouds_pos += wind_direction * large_structures_wind_speed * delta\n\t\t\tlarge_clouds_pos = wrap_vector(large_clouds_pos, _large_clouds_domain)\n\t\t\tmedium_clouds_pos += wind_direction * medium_structures_wind_speed * delta\n\t\t\tmedium_clouds_pos = wrap_vector(medium_clouds_pos, _medium_clouds_domain)\n\t\t\tsmall_clouds_pos += ((wind_direction * small_structures_wind_speed) + (Vector3.UP * abs(small_structures_wind_speed))) * delta\n\t\t\tsmall_clouds_pos = wrap_vector(small_clouds_pos, _small_clouds_domain)\n\t\t\t\n\t\t\tclouds_resource.origin_offset = origin_offset\n\t\t\tclouds_resource.extra_large_scale_clouds_position = origin_offset + extra_large_clouds_pos\n\t\t\tclouds_resource.large_scale_clouds_position = origin_offset + large_clouds_pos\n\t\t\tclouds_resource.medium_scale_clouds_position = origin_offset + medium_clouds_pos\n\t\t\tclouds_resource.detail_clouds_position = origin_offset + small_clouds_pos\n\t\t\t\n\t\t\tclouds_resource.wind_direction = wind_direction\n\t\t\t\n\t\t\tif use_enviornment_ambience_for_fog and ambience_sample_environment != null:\n\t\t\t\tclouds_resource.atmosphere_color = ambience_sample_environment.fog_light_color\n\t\t\t\tclouds_resource.cloud_ambient_color = ambience_sample_environment.fog_light_color\n\t\t\t\n\t\t\tif (tracked_directional_lights.size() * 2.0 != clouds_resource.directional_lights_data.size() \\\n\t\t\tor tracked_point_lights.size() * 2.0 != clouds_resource.point_lights_data.size()\\\n\t\t\tor tracked_directional_lights.size() != tracked_directional_light_shadow_steps.size()):\n\t\t\t\t\n\t\t\t\tretrieve_texture_data()\n\t\t\t\treturn\n\t\t\t\n\t\t\tfor i in range(tracked_directional_lights.size()):\n\t\t\t\tif tracked_directional_lights[i] == null:\n\t\t\t\t\tcontinue\n\t\t\t\tif direction_light_data_changed(tracked_directional_lights[i], tracked_directional_light_shadow_steps[i], clouds_resource.directional_lights_data[i * 2], clouds_resource.directional_lights_data[i * 2 + 1]):\n\t\t\t\t\tretrieve_texture_data()\n\t\t\t\t\treturn\n\t\t\t\n\t\t\tfor i in range(tracked_point_lights.size()):\n\t\t\t\tif tracked_point_lights[i] == null:\n\t\t\t\t\tcontinue\n\t\t\t\tif point_light_data_changed(tracked_point_lights[i], clouds_resource.point_lights_data[i * 2], clouds_resource.point_lights_data[i * 2 + 1]):\n\t\t\t\t\tretrieve_texture_data()\n\t\t\t\t\treturn\n\t\t\t\n\t\t\tfor i in range(tracked_point_effectors.size()):\n\t\t\t\tif tracked_point_effectors[i] == null:\n\t\t\t\t\tcontinue\n\t\t\t\tif point_effector_data_changed(tracked_point_effectors[i], clouds_resource.point_effector_data[i * 2], clouds_resource.point_effector_data[i * 2 + 1]):\n\t\t\t\t\tretrieve_texture_data()\n\t\t\t\t\treturn\n\t\t\t\n\telse:\n\t\tupdate_continuously = false\n\nfunc sample_clouds():\n\tfor i in range(64):\n\t\tclouds_resource.add_sample(return_data.bind(), Vector3(i * 1000, 6000.0, 0.0))\n\nfunc return_data(position : Vector3, sampledensity : float):\n\tprint(position, \" \", sampledensity)\n\tpass\n\nfunc build_new_clouds():\n\tif (is_inside_tree()):\n\t\tvar env : WorldEnvironment = recursively_find_env(get_tree().root)\n\t\tif (env):\n\t\t\tif not ambience_sample_environment:\n\t\t\t\tambience_sample_environment = env.environment\n\t\t\t\n\t\t\tvar newClouds = SunshineCloudsGD.new()\n\t\t\tResourceSaver.save(newClouds, \"res://NewCloudsGD.tres\")\n\t\t\tclouds_resource = ResourceLoader.load(\"res://NewCloudsGD.tres\")\n\t\t\t\n\t\t\tif not env.compositor:\n\t\t\t\tenv.compositor = Compositor.new()\n\t\t\tenv.compositor.compositor_effects = [clouds_resource]\n\t\t\t\n\t\t\tupdate_continuously = true\n\t\telse:\n\t\t\tprinterr(\"No world environment found.\")\n\n\nfunc recursively_find_env(thisNode: Node) -> WorldEnvironment:\n\tfor child in thisNode.get_children():\n\t\tif child is WorldEnvironment:\n\t\t\treturn child\n\t\telse:\n\t\t\tvar result = recursively_find_env(child)\n\t\t\tif (result):\n\t\t\t\treturn result\n\t\n\treturn null\n\nfunc retrieve_texture_data():\n\tif _updating_settings || !is_inside_tree():\n\t\treturn\n\t_updating_settings = true\n\tif clouds_resource != null:\n\t\t_extralarge_clouds_domain = clouds_resource.extra_large_noise_scale / 2.0\n\t\t_large_clouds_domain = clouds_resource.large_noise_scale / 2.0\n\t\t_medium_clouds_domain = clouds_resource.medium_noise_scale / 2.0\n\t\t_small_clouds_domain = clouds_resource.small_noise_scale / 2.0\n\t\t\n\t\tclouds_resource.directional_lights_data.clear()\n\t\tclouds_resource.point_lights_data.clear()\n\t\tclouds_resource.point_effector_data.clear()\n\t\t\n\t\tif not tracked_directional_light_shadow_steps:\n\t\t\ttracked_directional_light_shadow_steps = []\n\t\t\n\t\tif tracked_directional_light_shadow_steps.size() < tracked_directional_lights.size():\n\t\t\tfor i in range(tracked_directional_lights.size() - tracked_directional_light_shadow_steps.size()):\n\t\t\t\ttracked_directional_light_shadow_steps.append(12)\n\t\t\n\t\tfor i in range(tracked_directional_lights.size()):\n\t\t\tif tracked_directional_lights[i] != null:\n\t\t\t\tvar light = tracked_directional_lights[i]\n\t\t\t\tvar look_dir = light.global_transform.basis.z.normalized()\n\t\t\t\tclouds_resource.directional_lights_data.append(Vector4(look_dir.x, look_dir.y, look_dir.z, tracked_directional_light_shadow_steps[i]))\n\t\t\t\tclouds_resource.directional_lights_data.append(Vector4(light.light_color.r, light.light_color.g, light.light_color.b, round(light.light_color.a * light.light_energy * directional_light_power_multiplier * 10.0) / 10.0))\n\t\t\n\t\tfor i in range(tracked_point_lights.size()):\n\t\t\tif tracked_point_lights[i] != null:\n\t\t\t\tvar light = tracked_point_lights[i]\n\t\t\t\tvar light_pos = light.global_position\n\t\t\t\tclouds_resource.point_lights_data.append(Vector4(light_pos.x, light_pos.y, light_pos.z, light.omni_range))\n\t\t\t\tclouds_resource.point_lights_data.append(Vector4(light.light_color.r, light.light_color.g, light.light_color.b, round(light.light_color.a * light.light_energy * point_light_power_multiplier * 10.0) / 10.0))\n\t\t\n\t\t\n\t\tfor i in range(tracked_point_effectors.size()):\n\t\t\tif tracked_point_effectors[i] != null:\n\t\t\t\tvar node = tracked_point_effectors[i]\n\t\t\t\tvar node_pos = node.global_position\n\t\t\t\tclouds_resource.point_effector_data.append(Vector4(node_pos.x, node_pos.y, node_pos.z, node.Radius))\n\t\t\t\tclouds_resource.point_effector_data.append(Vector4(node.Power, 0.0, 0.0, 0.0))\n\t\t\n\t\t\n\t\tclouds_resource.lights_updated = true\n\t\n\t_updating_settings = false\n\nfunc wrap_vector(target, domain_size):\n\tif target.x > domain_size:\n\t\ttarget.x -= domain_size * 2.0\n\telif target.x < -domain_size:\n\t\ttarget.x += domain_size * 2.0\n\n\tif target.y > domain_size:\n\t\ttarget.y -= domain_size * 2.0\n\telif target.y < -domain_size:\n\t\ttarget.y += domain_size * 2.0\n\n\tif target.z > domain_size:\n\t\ttarget.z -= domain_size * 2.0\n\telif target.z < -domain_size:\n\t\ttarget.z += domain_size * 2.0\n\n\treturn target\n\nfunc direction_light_data_changed(light : DirectionalLight3D, shadowCount : int, dirData : Vector4, colorData : Vector4):\n\treturn light.global_transform.basis.z.x != dirData.x \\\n\t\tor light.global_transform.basis.z.y != dirData.y \\\n\t\tor light.global_transform.basis.z.z != dirData.z \\\n\t\tor float(shadowCount) != dirData.w \\\n\t\tor light.light_color.r != colorData.x \\\n\t\tor light.light_color.g != colorData.y \\\n\t\tor light.light_color.b != colorData.z \\\n\t\tor round(light.light_color.a * light.light_energy * directional_light_power_multiplier * 10.0) / 10.0 != round(colorData.w * 10.0) / 10.0\n\n\nfunc point_light_data_changed(light : OmniLight3D, dirData : Vector4, colorData : Vector4):\n\treturn light.global_position.x != dirData.x \\\n\t\tor light.global_position.y != dirData.y \\\n\t\tor light.global_position.z != dirData.z \\\n\t\tor light.omni_range != dirData.w \\\n\t\tor light.light_color.r != colorData.x \\\n\t\tor light.light_color.g != colorData.y \\\n\t\tor light.light_color.b != colorData.z \\\n\t\tor round(light.light_color.a * light.light_energy * point_light_power_multiplier * 10.0) / 10.0 != round(colorData.w * 10.0) / 10.0\n\nfunc point_effector_data_changed(node : SunshineCloudsEffector, dirData : Vector4, colorData : Vector4):\n\treturn node.global_position.x != dirData.x \\\n\t\tor node.global_position.y != dirData.y \\\n\t\tor node.global_position.z != dirData.z \\\n\t\tor node.Radius != dirData.w \\\n\t\tor node.Power != colorData.x","lineStart":1,"lineEnd":272,"totalLines":272,"truncated":false}},"title":"workspace/addons/SunshineClouds2/SunshineC