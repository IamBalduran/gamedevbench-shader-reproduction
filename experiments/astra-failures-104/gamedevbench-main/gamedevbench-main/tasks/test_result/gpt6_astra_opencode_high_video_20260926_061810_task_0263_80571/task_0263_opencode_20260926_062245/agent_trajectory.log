\tnear.remove_from_group(\"goblins\")\n+\tfar.remove_from_group(\"goblins\")\n+\thero.target_finder.find_target()\n+\tassert(hero.target_finder.target == null)\n+\tnear.add_to_group(\"goblins\")\n+\tfar.add_to_group(\"goblins\")\n+\n+\tvar updated_stats := UnitStats.new()\n+\tupdated_stats.team = UnitStats.Team.ENEMY\n+\tupdated_stats.attack_range = 2\n+\thero.stats = updated_stats\n+\tassert(hero.detect_range.stats == hero.stats)\n+\tassert(hero.detect_range.collision_layer == 8)\n+\tassert(hero.detect_range.collision_mask == 1)\n+\tassert(is_equal_approx(hero.detect_range.col_shape.shape.radius, 64.0))\n+\thero.stats = load(\"res://data/units/bjorn.tres\")\n+\tnear.position = Vector2(70, 0)\n+\tfar.position = Vector2(140, 0)\n+\tdecoy.queue_free()\n+\tawait _settle()\n+\n+\tif DisplayServer.get_name() != \"headless\":\n+\t\tawait RenderingServer.frame_post_draw\n+\t\tvar image := root.get_texture().get_image()\n+\t\tassert(image.save_png(\"res://.godot/aggro_verification.png\") == OK)\n+\tprint(\"PASS: opposing groups, nearest targets, non-unit filtering, range signals, independent shapes, and stats updates\")\n+\tquit()\n\n","files":[{"filePath":"/workspace/custom_nodes/detect_range.gd","relativePath":"workspace/custom_nodes/detect_range.gd","type":"update","patch":"Index: /workspace/custom_nodes/detect_range.gd\n===================================================================\n--- /workspace/custom_nodes/detect_range.gd\n+++ /workspace/custom_nodes/detect_range.gd\n@@ -1,9 +1,9 @@\n class_name DetectRange\n extends Area2D\n \n @export var col_shape: CollisionShape2D\n-@export var base_range_size: float = 16.0\n+@export var base_range_size: float = 32.0\n @export var stats: UnitStats: set = _set_stats\n \n \n func _set_stats(value: UnitStats) -> void:\n","additions":1,"deletions":1},{"filePath":"/workspace/scenes/battle_unit/battle_unit.tscn","relativePath":"workspace/scenes/battle_unit/battle_unit.tscn","type":"update","patch":"Index: /workspace/scenes/battle