.emit(card_ui)\n\n\nfunc on_input(event: InputEvent) -> void:\t\n\tvar mouse_motion := event is InputEventMouseMotion","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/scenes/card_ui/card_states/card_aiming_state.gd","text":"extends CardState\n\nconst MOUSE_Y_SNAPBACK_THRESHOLD := 138\n\n\nfunc enter() -> void:\n\tcard_ui.targets.clear()\n\tvar offset := Vector2(card_ui.parent.size.x / 2, -card_ui.size.y / 2)\n\toffset.x -= card_ui.size.x / 2\n\tcard_ui.animate_to_position(card_ui.parent.global_position + offset, 0.2)\n\tcard_ui.drop_point_detector.monitoring = false\n\tEvents.card_aim_started.emit(card_ui)\n\n\nfunc exit() -> void:\n\tEvents.card_aim_ended.emit(card_ui)\n\n\nfunc on_input(event: InputEvent) -> void:\t\n\tvar mouse_motion := event is InputEventMouseMotion\n\tvar mouse_at_bottom := card_ui.get_global_mouse_position().y > MOUSE_Y_SNAPBACK_THRESHOLD\n\t\n\tif (mouse_motion and mouse_at_bottom) or event.is_action_pressed(\"right_mouse\"):\n\t\ttransition_requested.emit(self, CardState.State.BASE)\n\telif event.is_action_released(\"left_mouse\") or event.is_action_pressed(\"left_mouse\"):\n\t\tget_viewport().set_input_as_handled()\n\t\ttransition_requested.emit(self, CardState.State.RELEASED)","lineStart":1,"lineEnd":27,"totalLines":27,"truncated":false}},"title":"workspace/scenes/card_ui/card_states/card_aiming_state.gd","time":{"start":1790378473571,"end":1790378473610}},"metadata":{"openai":{"itemId":"fc_02bfb33d89592db3016ab701e936748194b059bcbf436f0c27"}},"id":"prt_0dadf7861001EQRnjJR6J1z0fd","sessionID":"ses_f2520e5c2ffeq7u3toHEo6FuTf","messageID":"msg_0dadf66a8001SjDISeosQiJ4t1"}}
