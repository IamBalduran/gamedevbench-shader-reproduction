t_requested.emit(card_ui)\n+\tcard_ui.drop_point_detector.monitoring = false\n+\tcard_ui.targets.clear()\n+\tcard_ui.pivot_offset = Vector2.ZERO\n+\tcard_ui.state_label.text = \"Base\"\n+\n+\n+func on_gui_input(event: InputEvent) -> void:\n+\tif event.is_action_pressed(\"left_mouse\"):\n+\t\tcard_ui.pivot_offset = card_ui.get_global_mouse_position() - card_ui.global_position\n+\t\tcard_ui.accept_event()\n+\t\ttransition_requested.emit(self, State.CLICKED)\n","additions":15,"deletions":0},{"filePath":"/workspace/scenes/card_ui/card_states/card_clicked_state.gd","relativePath":"workspace/scenes/card_ui/card_states/card_clicked_state.gd","type":"update","patch":"Index: /workspace/scenes/card_ui/card_states/card_clicked_state.gd\n===================================================================\n--- /workspace/scenes/card_ui/card_states/card_clicked_state.gd\n+++ /workspace/scenes/card_ui/card_states/card_clicked_state.gd\n@@ -1,1 +1,12 @@\n extends \"res://scenes/card_ui/card_states/card_state.gd\"\n+\n+\n+func enter() -> void:\n+\tcard_ui.original_index = card_ui.get_index()\n+\tcard_ui.drop_point_detector.monitoring = true\n+\tcard_ui.state_label.text = \"Clicked\"\n+\n+\n+func on_input(event: InputEvent) -> void:\n+\tif event is InputEventMouseMotion:\n+\t\ttransition_requested.emit(self, State.DRAGGING)\n","additions":11,"deletions":0},{"filePath":"/workspace/scenes/card_ui/card_states/card_dragging_state.gd","relativePath":"workspace/scenes/card_ui/card_states/card_dragging_state.gd","type":"update","patch":"Index: /workspace/scenes/card_ui/card_states/card_dragging_state.gd\n===================================================================\n--- /workspace/scenes/card_ui/card_states/card_dragging_state.gd\n+++ /workspace/scenes/card_ui/card_states/card_dragging_state.gd\n@@ -1,3 +1,30 @@\n extends \"res://scenes/card_ui/card_states/card_state.gd\"\n \n const DRAG_MINIMUM_THRESHOLD := 0.09\n+\n+var drag_started_at := 0\n+\n+\n+func enter() -> void:\n+\tdrag_started_at = Time.get_ticks_usec()\n+\tvar drag_layer := get_tree().get_first_node_in_group(\"ui_drag_layer\")\n+\tif drag_layer:\n+\t\tcard_ui.reparent(drag_layer)\n+\tcard_ui.global_position = card_ui.get_global_mouse_position() - card_ui.pivot_offset\n+\tcard_ui.state_label.text = \"Dragging\"\n+\n+\n+func on_input(event: InputEvent) -> void:\n+\tif event is InputEventMouseMotion:\n+\t\tcard_ui.global_position = card_ui.get_global_mouse_position() - card_ui.pivot_offset\n+\n+\tif event.is_action_pressed(\"right_mouse\"):\n+\t\tget_viewport().set_input_as_handled()\n+\t\ttransition_requested.emit(self, State.BASE)\n+\t\treturn\n+\n+\tvar minimum_drag_time_elapsed := (Time.get_ticks_usec() - drag_started_at) / 1000000.0 >= DRAG_MINIMUM_THRESHOLD\n+\tvar confirm := event.is_action_released(\"left_mouse\") or event.is_action_pressed(\"left_mouse\")\n+\tif minimum_drag_time_elapsed and confirm:\n+\t\tget_viewport().set_input_as_handled()\n+\t\ttransition_requested.emit(self, State.RELEASED)\n","additions":27,"deletions":0},{"filePath":"/workspace/scenes/card_ui/card_states/card_released_state.gd","relativePath":"workspace/scenes/card_ui/card_states/card_released_state.gd","type":"update","patch":"Index: /workspace/scenes/card_ui/card_states/card_released_state.gd\n===================================================================\n--- /workspace/scenes/card_ui/card_states/card_released_state.gd\n+++ /workspace/scenes/card_ui/card_states/card_released_state.gd\n@@ -1,1 +1,15 @@\n extends \"res://scenes/card_ui/card_states/card_state.gd\"\n+\n+var played := false\n+\n+\n+func enter() -> void:\n+\tcard_ui.state_label.text = \"Released\"\n+\tplayed = not card_ui.targets.is_empty()\n+\tif played:\n+\t\tcard_ui.play()\n+\n+\n+func on_input(_event: InputEvent) -> void:\n+\tif not played:\n+\t\ttransition_requested.emit(self, State.BASE)\n","additions":14,"deletions":0},{"filePath":"/workspace/scenes/ui/hand.gd","relativePath":"workspace/scenes/ui/hand.gd","type":"update","patc