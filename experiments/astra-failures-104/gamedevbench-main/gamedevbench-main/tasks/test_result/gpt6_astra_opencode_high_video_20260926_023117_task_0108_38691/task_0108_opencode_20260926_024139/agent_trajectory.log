cle gradient using `World.get_gradient_at(position)`, assign it to each emitter\\u2019s `process_material.color_ramp`, set both emitters to `emitting = true` while moving, and `emitting = false` when not moving.\"\n}","lineStart":1,"lineEnd":3,"totalLines":3,"truncated":false}},"title":"workspace/task_config.json","time":{"start":1790361469239,"end":1790361469267}},"metadata":{"openai":{"itemId":"fc_016fd62095b0050b016ab6bf7c83d087d0abeebd0f21e80dda"}},"id":"prt_0d9dc0134001b3WNxCwJZJ4Fle","sessionID":"ses_f2629bb21ffe0xvzFay5jseIhh","messageID":"msg_0d9db6594001f7VSBNxd3j4Dqg"}}
