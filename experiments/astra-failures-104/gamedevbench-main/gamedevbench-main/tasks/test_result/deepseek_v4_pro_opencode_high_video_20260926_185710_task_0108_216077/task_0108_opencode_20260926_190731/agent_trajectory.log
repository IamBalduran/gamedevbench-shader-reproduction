\tif gradient:\n\t\t\tvar left_mat := left_particles.process_material as ParticleProcessMaterial\n\t\t\tvar right_mat := right_particles.process_material as ParticleProcessMaterial\n\t\t\tif left_mat:\n\t\t\t\tleft_mat.color_ramp = gradient\n\t\t\tif right_mat:\n\t\t\t\tright_mat.color_ramp = gradient","lineStart":1,"lineEnd":38,"totalLines":38,"truncated":false}},"title":"workspace/scripts/tank.gd","time":{"start":1790420814434,"end":1790420814451}},"metadata":{"openai":{"itemId":"msg_1e472497-b297-4c09-b27c-bcfee726dafc"}},"id":"prt_0dd658a5f001mkLCn0iTcjrSiK","sessionID":"ses_f22a320d7ffeQcQJvEQv7gZZrl","messageID":"msg_0dd655720001MSpJIqwL8K4a4a"}}
