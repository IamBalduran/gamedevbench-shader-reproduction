turn vals\n\treturn []\nEOF\ntimeout 30 godot --headless --path /workspace -s /tmp/opencode/verify_jump.gd 2>&1 | grep -v \"^Godot Engine\" | head -20","timeout":40000},"output":"\nanimations: [\"RESET\", \"hurt\", \"idle\", \"jump\", \"land\", \"punch\", \"takeoff\", \"walk\"]\ntakeoff frame values: [61, 61, 61]\njump frame values: [62]\nland frame values: [60, 60, 60, 60, 60]\ntakeoff method calls: [&\"on_takeoff_complete\"]\nland method calls: [&\"on_land_complete\"]\nland monitoring track: [[0.0, false]]\n","metadata":{"output":"\nanimations: [\"RESET\", \"hurt\", \"idle\", \"jump\", \"land\", \"punch\", \"takeoff\", \"walk\"]\ntakeoff frame values: [61, 61, 61]\njump frame values: [62]\nland frame values: [60, 60, 60, 60, 60]\ntakeoff method calls: [&\"on_takeoff_complete\"]\nland method calls: [&\"on_land_complete\"]\nland monitoring track: [[0.0, false]]\n","exit":0,"truncated":false},"title":"cat > /tmp/opencode/verify_jump.gd <<'EOF'\nextends SceneTree\n\nfunc _init() -> void:\n\tvar scene : PackedScene = load(\"res://scenes/characters/player.tscn\")\n\tvar player = scene.instantiate()\n\troot.add_child(player)\n\tawait process_frame\n\tvar ap : AnimationPlayer = player.get_node(\"AnimationPlayer\")\n\tprint(\"animations: \", ap.get_animation_list())\n\tvar takeoff : Animation = ap.get_animation(\"takeoff\")\n\tvar jump : Animation = ap.get_animation(\"jump\")\n\tvar land : Animation = ap.get_animation(\"land\")\n\tprint(\"takeoff frame values: \", _frame_values(takeoff))\n\tprint(\"jump frame values: \", _frame_values(jump))\n\tprint(\"land frame values: \", _frame_values(land))\n\tprint(\"takeoff method calls: \", _method_calls(takeoff))\n\tprint(\"land method calls: \", _method_calls(land))\n\tprint(\"land monitoring track: \", _monitoring_track(land))\n\tquit()\n\nfunc _frame_values(anim: Animation) -> Array:\n\tfor i in anim.get_track_count():\n\t\tif str(anim.track_get_path(i)) == \"CharacterSprite:frame\":\n\t\t\tvar vals := []\n\t\t\tfor k in anim.t