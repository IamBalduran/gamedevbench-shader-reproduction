telse:\n55: \t\t\tstate = State.WALK\n56: \n57: func handle_input() -> void:\n58: \tpass\n59: \n60: func handle_animations() -> void:\n61: \tif animation_player.has_animation(anim_map[state]):\n62: \t\tanimation_player.play(anim_map[state])\n63: \n64: func handle_state_transitions(delta: float) -> void:\n65: \tif state == State.TAKEOFF:\n66: \t\tstate_time += delta\n67: \t\tif state_time >= 0.05:\n68: \t\t\ton_takeoff_complete()\n69: \telif state == State.LAND:\n70: \t\tstate_time += delta\n71: \t\tif state_time >= 0.05:\n72: \t\t\ton_land_complete()\n73: \n74: func handle_air_time(delta: float) -> void:\n75: \tif state == State.JUMP or state == State.JUMPKICK:\n76: \t\theight += height_speed * delta\n77: \t\tif height < 0:\n78: \t\t\theight = 0\n79: \t\t\tset_state(State.LAND)\n80: \t\telse:\n81: \t\t\theight_speed -= GRAVITY * delta\n82: \n83: func flip_sprites() -> void:\n84: \tif velocity.x > 0:\n85: \t\tcharacter_sprite.flip_h = false\n86: \t\tdamage_emitter.scale.x = 1\n87: \telif velocity.x < 0:\n88: \t\tcharacter_sprite.flip_h = true\n89: \t\tdamage_emitter.scale.x = -1\n90: \n91: func can_move() -> bool:\n92: \treturn state == State.IDLE or state == State.WALK\n93: \n94: func can_attack() -> bool:\n95: \treturn state == State.IDLE or state == State.WALK\n96: \n97: func can_jump() -> bool:\n98: \treturn state == State.IDLE or state == State.WALK\n99: \n100: func can_jumpkick() -> bool:\n101: \treturn state == State.JUMP\n102: \n103: func on_action_complete() -> void:\n104: \tset_state(State.IDLE)\n105: \n106: func on_takeoff_complete() -> void:\n107: \tset_state(State.JUMP)\n108: \theight_speed = jump_intensity\n109: \n110: func on_land_complete() -> void:\n111: \tset_state(State.IDLE)\n112: \n113: func on_receive_damage(received_damage: int, direction: Vector2) -> void:\n114: \tcurrent_health = clamp(current_health - received_damage, 0, max_health)\n115: \tif current_health <= 0:\n116: \t\tqueue_free()\n117: \telse:\n118: \t\tset_state(State.HURT)\n119: \t\tvelocity = direction * knockback_intensity\n120: \n121: func on_emit_damage(target_damage_receiver: DamageReceiver) -> void:\n122: \tvar direction := Vector2.LEFT if target_damage_receiver.global_position.x < global_position.x else Vector2.RIGHT\n123: \ttarget_damage_receiver.damage_received.emit(damage, direction)\n124: \n125: func set_state(next_state: State) -> void:\n126: \tif state == next_state:\n127: \t\treturn\n128: \tstate = next_state\n129: \tstate_time = 0.0\n\n(End of file - total 129 lines)\n</content>","metadata":{"preview":"class_name Character\nextends CharacterBody2D\n\nconst GRAVITY := 600.0\n\n@export var damage : int\n@export var jump_intensity : float\n@export var knockback_intensity : float\n@export var max_health : int\n@export var speed : float\n\n@onready var animation_player := $AnimationPlayer\n@onready var character_sprite := $CharacterSprite\n@onready var damage_emitter := $DamageEmitter\n@onready var damage_receiver : DamageReceiver = $DamageReceiver\n\nenum State {IDLE, WALK, ATTACK, TAKEOFF, JUMP, LAND, JUMPKICK, HURT}\n\nvar anim_map := {\n\tState.IDLE: \"idle\",","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/scenes/characters/character.gd","text":"class_name Character\nextends CharacterBody2D\n\nconst GRAVITY := 600.0\n\n@export var damage : int\n@export var jump_intensity : float\n@export var knockback_intensity : float\n@export var max_health : int\n@export var speed : float\n\n@onready var animation_player := $AnimationPlayer\n@onready var character_sprite := $CharacterSprite\n@onready var damage_emitter := $DamageEmitter\n@onready var damage_receiver : DamageReceiver = $DamageReceiver\n\nenum State {IDLE, WALK, ATTACK, TAKEOFF, JUMP, LAND, JUMPKICK, HURT}\n\nvar anim_map := {\n\tState.IDLE: \"idle\",\n\tState.WALK: \"walk\",\n\tState.ATTACK: \"punch\",\n\tState.TAKEOFF: \"takeoff\",\n\tState.JUMP: \"jump\",\n\tState.LAND: \"land\",\n\tState.JUMPKICK: \"jumpkick\",\n\tState.HURT: \"hurt\",\n}\nvar current_health := 0\nvar height := 0.0\nvar height_speed := 0.0\nvar state_time := 0.0\nvar state := State.IDLE\n\nfunc _ready() -> void:\n\tdamage_emitter.area_entered.connect(on_emit_damage.bind())\n\tdamage_receiver.damage_received.connect(on_receive_damage.bind())\n\tcurrent_health = max_health\n\nfunc _process(delta: float) -> void:\n\thandle_input()\n\thandle_movement()\n\thandle_animations()\n\thandle_state_transitions(delta)\n\thandle_air_time(delta)\n\tflip_sprites()\n\tcharacter_sprite.position = Vector2.UP * height\n\tmove_and_slide()\n\nfunc handle_movement() -> void:\n\tif can_move():\n\t\tif velocity.length() == 0:\n\t\t\tstate = State.IDLE\n\t\telse:\n\t\t\tstate = State.WALK\n\nfunc handle_input() -> void:\n\tpass\n\nfunc handle_animations() -> void:\n\tif animation_player.has_animation(anim_map[state]):\n\t\tanimation_player.play(anim_map[state])\n\nfunc handle_state_transitions(delta: float) -> void:\n\tif state == State.TAKEOFF:\n\t\tstate_time += delta\n\t\tif state_time >= 0.05:\n\t\t\ton_takeoff_complete()\n\telif state == State.LAND:\n\t\tstate_time += delta\n\t\tif state_time >= 0.05:\n\t\t\ton_land_complete()\n\nfunc handle_air_time(delta: float) -> void:\n\tif state == State.JUMP or state == State.JUMPKICK:\n\t\theight += height_speed * delta\n\t\tif height < 0:\n\t\t\theight = 0\n\t\t\tset_state(State.LAND)\n\t\telse:\n\t\t\theight_speed -= GRAVITY * delta\n\nfunc flip_sprites() -> void:\n\tif velocity.x > 0:\n\t\tcharacter_sprite.flip_h = false\n\t\tdamage_emitter.scale.x = 1\n\telif velocity.x < 0:\n\t\tcharacter_sprite.flip_h = true\n\t\tdamage_emitter.scale.x = -1\n\nfunc can_move() -> bool:\n\treturn state == State.IDLE or state == State.WALK\n\nfunc can_attack() -> bool:\n\treturn state == State.IDLE or state == State.WALK\n\nfunc can_jump() -> bool:\n\treturn state == State.IDLE or state == State.WALK\n\nfunc can_jumpkick() -> bool:\n\treturn state == State.JUMP\n\nfunc on_action_complete() -> void:\n\tset_state(State.IDLE)\n\nfunc on_takeoff_complete() -> void:\n\tset_state(State.JUMP)\n\theight_speed = jump_intensity\n\nfunc on_land_complete() -> void:\n\tset_state(State.IDLE)\n\nfunc on_receive_damage(received_damage: int, direction: Vector2) -> void:\n\tcurrent_health = clamp(current_health - received_damage, 0, max_health)\n\tif current_health <= 0:\n\t\tqueue_free()\n\telse:\n\t\tset_state(State.HURT)\n\t\tvelocity = direction * knockback_intensity\n\nfunc on_emit_damage(target_damage_receiver: DamageReceiver) -> void:\n\tvar direction := Vector2.LEFT if target_damage_receiver.global_position.x < global_position.x else Vector2.RIGHT\n\ttarget_damage_receiver.damage_received.emit(damage, direction)\n\nfunc set_state(next_state: State) -> void:\n\tif state == next_state:\n\t\treturn\n\tstate = next_state\n\tstate_time = 0.0","lineStart":1,"lineEnd":129,"totalLines":129,"truncated":false}},"title":"workspace/scenes/characters/character.gd","time":{"start":1790388420027,"end":1790388420081}},"metadata":{"openai":{"itemId":"fc_0c81d411bfcdd66a016ab728c38a688196a835abcc6d1da39f"}},"id":"prt_0db773db5001SLQE3iR058GAVz","sessionID":"ses_f2489bdd3ffeKkqP11CI1Qff0N","messageID":"msg_0db772c710018WjGw6hQaWhf4Q"}}
