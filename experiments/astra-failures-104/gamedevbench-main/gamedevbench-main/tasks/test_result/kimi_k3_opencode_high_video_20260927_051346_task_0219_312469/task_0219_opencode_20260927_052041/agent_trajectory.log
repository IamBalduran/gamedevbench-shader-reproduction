= 75 and ss >= 0.45 and vv >= 0.45:\n            mask[y][x] = True\n\nvisited = [[False]*w for _ in range(h)]\ncomps = []\nfor y in range(h):\n    for x in range(w):\n        if mask[y][x] and not visited[y][x]:\n            q = deque([(x,y)])\n            visited[y][x] = True\n            xs=[]; ys=[]\n            while q:\n                cx, cy = q.popleft()\n                xs.append(cx); ys.append(cy)\n                for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):\n                    nx, ny = cx+dx, cy+dy\n                    if 0<=nx<w and 0<=ny<h and mask[ny][nx] and not visited[ny][nx]:\n                        visited[ny][nx]=True\n                        q.append((nx,ny))\n            comps.append((len(xs), min(xs), min(ys), max(xs), max(ys)))\n\n# coin-like components: bounding box roughly 15-40 px both dims, area >= 100\ncoins = []\nfor area, x0, y0, x1, y1 in comps:\n    wd = x1-x0+1; hd = y1-y0+1\n    if 15 <= wd <= 40 and 15 <= hd <= 40 and area >= 100:\n        coins.append((area, x0,y0,x1,y1))\n\nprint(len(coins))\nfor c in coins:\n    area, x0,y0,x1,y1 = c\n    print(f\"area={area} bbox=({x0},{y0})-({x1},{y1}) center=({(x0+x1)/2:.1f},{(y0+y1)/2:.1f}) size=({x1-x0+1},{y1-y0+1})\")\nEOF","time":{"start":1790457448081,"end":1790457448576}},"metadata":{"openai":{"itemId":"fc_bash:43"}},"id":"prt_0df94868d001wpFH7gLCrr2ldn","sessionID":"ses_f206e9e18ffe3xVZdep0998676","messageID":"msg_0df9462780019IKy024Q0kfJjB"}}
