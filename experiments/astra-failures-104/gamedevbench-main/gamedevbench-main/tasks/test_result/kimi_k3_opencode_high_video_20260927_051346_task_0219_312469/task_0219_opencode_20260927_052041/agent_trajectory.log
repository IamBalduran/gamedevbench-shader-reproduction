ormer.jpg').convert('RGB')\nw, h = img.size\npx = img.load()\n\n# Mask of yellow-ish pixels\nmask = [[False]*w for _ in range(h)]\nfor y in range(h):\n    for x in range(w):\n        r,g,b = px[x,y]\n        # convert to hsv\n        hh, ss, vv = colorsys.rgb_to_hsv(r/255.0, g/255.0, b/255.0)\n        hue_deg = hh*360\n        if 38 <= hue_deg <= 75 and ss >= 0.45 and vv >= 0.45:\n            mask[y][x] = True\n\n# Connected components (4-connectivity)\nvisited = [[False]*w for _ in range(h)]\nfrom collections import deque\ncomps = []\nfor y in range(h):\n    for x in range(w):\n        if mask[y][x] and not visited[y][x]:\n            q = deque([(x,y)])\n            visited[y][x] = True\n            xs=[]; ys=[]\n            while q:\n                cx, cy = q.popleft()\n                xs.append(cx); ys.append(cy)\n                for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):\n                    nx, ny = cx+dx, cy+dy\n                    if 0<=nx<w and 0<=ny<h and mask[ny][nx] and not visited[ny][nx]:\n                        visited[ny][nx]=True\n                        q.append((nx,ny))\n            comps.append((len(xs), min(xs), min(ys), max(xs), max(ys)))\n\ncomps.sort(reverse=True)\nprint(\"num comps:\", len(comps))\nfor c in comps[:30]:\n    area, x0, y0, x1, y1 = c\n    print(f\"area={area} bbox=({x0},{y0})-({x1},{y1}) center=({(x0+x1)/2:.1f},{(y0+y1)/2:.1f}) size=({x1-x0+1},{y1-y0+1})\")\nEOF","time":{"start":1790457318385,"end":1790457318804}},"metadata":{"openai":{"itemId":"fc_bash_21_5cc83afc"}},"id":"prt_0df928be9001EuhVgpbUO0T7eJ","sessionID":"ses_f206e9e18ffe3xVZdep0998676","messageID":"msg_0df923cae001vHtml14oR3E5pP"}}
