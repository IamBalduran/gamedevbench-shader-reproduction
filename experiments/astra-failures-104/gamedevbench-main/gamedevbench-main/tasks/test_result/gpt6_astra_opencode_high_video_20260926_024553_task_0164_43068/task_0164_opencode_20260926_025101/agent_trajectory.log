\n111: \tcurrent_health = clamp(current_health - received_damage, 0, max_health)\n112: \tif current_health <= 0:\n113: \t\tqueue_free()\n114: \telse:\n115: \t\tjump_height = 0.0\n116: \t\tjump_velocity = 0.0\n117: \t\tcharacter_sprite.position.y = grounded_sprite_y\n118: \t\tstate = State.HURT\n119: \t\tvelocity = direction * knockback_intensity\n120: \n121: func on_emit_damage(target_damage_receiver: DamageReceiver) -> void:\n122: \tvar direction := Vector2.LEFT if target_damage_receiver.global_position.x < global_position.x else Vector2.RIGHT\n123: \ttarget_damage_receiver.damage_received.emit(damage, direction)\n\n(End of file - total 123 lines)\n</content>","metadata":{"preview":"class_name Character\nextends CharacterBody2D\n\n@export var damage : int\n@export var knockback_intensity : float\n@export var max_health : int\n@export var speed : float\n@export var jump_speed : float = 100.0\n@export var jump_gravity : float = 300.0\n\n@onready var animation_player := $AnimationPlayer\n@onready var character_sprite := $CharacterSprite\n@onready var damage_emitter := $DamageEmitter\n@onready var damage_receiver : DamageReceiver = $DamageReceiver\n@onready var grounded_sprite_y : float = $CharacterSprite.position.y\n\nenum State {IDLE, WALK, ATTACK, HURT, TAKEOFF, JUMP, LAND}\n\nvar anim_map := {\n\tState.IDLE: \"idle\",","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/scenes/characters/character.gd","text":"class_name Character\nextends CharacterBody2D\n\n@export var damage : int\n@export var knockback_intensity : float\n@export var max_health : int\n@export var speed : float\n@export var jump_speed : float = 100.0\n@export var jump_gravity : float = 300.0\n\n@onready var animation_player := $AnimationPlayer\n@onready var character_sprite := $CharacterSprite\n@onready var damage_emitter := $DamageEmitter\n@onready var damage_receiver : DamageReceiver = $DamageReceiver\n@onready var grounded_sprite_y : float = $CharacterSprite.position.y\n\nenum State {IDLE, WALK, ATTACK, HURT, TAKEOFF, JUMP, LAND}\n\nvar anim_map := {\n\tState.IDLE: \"idle\",\n\tState.WALK: \"walk\",\n\tState.ATTACK: \"punch\",\n\tState.HURT: \"hurt\",\n\tState.TAKEOFF: \"takeoff\",\n\tState.JUMP: \"jump\",\n\tState.LAND: \"land\",\n}\nvar current_health := 0\nvar state := State.IDLE\nvar jump_height := 0.0\nvar jump_velocity := 0.0\n\nfunc _ready() -> void:\n\tdamage_emitter.area_entered.connect(on_emit_damage.bind())\n\tdamage_receiver.damage_received.connect(on_receive_damage.bind())\n\tcurrent_health = max_health\n\nfunc _process(delta: float) -> void:\n\thandle_input()\n\thandle_movement()\n\thandle_jump(delta)\n\thandle_animations()\n\tflip_sprites()\n\tmove_and_slide()\n\nfunc handle_movement() -> void:\n\tif can_move():\n\t\tif velocity.length() == 0:\n\t\t\tstate = State.IDLE\n\t\telse:\n\t\t\tstate = State.WALK\n\nfunc handle_input() -> void:\n\tif not can_move() and not can_attack():\n\t\treturn\n\n\tvar direction := Input.get_vector(\"ui_left\", \"ui_right\", \"ui_up\", \"ui_down\")\n\tif can_move():\n\t\tvelocity = direction * speed\n\tif can_attack() and Input.is_action_just_pressed(\"attack\"):\n\t\tstate = State.ATTACK\n\telif can_move() and Input.is_action_just_pressed(\"jump\"):\n\t\tstate = State.TAKEOFF\n\nfunc handle_jump(delta: float) -> void:\n\tif state != State.JUMP:\n\t\treturn\n\n\t# Height is separate from movement along the ground and the shadow.\n\tjump_height += jump_velocity * delta - 0.5 * jump_gravity * delta * delta\n\tjump_velocity -= jump_gravity * delta\n\tif jump_height <= 0.0:\n\t\tjump_height = 0.0\n\t\tjump_velocity = 0.0\n\t\tvelocity = Vector2.ZERO\n\t\tstate = State.LAND\n\tcharacter_sprite.position.y = grounded_sprite_y - jump_height\n\nfunc handle_animations() -> void:\n\tif animation_player.has_animation(anim_map[state]):\n\t\tanimation_player.play(anim_map[state])\n\nfunc flip_sprites() -> void:\n\tif velocity.x > 0:\n\t\tcharacter_sprite.flip_h = false\n\t\tdamage_emitter.scale.x = 1\n\telif velocity.x < 0:\n\t\tcharacter_sprite.flip_h = true\n\t\tdamage_emitter.scale.x = -1\n\nfunc can_move() -> bool:\n\treturn state == State.IDLE or state == State.WALK\n\nfunc can_attack() -> bool:\n\treturn state == State.IDLE or state == State.WALK\n\nfunc on_action_complete() -> void:\n\tstate = State.IDLE\n\nfunc on_takeoff_complete() -> void:\n\tif state == State.TAKEOFF:\n\t\tjump_velocity = jump_speed\n\t\tstate = State.JUMP\n\nfunc on_land_complete() -> void:\n\tif state == State.LAND:\n\t\tcharacter_sprite.position.y = grounded_sprite_y\n\t\tstate = State.IDLE\n\nfunc on_receive_damage(received_damage: int, direction: Vector2) -> void:\n\tcurrent_health = clamp(current_health - received_damage, 0, max_health)\n\tif current_health <= 0:\n\t\tqueue_free()\n\telse:\n\t\tjump_height = 0.0\n\t\tjump_velocity = 0.0\n\t\tcharacter_sprite.position.y = grounded_sprite_y\n\t\tstate = State.HURT\n\t\tvelocity = direction * knockback_intensity\n\nfunc on_emit_damage(target_damage_receiver: DamageReceiver) -> void:\n\tvar direction := Vector2.LEFT if target_damage_receiver.global_position.x < global_position.x else Vector2.RIGHT\n\ttarget_damage_receiver.damage_received.emit(damage, direction)","lineStart":1,"lineEnd":123,"totalLines":123,"truncated":false}},"title":"workspace/scenes/characters/character.gd","time":{"start":1790362241001,"end":1790362241043}},"metadata":{"openai":{"itemId":"fc_0155e74a4deb17ee016ab6c27f43648193b0756aca18b9f868"}},"id":"prt_0d9e7c7e30019fsimQf9MMyJJB","sessionID":"ses_f261c4c3fffe2UlZ4DgH7zR1lp","messageID":"msg_0d9e798ab001PrFr1RX9D5nCey"}}
