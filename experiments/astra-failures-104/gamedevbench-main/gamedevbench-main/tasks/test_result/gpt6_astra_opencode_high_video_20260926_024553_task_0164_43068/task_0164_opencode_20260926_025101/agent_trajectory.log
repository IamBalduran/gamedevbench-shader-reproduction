")\n-\t\t\tInput.action_release(\"attack\")\n-\t\tawait RenderingServer.frame_post_draw\n-\t\tif not seen.has(player.state):\n-\t\t\tseen[player.state] = true\n-\t\t\tprint(\"Jump state: \", Character.State.keys()[player.state], \" frame=\", player.character_sprite.frame)\n-\t\t\tif player.state == Character.State.TAKEOFF:\n-\t\t\t\tcheck(player.character_sprite.frame == 61, \"Incorrect takeoff frame\")\n-\t\t\t\tsnapshot(\"takeoff\")\n-\t\t\tif player.state == Character.State.LAND:\n-\t\t\t\tcheck(player.character_sprite.frame == 60, \"Incorrect land frame\")\n-\t\t\t\tcheck(not player.damage_emitter.monitoring, \"Landing enables damage\")\n-\t\t\t\tsnapshot(\"land\")\n-\t\tif player.state == Character.State.JUMP:\n-\t\t\tif player.jump_height > 3.0:\n-\t\t\t\tcheck(player.character_sprite.frame == 62, \"Incorrect airborne frame\")\n-\t\t\tcheck(is_equal_approx(player.character_sprite.position.y, ground_y - player.jump_height), \"Sprite height is incorrect\")\n-\t\t\trose = rose or player.jump_height > previous_height\n-\t\t\tfell = fell or player.jump_height < previous_height\n-\t\t\tif player.jump_height > peak:\n-\t\t\t\tpeak = player.jump_height\n-\t\t\t\tif peak > 16.5:\n-\t\t\t\t\tsnapshot(\"apex\")\n-\t\tprevious_height = player.jump_height\n-\tcheck(seen.has(Character.State.TAKEOFF) and seen.has(Character.State.JUMP) and seen.has(Character.State.LAND), \"Missing jump phase\")\n-\tcheck(not seen.has(Character.State.ATTACK), \"Attack interrupted jump\")\n-\tcheck(rose and fell and peak > 16.0, \"Jump did not rise and fall\")\n-\tcheck(player.state == Character.State.IDLE, \"Jump did not return to idle\")\n-\tcheck(player.character_sprite.position.y == ground_y, \"Jump did not restore grounded sprite position\")\n-\tcheck(player.position.is_equal_approx(start_position), \"Idle jump moved ground position\")\n-\tsnapshot(\"finished\")\n-\tInput.action_press(\"ui_left\")\n-\tawait process_frame\n-\tawait RenderingServer.frame_post_draw\n-\tcheck(player.state == Character.State.WALK, \"Grounded movement failed\")\n-\tawait process_frame\n-\tInput.action_press(\"jump\")\n-\tawait RenderingServer.frame_post_draw\n-\tInput.action_release(\"jump\")\n-\tcheck(player.state == Character.State.TAKEOFF, \"Cannot jump while walking\")\n-\tfor frame in range(65):\n-\t\tawait process_frame\n-\t\tawait RenderingServer.frame_post_draw\n-\tcheck(player.state == Character.State.WALK, \"Held movement did not resume after landing\")\n-\tcheck(player.position.x < start_position.x, \"Walking jump did not move\")\n-\tcheck(player.character_sprite.position.y == ground_y, \"Walking jump did not land\")\n-\tInput.action_release(\"ui_left\")\n-\tawait process_frame\n-\tInput.action_press(\"jump\")\n-\tfor frame in range(15):\n-\t\tawait process_frame\n-\t\tawait RenderingServer.frame_post_draw\n-\tInput.action_release(\"jump\")\n-\tcheck(player.state == Character.State.JUMP, \"Repeat jump failed\")\n-\tplayer.on_receive_damage(1, Vector2.RIGHT)\n-\tcheck(player.state == Character.State.HURT and player.character_sprite.position.y == ground_y, \"Damage left sprite airborne\")\n-\tfor frame in range(30):\n-\t\tawait process_frame\n-\t\tawait RenderingServer.frame_post_draw\n-\tcheck(player.state == Character.State.IDLE, \"Damage recovery failed\")\n-\tprint(\"Jump verification complete: failures=\", failures, \", peak height=\", peak)\n-\tquit(1 if failures else 0)\n\n","files":[{"filePath":"/workspace/.godot/verify_jump.gd","relativePath":"workspace/.godot/verify_jump.gd","type":"delete","patch":"Index: /workspace/.godot/verify_jump.gd\n===================================================================\n--- /workspace/.godot/verify_jump.gd\n+++ /workspace/.godot/verify_jump.gd\n@@ -1,106 +0,0 @@\n-extends SceneTree\n-\n-var failures := 0\n-\n-func check(condition: bool, message: String) -> void:\n-\tif not condition:\n-\t\tpush_error(message)\n-\t\tfailures += 1\n-\n-func snapshot(label: String) -> void:\n-\tvar image := root.get_texture().get_image(