{"type":"tool_use","timestamp":1790453575403,"sessionID":"ses_f20ad0bc2ffeEG6pnTCSfovYdL","part":{"type":"tool","tool":"write","callID":"write:17","state":{"status":"completed","input":{"content":"@tool\nextends EditorPlugin\n\nconst PATH := 0\nconst GRASS := -1\n\n# Tile atlas coords for the 15 path tiles + 1 grass default.\nconst T_G := Vector2i(0, 8)\nconst T_A := Vector2i(2, 4)\nconst T_B := Vector2i(1, 1)\nconst T_C := Vector2i(2, 1)\nconst T_D := Vector2i(3, 1)\nconst T_E := Vector2i(2, 2)\nconst T_F := Vector2i(3, 2)\nconst T_G2 := Vector2i(0, 2)\nconst T_H := Vector2i(1, 2)\nconst T_I := Vector2i(0, 0)\nconst T_J := Vector2i(1, 0)\nconst T_K := Vector2i(2, 0)\nconst T_L := Vector2i(1, 4)\nconst T_M := Vector2i(2, 3)\nconst T_N := Vector2i(3, 3)\nconst T_O := Vector2i(0, 6)\nconst T_P := Vector2i(1, 6)\n\nfunc _set_bits(td: TileData, tl, tr, br, bl) -> void:\n\ttd.set_terrain_peering_bit(TileSet.CELL_NEIGHBOR_TOP_LEFT_CORNER, tl)\n\ttd.set_terrain_peering_bit(TileSet.CELL_NEIGHBOR_TOP_RIGHT_CORNER, tr)\n\ttd.set_terrain_peering_bit(TileSet.CELL_NEIGHBOR_BOTTOM_RIGHT_CORNER, br)\n\ttd.set_terrain_peering_bit(TileSet.CELL_NEIGHBOR_BOTTOM_LEFT_CORNER, bl)\n\nfunc _enter_tree() -> void:\n\tvar ts: TileSet = load(\"res://assets/tile_set.tres\")\n\tif ts == null:\n\t\tpush_error(\"Failed to load tileset\")\n\t\treturn\n\n\t# Create terrain set 0 in Match Corners mode.\n\tts.add_terrain_set(0)\n\tts.set_terrain_set_mode(0, TileSet.TERRAIN_MODE_MATCH_CORNERS)\n\n\t# Single terrain named \"Path\".\n\tts.add_terrain(0)\n\tts.set_terrain_name(0, 0, \"Path\")\n\tts.set_terrain_color(0, 0, Color(0.62, 0.39, 0.22, 1.0))\n\n\tvar source: TileSetAtlasSource = ts.get_source(1)\n\tif source == null:\n\t\tpush_error(\"Source 1 not found\")\n\t\treturn\n\n\t# Grass default (full-grass surroundings).\n\tvar gtd: TileData = source.get_tile_data(T_G, 0)\n\tgtd.terrain = GRASS\n\t_set_bits(gtd, GRASS, GRASS, GRASS, GRASS)\n\n\t# 15 autotile path tiles laid out as 4 columns x 9 rows path patterns.\n\t# Row 1: x..x\n\tvar x_x_ := [\n\t\t[[PATH, PATH, GRASS, GRASS], [PATH, GRASS, GRASS, PATH]],\n\t\t[[PATH, GRASS, GRASS, PATH], [PATH, PATH, GRASS, PATH]],\n\t\t[[PATH, PATH, PATH, PATH], [PATH, PATH, PATH, PATH]],\n\t\t[[GRASS, PATH, GRASS, PATH], [PATH, PATH, PATH, PATH]],\n\t]\n\n\t# Row 2: x..x\n\tvar x2 := [\n\t\t[[PATH, PATH, PATH, PATH], [GRASS, PATH, GRASS, PATH]],\n\t\t[[GRASS, PATH, GRASS, PATH], [GRASS, PATH, PATH, PATH]],\n\t\t[[GRASS, GRASS, GRASS, GRASS], [GRASS, GRASS, GRASS, GRASS]],\n\t\t[[GRASS, PATH, GRASS, PATH], [PATH, PATH, PATH, PATH]],\n\t]\n\n\t# Row 3: x..x\n\tvar x3 := [\n\t\t[[GRASS, PATH, PATH, PATH], [GRASS, PATH, PATH, PATH]],\n\t\t[[PATH, PATH, PATH, PATH], [PATH, PATH, GRASS, PATH]],\n\t\t[[PATH, GRASS, PATH, PATH], [PATH, GRASS, PATH, PATH]],\n\t\t[[PATH, GRASS, GRASS, GRASS], [GRASS, GRASS, GRASS, GRASS]],\n\t]\n\n\t# Row 4: x..x\n\tvar x4 := [\n\t\t[[GRASS, GRASS, PATH, PATH], [PATH, PATH, PATH, PATH]],\n\t\t[[PATH, PATH, GRASS, PATH], [PATH, PATH, GRASS, PATH]],\n\t\t[[PATH, GRASS, GRASS, GRASS], [PATH, GRASS, PATH, GRASS]],\n\t\t[[GRASS, GRASS, GRASS, PATH], [GRASS, PATH, GRASS, GRASS]],\n\t]\n\n\t# Row 5: x..x\n\tvar x5 := [\n\t\t[[GRASS, GRASS, PATH, PATH], [GRASS, GRASS, PATH, PATH]],\n\t\t[[GRASS, GRASS, GRASS, GRASS], [PATH, GRASS, PATH, PATH]],\n\t\t[[GRASS, GRASS, GRASS, GRASS], [PATH, PATH, GRASS, PATH]],\n\t]\n\n\t# Row 6: x..x\n\tvar x6 := [\n\t\t[[GRASS, GRASS, GRASS, PATH], [GRASS, GRASS, GRASS, GRASS]],\n\t\t[[GRASS, GRASS, GRASS, PATH], [GRASS, GRASS, GRASS, GRASS]],\n\t]\n\n\t# Apply to tiles.\n\tvar rows := [x_x_, x2, x3, x4, x5, x6]\n\tfor r in range(rows.size()):\n\t\tfor c in range(rows[r].size()):\n\t\t\tvar coords = Vector2i(c, 8 - (r * 2) if r == 0 else 8 - (r * 2) + (c > 1 ? 1 : 0))\n\t\t\t# manual mapping below instead\n\t\t\tpass\n\n\t# Manual mapping to atlas coords.\n\tvar entries := [\n\t\t[T_G2, 0, 0, 0, 0],     # 0:2\n\t\t[T_H, 0, 0, 0, 0],      # 1:2\n\t\t[T_I, 1, 1, 1, 1],      # 0:0\n\t\t[T_J, 0, 0, 0, 0],      # 1:0\n\t\t[T_K, 1, 1, 0, 0],      # 2:0\n\t\t[T_A, 0, 1, 0, 1],      # 2:4\n\t\t[T_B, 0, 0, 0, 1],      # 1:1\n\t\t[T_C, 0, 0, 0, 0],      # 2:1\n\t\t[T_D, 1, 0, 1, 1],      # 3:1\n\t\t[T_E, 0, 0, 1, 1],      # 2:2\n\t\t[T_F, 0, 1, 1, 1],      # 3:2\n\t\t[T_L, 1, 1, 1, 1],      # 1:4\n\t\t[T_M, 1, 0, 0, 0],      # 2:3\n\t\t[T_N, 1, 1, 1, 0],      # 3:3\n\t\t[T_O, 1, 1, 0, 1],      # 0:6\n\t\t[T_P, 1, 0, 0, 1],      # 1:6\n\t]\n\n\tfor e in entries:\n\t\tvar td: TileData = source.get_tile_data(e[0], 0)\n\t\ttd.terrain = PATH\n\t\t_set_bits(td, e[1], e[2], e[3], e[4])\n\n\tvar err := ResourceSaver.save(ts, \"res://assets/tile_set.tres\")\n\tif err != OK:\n\t\tpush_error(\"Save failed: %s\" % err)\n\telse:\n\t\tprint(\"TileSet terrain configured and saved.\")\n","filePath":"/tmp/opencode/terrain_plugin/plugin.gd"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/tmp/opencode/terrain_plugin/plugin.gd","exists":false,"truncated":false},"title":"tmp/opencode/terrain_plugin/plugin.gd","time":{"start":1790453575387,"end":1790453575394}},"metadata":{"openai":{"itemId":"fc_write:17"}},"id":"prt_0df596ed8001X3XdAAAcUk32HF","sessionID":"ses_f20ad0bc2ffeEG6pnTCSfovYdL","messageID":"msg_0df59463700167urjLgYveZmt2"}}
