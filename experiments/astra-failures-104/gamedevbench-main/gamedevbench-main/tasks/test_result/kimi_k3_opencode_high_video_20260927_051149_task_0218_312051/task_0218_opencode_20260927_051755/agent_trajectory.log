          for dx, dy in ((1,0),(-1,0),(0,1),(0,-1)):\n                nx, ny = cx+dx, cy+dy\n                if 0 <= nx < w and 0 <= ny < h and not visited[ny][nx]:\n                    visited[ny][nx] = True\n                    if is_yellow(px[nx, ny]):\n                        q.append((nx, ny))\n        if len(pts) >= 20:\n            components.append(pts)\n\nprint('components:', len(components))\nfor pts in components:\n    xs = [p[0] for p in pts]; ys = [p[1] for p in pts]\n    cx = sum(xs)/len(xs); cy = sum(ys)/len(ys)\n    r = 0\n    for p in pts:\n        d = ((p[0]-cx)**2 + (p[1]-cy)**2) ** 0.5\n        if d > r: r = d\n    print('size', len(pts), 'bbox', min(xs), max(xs), min(ys), max(ys), 'center %.1f %.1f' % (cx, cy), 'maxr %.1f' % r)\nEOF","time":{"start":1790457189609,"end":1790457190081}},"metadata":{"openai":{"itemId":"fc_bash_10_f29d3b79"}},"id":"prt_0df9094e3001AKj1Cny8u8znck","sessionID":"ses_f2070685effefEpuTFT03QNrhy","messageID":"msg_0df905a71001GksZHKUMNAq5Rl"}}
