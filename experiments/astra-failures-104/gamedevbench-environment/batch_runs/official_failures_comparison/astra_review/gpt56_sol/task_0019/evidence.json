  "solver_diff": "--- original/scenes/effects/muzzle_flash_effect.tscn\n+++ solver/scenes/effects/muzzle_flash_effect.tscn\n@@ -1,3 +1,104 @@\n-[gd_scene format=3 uid=\"uid://task0620_start_effect\"]\n+[gd_scene load_steps=12 format=3 uid=\"uid://task0620_start_effect\"]\n+\n+[ext_resource type=\"Script\" path=\"res://scripts/generic_effect_handler.gd\" id=\"1_handler\"]\n+[ext_resource type=\"Shader\" path=\"res://assets/shaders/muzzle_flash.gdshader\" id=\"2_muzzle_shader\"]\n+\n+[sub_resource type=\"Gradient\" id=\"Gradient_smoke\"]\n+colors = PackedColorArray(0.18, 0.2, 0.22, 0.72, 0.35, 0.38, 0.4, 0.0)\n+\n+[sub_resource type=\"GradientTexture2D\" id=\"GradientTexture2D_smoke\"]\n+gradient = SubResource(\"Gradient_smoke\")\n+width = 64\n+height = 64\n+fill = 1\n+fill_from = Vector2(0.5, 0.5)\n+fill_to = Vector2(1, 0.5)\n+\n+[sub_resource type=\"StandardMaterial3D\" id=\"StandardMaterial3D_smoke\"]\n+transparency = 1\n+shading_mode = 0\n+cull_mode = 2\n+billboard_mode = 3\n+billboard_keep_scale = true\n+albedo_texture = SubResource(\"GradientTexture2D_smoke\")\n+\n+[sub_resource type=\"QuadMesh\" id=\"QuadMesh_smoke\"]\n+material = SubResource(\"StandardMaterial3D_smoke\")\n+size = Vector2(1.1, 1.1)\n+orientation = 2\n+\n+[sub_resource type=\"ParticleProcessMaterial\" id=\"ParticleProcessMaterial_smoke\"]\n+direction = Vector3(0, 1, 0)\n+spread = 35.0\n+initial_velocity_min = 0.35\n+initial_velocity_max = 0.65\n+gravity = Vector3(0, 0, 0)\n+scale_min = 0.55\n+scale_max = 0.9\n+color = Color(0.8, 0.82, 0.84, 0.9)\n+\n+[sub_resource type=\"ShaderMaterial\" id=\"ShaderMaterial_muzzle\"]\n+shader = ExtResource(\"2_muzzle_shader\")\n+shader_parameter/flash_color = Color(1, 0.34, 0.035, 1)\n+shader_parameter/falloff_power = 1.35\n+\n+[sub_resource type=\"QuadMesh\" id=\"QuadMesh_fire\"]\n+material = SubResource(\"ShaderMaterial_muzzle\")\n+size = Vector2(1.45, 0.62)\n+orientation = 2\n+\n+[sub_resource type=\"ParticleProcessMaterial\" id=\"ParticleProcessMaterial_fire_left\"]\n+direction = Vector3(-1, 0, 0)\n+spread = 8.0\n+initial_velocity_min = 2.2\n+initial_velocity_max = 2.2\n+gravity = Vector3(0, 0, 0)\n+scale_min = 0.9\n+scale_max = 1.0\n+\n+[sub_resource type=\"ParticleProcessMaterial\" id=\"ParticleProcessMaterial_fire_right\"]\n+direction = Vector3(1, 0, 0)\n+spread = 8.0\n+initial_velocity_min = 2.2\n+initial_velocity_max = 2.2\n+gravity = Vector3(0, 0, 0)\n+scale_min = 0.9\n+scale_max = 1.0\n \n [node name=\"MuzzleFlashEffect\" type=\"Node3D\"]\n+script = ExtResource(\"1_handler\")\n+optional_light_path = NodePath(\"MuzzleFlash\")\n+light_duration = 0.2\n+\n+[node name=\"MuzzleFlash\" type=\"OmniLight3D\" parent=\".\"]\n+light_color = Color(1, 0.45, 0.08, 1)\n+light_energy = 5.0\n+omni_range = 4.0\n+shadow_enabled = true\n+\n+[node name=\"SmokeParticles\" type=\"GPUParticles3D\" parent=\".\"]\n+amount = 8\n+lifetime = 0.35\n+one_shot = true\n+explosiveness = 0.85\n+randomness = 0.25\n+process_material = SubResource(\"ParticleProcessMaterial_smoke\")\n+draw_pass_1 = SubResource(\"QuadMesh_smoke\")\n+\n+[node name=\"MuzzleFireLeft\" type=\"GPUParticles3D\" parent=\".\"]\n+position = Vector3(-0.18, 0, 0)\n+amount = 1\n+lifetime = 0.2\n+one_shot = true\n+explosiveness = 1.0\n+process_material = SubResource(\"ParticleProcessMaterial_fire_left\")\n+draw_pass_1 = SubResource(\"QuadMesh_fire\")\n+\n+[node name=\"MuzzleFireRight\" type=\"GPUParticles3D\" parent=\".\"]\n+position = Vector3(0.18, 0, 0)\n+amount = 1\n+lifetime = 0.2\n+one_shot = true\n+explosiveness = 1.0\n+process_material = SubResource(\"ParticleProcessMaterial_fire_right\")\n+draw_pass_1 = SubResource(\"QuadMesh_fire\")\n",
