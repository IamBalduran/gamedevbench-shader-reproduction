{"type":"tool_use","timestamp":1790319787681,"sessionID":"ses_f28a3c12fffePHeHn1dG1kE4v3","part":{"type":"tool","tool":"write","callID":"write_19_ef56dc1e","state":{"status":"completed","input":{"content":"shader_type spatial;\n\nuniform sampler2D subview_image: source_color;\nuniform float threshold = 0.1;\nuniform float aa_scale = 17.6;\nuniform float base_line_thickness = 0.38197;\n\n// Blend between two colors along the diagonal that runs between the two\n// opposite corners of a texel (tx, ty = -1 / +1). Used to smooth the\n// borders between neighboring texels whose colors differ beyond the\n// threshold, mimicking the diagonal smoothing applied by HQX filters.\nvec3 blend_diag(vec3 col, vec3 ref, vec2 uv, int tx, int ty, ivec2 ts, float tt) {\n\tvec2 texel = vec2(tx, ty);\n\t// Position of the current pixel inside the texel, in [-1, 1] x [-1, 1].\n\tvec2 fp = clamp(tt * (uv * vec2(ts) - 0.5) - (fract(uv * vec2(ts)) - 0.5) - texel, -1.0, 1.0);\n\t// Distance from the line that joins the two texel corners.\n\tfloat d = abs(fp.x * float(ty) - fp.y * float(tx)) / sqrt(2.0);\n\tfloat t = clamp(d + float(base_line_thickness), 0.0, 1.0);\n\treturn mix(ref, col, t);\n}\n\nvoid fragment() {\n\tivec2 ts = textureSize(subview_image, 0);\n\t// Texel-space position of the current pixel (bottom-left origin) and\n\t// the texel that contains it. The texel is sampled with texelFetch.\n\tvec2 tp = UV * vec2(ts) - 0.5;\n\ttp.y = float(ts.y) - 1.0 - tp.y;\n\tivec2 base = ivec2(floor(tp));\n\n\tvec4 ccv = texelFetch(subview_image, base, 0);\n\tvec3 cc = ccv.rgb; // center\n\tvec3 cf = texelFetch(subview_image, base + ivec2(0, 1), 0).rgb;  // north\n\tvec3 cw = texelFetch(subview_image, base + ivec2(1, 0), 0).rgb;  // east\n\tvec3 cz = texelFetch(subview_image, base + ivec2(-1, 0), 0).rgb; // west\n\tvec3 cp = texelFetch(subview_image, base + ivec2(0, -1), 0).rgb; // south\n\n\tfloat tt = abs(float(ts.x) - float(ts.y)) + max(float(ts.x), float(ts.y));\n\n\tvec3 color = cc;\n\t// HQX-style border smoothing: for every pair of opposite neighbors that\n\t// both differ from the center, blend the center and the neighbor along\n\t// the diagonal between the two corners shared with the neighbor.\n\tif (distance(cc, cf) > threshold && distance(cc, cp) > threshold)\n\t\tcolor = blend_diag(color, mix(cf, cp, 0.5), UV, 0, 1, ts, tt);\n\tif (distance(cc, cw) > threshold && distance(cc, cz) > threshold)\n\t\tcolor = blend_diag(color, mix(cw, cz, 0.5), UV, 1, 0, ts, tt);\n\n\tALBEDO = color;\n}\n","filePath":"/workspace/assets/shaders/map3d.gdshader"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/assets/shaders/map3d.gdshader","exists":true,"truncated":false},"title":"workspace/assets/shaders/map3d.gdshader","time":{"start":1790319787646,"end":1790319787659}},"metadata":{"openai":{"itemId":"fc_write_19_ef56dc1e"}},"id":"prt_0d75ffe79001U9uNgOq0E28zU6","sessionID":"ses_f28a3c12fffePHeHn1dG1kE4v3","messageID":"msg_0d75f7426001Mkl3j4kXo4gxgS"}}
