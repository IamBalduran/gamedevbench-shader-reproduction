 = step(0.0, warped_uv.x) * step(warped_uv.x, 1.0);\n\tcutoff *= step(0.0, warped_uv.y) * step(warped_uv.y, 1.0);\n\n\tvec3 screen_color = textureLod(screen_texture, warped_uv, 0.5).rgb;\n\tfloat scanline = 0.95 + 0.05 * sin(warped_uv.y / SCREEN_PIXEL_SIZE.y * 3.14159265);\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/screen_effect/screen_effect.gdshader","text":"shader_type canvas_item;\nrender_mode unshaded, skip_vertex_transform;\n\nconst float curvature = 7.0;\nconst float vignette_multiplier = 2.0;\n\nuniform sampler2D screen_texture : hint_screen_texture, filter_linear_mipmap;\n\nvoid fragment() {\n\tvec2 centered_uv = SCREEN_UV * 2.0 - 1.0;\n\tvec2 curve_offset = abs(centered_uv.yx) / curvature;\n\tcentered_uv += centered_uv * curve_offset * curve_offset;\n\tvec2 warped_uv = centered_uv * 0.5 + 0.5;\n\n\tfloat cutoff = step(0.0, warped_uv.x) * step(warped_uv.x, 1.0);\n\tcutoff *= step(0.0, warped_uv.y) * step(warped_uv.y, 1.0);\n\n\tvec3 screen_color = textureLod(screen_texture, warped_uv, 0.5).rgb;\n\tfloat scanline = 0.95 + 0.05 * sin(warped_uv.y / SCREEN_PIXEL_SIZE.y * 3.14159265);\n\n\tfloat vignette = warped_uv.x * warped_uv.y;\n\tvignette *= (1.0 - warped_uv.x) * (1.0 - warped_uv.y);\n\tvignette = clamp(pow(16.0 * vignette, vignette_multiplier), 0.0, 1.0);\n\n\tCOLOR = vec4(screen_color * scanline * vignette * cutoff, 1.0);\n}","lineStart":1,"lineEnd":26,"totalLines":26,"truncated":false}},"title":"workspace/screen_effect/screen_effect.gdshader","time":{"start":1790258444607,"end":1790258444642}},"metadata":{"openai":{"itemId":"fc_0d23eb2bf28409d3016ab52d0a38e88190b2f608072cc1f52c"}},"id":"prt_0d3b7f939001xwCJVb3IhsP0wn","sessionID":"ses_f2c4a384dffeAPyOTrw7ogl5fG","messageID":"msg_0d3b7d56e001e8eE7eVsvJXrKf"}}
