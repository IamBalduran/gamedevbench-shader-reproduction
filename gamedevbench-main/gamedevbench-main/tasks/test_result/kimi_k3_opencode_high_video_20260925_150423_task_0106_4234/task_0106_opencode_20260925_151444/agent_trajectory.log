{"type":"tool_use","timestamp":1790320144986,"sessionID":"ses_f289e9e76ffe8y2UrzbefJ8vF9","part":{"type":"tool","tool":"write","callID":"write_10_d52db401","state":{"status":"completed","input":{"content":"#[compute]\n#version 450\n\nlayout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;\n\n// Parameters sent from the CPU. Written with buffer_update().\nlayout(set = 0, binding = 0, std430) readonly buffer Params {\n\tmat4 inv_proj_mat;\n\tvec2 screen_size;\n\tfloat sample_size;\n\tfloat depth_threshold;\n\tfloat normal_threshold;\n\tvec4 outline_color;\n}\nparams;\n\n// The scene color attachment, read and written in place.\nlayout(rgba16f, set = 0, binding = 1) uniform image2D color_image;\n\n// The scene depth texture.\nlayout(set = 0, binding = 2) uniform sampler2D depth_texture;\n\n// Reconstructs a linear (view space) depth from the raw 0..1 depth buffer value.\nfloat get_linear_depth(vec2 uv) {\n\tfloat raw_depth = texture(depth_texture, uv).r;\n\tvec3 ndc = vec3(uv * 2.0 - 1.0, raw_depth);\n\tvec4 view = params.inv_proj_mat * vec4(ndc, 1.0);\n\tview.xyz /= view.w;\n\treturn -view.z;\n}\n\n// Reconstructs a view-space normal from depth for a given texel.\nvec3 get_normal(ivec2 uv) {\n\tvec2 texel_size = 1.0 / params.screen_size;\n\tvec2 uv1 = (vec2(uv) + vec2(0.0, 0.0)) * texel_size;\n\tvec2 uv2 = (vec2(uv) + vec2(1.0, 0.0)) * texel_size;\n\tvec2 uv3 = (vec2(uv) + vec2(0.0, 1.0)) * texel_size;\n\n\tfloat d1 = get_linear_depth(uv1);\n\tfloat d2 = get_linear_depth(uv2);\n\tfloat d3 = get_linear_depth(uv3);\n\n\tvec3 p1 = vec3(uv1 * 2.0 - 1.0, 0.0);\n\tvec3 p2 = vec3(uv2 * 2.0 - 1.0, 0.0);\n\tvec3 p3 = vec3(uv3 * 2.0 - 1.0, 0.0);\n\n\tvec4 v1 = params.inv_proj_mat * vec4(p1.xy, texture(depth_texture, uv1).r, 1.0);\n\tvec4 v2 = params.inv_proj_mat * vec4(p2.xy, texture(depth_texture, uv2).r, 1.0);\n\tvec4 v3 = params.inv_proj_mat * vec4(p3.xy, texture(depth_texture, uv3).r, 1.0);\n\n\tvec3 pos1 = v1.xyz / v1.w;\n\tvec3 pos2 = v2.xyz / v2.w;\n\tvec3 pos3 = v3.xyz / v3.w;\n\n\treturn normalize(cross(pos2 - pos1, pos3 - pos1));\n}\n\nvoid main() {\n\tivec2 uv = ivec2(gl_GlobalInvocationID.xy);\n\tivec2 size = ivec2(params.screen_size);\n\n\tif (uv.x >= size.x || uv.y >= size.y) {\n\t\treturn;\n\t}\n\n\tvec2 texel_size = 1.0 / params.screen_size;\n\tvec2 uv_center = (vec2(uv) + vec2(0.5)) * texel_size;\n\n\tfloat depth = get_linear_depth(uv_center);\n\tvec3 normal = get_normal(uv);\n\n\tfloat depth_diff = 0.0;\n\tfloat normal_diff = 1.0;\n\n\t// Compare against neighboring depths within the sample_size radius.\n\tint radius = max(int(params.sample_size), 1);\n\tfor (int x = -radius; x <= radius; x++) {\n\t\tfor (int y = -radius; y <= radius; y++) {\n\t\t\tif (x == 0 && y == 0) {\n\t\t\t\tcontinue;\n\t\t\t}\n\t\t\tivec2 offset = ivec2(x, y);\n\t\t\tivec2 suv = uv + offset;\n\t\t\tif (suv.x < 0 || suv.y < 0 || suv.x >= size.x || suv.y >= size.y) {\n\t\t\t\tcontinue;\n\t\t\t}\n\t\t\tvec2 nuv = (vec2(suv) + vec2(0.5)) * texel_size;\n\t\t\tfloat neighbor_depth = get_linear_depth(nuv);\n\t\t\tdepth_diff += clamp(neighbor_depth - depth, 0.0, 1.0);\n\n\t\t\tvec3 neighbor_normal = get_normal(suv);\n\t\t\tnormal_diff = min(normal_diff, dot(normal, neighbor_normal));\n\t\t}\n\t}\n\n\tvec4 color = imageLoad(color_image, uv);\n\n\tfloat depth_edge = depth_diff > params.depth_threshold ? 1.0 : 0.0;\n\tfloat normal_edge = (1.0 - normal_diff) > params.normal_threshold ? 1.0 : 0.0;\n\tfloat edge = max(depth_edge, normal_edge);\n\n\t// Ignore edges on the skybox (infinitely far depth).\n\tif (depth > 1e6) {\n\t\tedge = 0.0;\n\t}\n\n\tcolor.rgb = mix(color.rgb, params.outline_color.rgb, edge * params.outline_color.a);\n\n\t// Write the outlined color back to the color attachment.\n\timageStore(color_image, uv, color);\n}\n","filePath":"/workspace/outline.glsl"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/outline.glsl","exists":true,"truncated":false},"title":"workspace/outline.glsl","time":{"st