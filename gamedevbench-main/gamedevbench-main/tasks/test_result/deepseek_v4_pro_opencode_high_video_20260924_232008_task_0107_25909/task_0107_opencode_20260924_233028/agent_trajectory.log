ce_set_material(i, shader_mat)\n38: \n39: \tfor child in node.get_children():\n40: \t\t_apply_shader_recursive(child, shader, fov_value)\n\n(End of file - total 40 lines)\n</content>","metadata":{"preview":"extends Node3D\n\n@onready var view_model_container: Node3D = $ViewModel\n\nfunc _ready() -> void:\n\tapply_clip_and_fov_shader_to_view_model(view_model_container, 54.0)\n\nfunc apply_clip_and_fov_shader_to_view_model(node3d: Node3D, fov_or_negative_for_unchanged := -1.0) -> void:\n\tif node3d == null:\n\t\treturn\n\n\tvar shader: Shader = load(\"res://shaders/weapon_clip_and_fov_shader.gdshader\")\n\tif shader == null:\n\t\treturn\n\n\tvar fov_value: float = 54.0\n\tif fov_or_negative_for_unchanged >= 0.0:\n\t\tfov_value = fov_or_negative_for_unchanged\n\n\t_apply_shader_recursive(node3d, shader, fov_value)","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/scripts/weapon_manager.gd","text":"extends Node3D\n\n@onready var view_model_container: Node3D = $ViewModel\n\nfunc _ready() -> void:\n\tapply_clip_and_fov_shader_to_view_model(view_model_container, 54.0)\n\nfunc apply_clip_and_fov_shader_to_view_model(node3d: Node3D, fov_or_negative_for_unchanged := -1.0) -> void:\n\tif node3d == null:\n\t\treturn\n\n\tvar shader: Shader = load(\"res://shaders/weapon_clip_and_fov_shader.gdshader\")\n\tif shader == null:\n\t\treturn\n\n\tvar fov_value: float = 54.0\n\tif fov_or_negative_for_unchanged >= 0.0:\n\t\tfov_value = fov_or_negative_for_unchanged\n\n\t_apply_shader_recursive(node3d, shader, fov_value)\n\nfunc _apply_shader_recursive(node: Node, shader: Shader, fov_value: float) -> void:\n\tif node is MeshInstance3D:\n\t\tvar mesh_instance: MeshInstance3D = node as MeshInstance3D\n\t\tvar mesh: Mesh = mesh_instance.mesh\n\t\tif mesh:\n\t\t\tfor i in mesh.get_surface_count():\n\t\t\t\tvar material: Material = mesh.surface_get_material(i)\n\t\t\t\tif material != null and material is StandardMaterial3D:\n\t\t\t\t\tvar base_mat: StandardMaterial3D = material as StandardMaterial3D\n\t\t\t\t\tvar shader_mat := ShaderMaterial.new()\n\t\t\t\t\tshader_mat.shader = shader\n\t\t\t\t\tshader_mat.set_shader_parameter(\"albedo\", base_mat.albedo_color)\n\t\t\t\t\tshader_mat.set_shader_parameter(\"metallic\", base_mat.metallic)\n\t\t\t\t\tshader_mat.set_shader_parameter(\"roughness\", base_mat.roughness)\n\t\t\t\t\tshader_mat.set_shader_parameter(\"viewmodel_fov\", fov_value)\n\t\t\t\t\tmesh.surface_set_material(i, shader_mat)\n\n\tfor child in node.get_children():\n\t\t_apply_shader_recursive(child, shader, fov_value)","lineStart":1,"lineEnd":40,"totalLines":40,"truncated":false}},"title":"workspace/scripts/weapon_manager.gd","time":{"start":1790263574108,"end":1790263574114}},"metadata":{"openai":{"itemId":"msg_2ed53bf9-1ca9-488b-b27b-47197348cf32"}},"id":"prt_0d4063e58001xfQ5uYKD0Kr6k0","sessionID":"ses_f2bff1df3ffem83Fc7tRT81gko","messageID":"msg_0d405c5fb001VrBRbcc38pLktK"}}
