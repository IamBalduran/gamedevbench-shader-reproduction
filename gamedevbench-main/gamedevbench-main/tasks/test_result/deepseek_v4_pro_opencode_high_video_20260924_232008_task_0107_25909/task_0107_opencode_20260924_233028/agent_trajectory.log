t_shader_parameter(\"texture_metallic\", _default_white_texture)\n\t\t\t\t\tshader_mat.set_shader_parameter(\"texture_roughness\", _default_white_texture)\n\t\t\t\t\tshader_mat.set_shader_parameter(\"texture_normal\", _default_normal_texture)\n\t\t\t\t\tmesh.surface_set_material(i, shader_mat)\n\n\tfor child in node.get_children():\n\t\t_apply_shader_recursive(child, shader, fov_value)","lineStart":1,"lineEnd":56,"totalLines":56,"truncated":false}},"title":"workspace/scripts/weapon_manager.gd","time":{"start":1790263629810,"end":1790263629818}},"metadata":{"openai":{"itemId":"msg_5c866642-271e-452e-906e-e92257f30bf9"}},"id":"prt_0d40717f0001Sz3NE1SYneRkC4","sessionID":"ses_f2bff1df3ffem83Fc7tRT81gko","messageID":"msg_0d406e911001in15pJyBnFYY54"}}
