{"type":"tool_use","timestamp":1790319821719,"sessionID":"ses_f28a829c6ffeqr8YpwUp5rVdxl","part":{"type":"tool","tool":"write","callID":"write_16_fc8baa93","state":{"status":"completed","input":{"content":"@tool\nextends EditorScript\n\nfunc _fail(msg: String) -> void:\n\tpush_error(msg)\n\tget_scene().quit(1)\n\nfunc _run() -> void:\n\t# --- 1. Build the VisualShader ---\n\tvar distortion_script: Script = load(\"res://addons/shaderV/uv/distortionUV.gd\")\n\n\tvar vs := VisualShader.new()\n\tvs.resource_name = \"DistortionUVVisualShader\"\n\n\t# Find the fragment output node (VisualShader creates one by default).\n\tvar output_id := -1\n\tfor id in vs.get_node_list(VisualShader.TYPE_FRAGMENT):\n\t\tif vs.get_node(VisualShader.TYPE_FRAGMENT, id) is VisualShaderNodeOutput:\n\t\t\toutput_id = id\n\t\t\tbreak\n\tif output_id == -1:\n\t\t_fail(\"No fragment output node found in VisualShader\")\n\t\treturn\n\n\t# --- 2. Add the custom DistortionUV node ---\n\tvar dist_node: VisualShaderNodeCustom = distortion_script.new()\n\tvar dist_id := vs.get_valid_node_id(VisualShader.TYPE_FRAGMENT)\n\tvs.add_node(VisualShader.TYPE_FRAGMENT, dist_node, Vector2(-420.0, 0.0), dist_id)\n\n\t# --- 3. Input port default values (example constants) ---\n\t# ports: 0=uv, 1=waveX, 2=waveY, 3=distortX, 4=distortY\n\tdist_node.set_input_port_default_value(1, 7.0)\n\tdist_node.set_input_port_default_value(2, 5.0)\n\tdist_node.set_input_port_default_value(3, 0.1)\n\tdist_node.set_input_port_default_value(4, 0.1)\n\n\t# --- 4. Connect distorted UV output to the fragment UV input (port 2) ---\n\tvar err := vs.connect_nodes(VisualShader.TYPE_FRAGMENT, dist_id, 0, output_id, 2)\n\tif err != OK:\n\t\t_fail(\"Failed to connect DistortionUV output to fragment UV (err %d)\" % err)\n\t\treturn\n\n\t# --- 5. Wrap in ShaderMaterial ---\n\tvar mat := ShaderMaterial.new()\n\tmat.resource_name = \"DistortionUVShaderMaterial\"\n\tmat.shader = vs\n\n\t# --- 6. Load scene, ensure TextureRect, assign texture + material ---\n\tvar packed: PackedScene = load(\"res://scenes/main.tscn\")\n\tvar root: Control = packed.instantiate()\n\n\tvar tr: TextureRect = root.get_node_or_null(\"DistortionPreview\")\n\tif tr == null:\n\t\ttr = TextureRect.new()\n\t\ttr.name = \"DistortionPreview\"\n\t\troot.add_child(tr)\n\t\ttr.owner = root\n\n\ttr.texture = load(\"res://addons/shaderV/shaderV_icon.png\")\n\ttr.size = Vector2(512.0, 512.0)\n\ttr.expand_mode = TextureRect.EXPAND_IGNORE_SIZE\n\ttr.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_COVERED\n\ttr.material = mat\n\n\tvar new_scene := PackedScene.new()\n\tif new_scene.pack(root) != OK:\n\t\t_fail(\"Failed to pack scene\")\n\t\treturn\n\tif ResourceSaver.save(new_scene, \"res://scenes/main.tscn\") != OK:\n\t\t_fail(\"Failed to save scene\")\n\t\treturn\n\n\tprint(\"BUILD_OK: scene saved with DistortionUV VisualShader material\")\n\tget_scene().quit(0)\n","filePath":"/workspace/build_shader.gd"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/build_shader.gd","exists":true,"truncated":false},"title":"workspace/build_shader.gd","time":{"start":1790319821704,"end":1790319821709}},"metadata":{"openai":{"itemId":"fc_write_16_fc8baa93"}},"id":"prt_0d7608386001HgMLMuEFTkXogW","sessionID":"ses_f28a829c6ffeqr8YpwUp5rVdxl","messageID":"msg_0d760164c0013MJOBoOqygzeGH"}}
