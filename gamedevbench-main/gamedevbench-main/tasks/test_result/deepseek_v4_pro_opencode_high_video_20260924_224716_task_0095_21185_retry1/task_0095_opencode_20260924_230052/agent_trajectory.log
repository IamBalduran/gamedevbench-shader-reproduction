tte = 1.0 - dist;\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/screen_effect/screen_effect.gdshader","text":"shader_type canvas_item;\nrender_mode unshaded, skip_vertex_transform;\n\nconst float CURVATURE = 7.0;\nconst float VIGNETTE_MULTIPLIER = 2.0;\n\nuniform sampler2D screen_texture : hint_screen_texture, filter_linear_mipmap;\n\nvoid fragment() {\n    vec2 centered_uv = SCREEN_UV - 0.5;\n    vec2 warped = centered_uv * (1.0 + dot(centered_uv, centered_uv) / CURVATURE);\n    vec2 uv = warped + 0.5;\n\n    float cutoff = step(0.0, uv.x) * step(uv.x, 1.0) * step(0.0, uv.y) * step(uv.y, 1.0);\n\n    float scanline = 0.85 + 0.15 * sin(SCREEN_UV.y * 720.0 * 3.14159);\n\n    float dist = dot(centered_uv, centered_uv) * VIGNETTE_MULTIPLIER;\n    float vignette = 1.0 - dist;\n\n    vec3 color = textureLod(screen_texture, uv, 0.5).rgb;\n    color *= scanline * vignette * cutoff;\n\n    COLOR = vec4(color, 1.0);\n}","lineStart":1,"lineEnd":25,"totalLines":25,"truncated":false}},"title":"workspace/screen_effect/screen_effect.gdshader","time":{"start":1790261936671,"end":1790261936680}},"metadata":{"openai":{"itemId":"msg_2d449bdb-0121-4000-a88c-9f36459b882d"}},"id":"prt_0d3ed42180015HXgPcDnC6vp2J","sessionID":"ses_f2c141211ffeD0EX6vQV65A8Wy","messageID":"msg_0d3ed167e001JzpaSHO7qXY94D"}}
