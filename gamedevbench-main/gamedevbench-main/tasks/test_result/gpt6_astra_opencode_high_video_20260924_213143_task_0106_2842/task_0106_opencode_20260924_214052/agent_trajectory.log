: \tif scene_data == null:\n51: \t\treturn\n52: \n53: \tvar inv_projection: Projection = scene_data.get_cam_projection().inverse()\n54: \tvar params := PackedFloat32Array([\n55: \t\tinv_projection.x.x, inv_projection.x.y, inv_projection.x.z, inv_projection.x.w,\n56: \t\tinv_projection.y.x, inv_projection.y.y, inv_projection.y.z, inv_projection.y.w,\n57: \t\tinv_projection.z.x, inv_projection.z.y, inv_projection.z.z, inv_projection.z.w,\n58: \t\tinv_projection.w.x, inv_projection.w.y, inv_projection.w.z, inv_projection.w.w,\n59: \t\tfloat(internal_size.x), float(internal_size.y),\n60: \t\t2.0, 0.0025,\n61: \t\t1.0, 0.15, 0.03, 1.0,\n62: \t])\n63: \trd.buffer_update(params_buffer, 0, params.size() * 4, params.to_byte_array())\n64: \n65: \tvar params_uniform := RDUniform.new()\n66: \tparams_uniform.uniform_type = RenderingDevice.UNIFORM_TYPE_STORAGE_BUFFER\n67: \tparams_uniform.binding = 0\n68: \tparams_uniform.add_id(params_buffer)\n69: \n70: \tvar color_uniform := RDUniform.new()\n71: \tcolor_uniform.uniform_type = RenderingDevice.UNIFORM_TYPE_IMAGE\n72: \tcolor_uniform.binding = 1\n73: \tcolor_uniform.add_id(color_image)\n74: \n75: \tvar depth_uniform := RDUniform.new()\n76: \tdepth_uniform.uniform_type = RenderingDevice.UNIFORM_TYPE_SAMPLER_WITH_TEXTURE\n77: \tdepth_uniform.binding = 2\n78: \tdepth_uniform.add_id(depth_sampler)\n79: \tdepth_uniform.add_id(depth_texture)\n80: \n81: \tif uniform_set.is_valid():\n82: \t\trd.free_rid(uniform_set)\n83: \tuniform_set = rd.uniform_set_create([params_uniform, color_uniform, depth_uniform], shader, 0)\n84: \tif not uniform_set.is_valid():\n85: \t\treturn\n86: \n87: \tvar groups_x := ceili(float(internal_size.x) / WORKGROUP_SIZE)\n88: \tvar groups_y := ceili(float(internal_size.y) / WORKGROUP_SIZE)\n89: \tvar compute_list := rd.compute_list_begin()\n90: \trd.compute_list_bind_compute_pipeline(compute_list, pipeline)\n91: \trd.compute_list_bind_uniform_set(compute_list, uniform_set, 0)\n92: \trd.compute_list_dispatch(compute_list, groups_x, groups_y, 1)\n93: \trd.compute_list_end()\n\n(End of file - total 93 lines)\n</content>","metadata":{"preview":"@tool\nextends CompositorEffect\nclass_name OutlineEffect\n\nconst WORKGROUP_SIZE := 8\nconst PARAMETER_SIZE := 96\n\nvar rd: RenderingDevice\nvar shader: RID\nvar pipeline: RID\nvar params_buffer: RID\nvar depth_sampler: RID\nvar uniform_set: RID\n\nfunc _init() -> void:\n\trd = RenderingServer.get_rendering_device()\n\tif rd == null:\n\t\treturn\n\n\tvar shader_file := load(\"res://outline.glsl\") as RDShaderFile","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/scripts/outline_effect.gd","text":"@tool\nextends CompositorEffect\nclass_name OutlineEffect\n\nconst WORKGROUP_SIZE := 8\nconst PARAMETER_SIZE := 96\n\nvar rd: RenderingDevice\nvar shader: RID\nvar pipeline: RID\nvar params_buffer: RID\nvar depth_sampler: RID\nvar uniform_set: RID\n\nfunc _init() -> void:\n\trd = RenderingServer.get_rendering_device()\n\tif rd == null:\n\t\treturn\n\n\tvar shader_file := load(\"res://outline.glsl\") as RDShaderFile\n\tif shader_file == null:\n\t\treturn\n\n\tshader = rd.shader_create_from_spirv(shader_file.get_spirv())\n\tif not shader.is_valid():\n\t\treturn\n\n\tpipeline = rd.compute_pipeline_create(shader)\n\tparams_buffer = rd.storage_buffer_create(PARAMETER_SIZE)\n\tdepth_sampler = rd.sampler_create(RDSamplerState.new())\n\nfunc _render_callback(_callback_type: int, render_data: RenderData) -> void:\n\tif rd == null or not pipeline.is_valid() or not params_buffer.is_valid():\n\t\treturn\n\n\tvar render_scene_buffers := render_data.get_render_scene_buffers() as RenderSceneBuffersRD\n\tif render_scene_buffers == null:\n\t\treturn\n\n\tvar internal_size: Vector2i = render_scene_buffers.get_internal_size()\n\tif internal_size.x <= 0 or internal_size.y <= 0:\n\t\treturn\n\n\tvar color_image: RID = render_scene_buffers.get_color_layer(0)\n\tvar depth_texture: RID = render_scene_buffers.get_depth_layer(0)\n\tif not color_image.is_valid() or not depth_texture.is_valid():\n\t\treturn\n\n\tvar scene_data := render_data.get_render_scene_data()\n\tif scene_data == null:\n\t\treturn\n\n\tvar inv_projection: Projection = scene_data.get_cam_projection().inverse()\n\tvar params := PackedFloat32Array([\n\t\tinv_projection.x.x, inv_projection.x.y, inv_projection.x.z, inv_projection.x.w,\n\t\tinv_projection.y.x, inv_projection.y.y, inv_projection.y.z, inv_projection.y.w,\n\t\tinv_projection.z.x, inv_projection.z.y, inv_projection.z.z, inv_projection.z.w,\n\t\tinv_projection.w.x, inv_projection.w.y, inv_projection.w.z, inv_projection.w.w,\n\t\tfloat(internal_size.x), float(internal_size.y),\n\t\t2.0, 0.0025,\n\t\t1.0, 0.15, 0.03, 1.0,\n\t])\n\trd.buffer_update(params_buffer, 0, params.size() * 4, params.to_byte_array())\n\n\tvar params_uniform := RDUniform.new()\n\tparams_uniform.uniform_type = RenderingDevice.UNIFORM_TYPE_STORAGE_BUFFER\n\tparams_uniform.binding = 0\n\tparams_uniform.add_id(params_buffer)\n\n\tvar color_uniform := RDUniform.new()\n\tcolor_uniform.uniform_type = RenderingDevice.UNIFORM_TYPE_IMAGE\n\tcolor_uniform.binding = 1\n\tcolor_uniform.add_id(color_image)\n\n\tvar depth_uniform := RDUniform.new()\n\tdepth_uniform.uniform_type = RenderingDevice.UNIFORM_TYPE_SAMPLER_WITH_TEXTURE\n\tdepth_uniform.binding = 2\n\tdepth_uniform.add_id(depth_sampler)\n\tdepth_uniform.add_id(depth_texture)\n\n\tif uniform_set.is_valid():\n\t\trd.free_rid(uniform_set)\n\tuniform_set = rd.uniform_set_create([params_uniform, color_uniform, depth_uniform], shader, 0)\n\tif not uniform_set.is_valid():\n\t\treturn\n\n\tvar groups_x := ceili(float(internal_size.x) / WORKGROUP_SIZE)\n\tvar groups_y := ceili(float(internal_size.y) / WORKGROUP_SIZE)\n\tvar compute_list := rd.compute_list_begin()\n\trd.compute_list_bind_compute_pipeline(compute_list, pipeline)\n\trd.compute_list_bind_uniform_set(compute_list, uniform_set, 0)\n\trd.compute_list_dispatch(compute_list, groups_x, groups_y, 1)\n\trd.compute_list_end()","lineStart":1,"lineEnd":93,"totalLines":93,"truncated":false}},"title":"workspace/scripts/outline_effect.gd","time":{"start":1790257067992,"end":1790257068013}},"metadata":{"openai":{"itemId":"fc_01cb0583087d4ec2016ab527a969048197a3642e351cad9b30"}},"id":"prt_0d3a2f7d20019H30tn7ynPc38K","sessionID":"ses_f2c6258dcffe2iOA1fa71CRgXY","messageID":"msg_0d3a2db71001dayIhgTmmgHIoB"}}
