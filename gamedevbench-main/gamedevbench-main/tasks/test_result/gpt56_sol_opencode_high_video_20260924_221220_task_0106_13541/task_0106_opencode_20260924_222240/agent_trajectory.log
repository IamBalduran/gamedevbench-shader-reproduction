> params.depth_threshold) {\n47: \t\t\t\tis_outline = true;\n48: \t\t\t\tbreak;\n49: \t\t\t}\n50: \t\t}\n51: \t}\n52: \n53: \tif (is_outline) {\n54: \t\timageStore(color_image, pixel, params.outline_color);\n55: \t}\n56: }\n\n(End of file - total 56 lines)\n</content>","metadata":{"preview":"#[compute]\n#version 450\n\nlayout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;\n\nlayout(set = 0, binding = 0, std430) readonly buffer Params {\n\tmat4 inv_proj_mat;\n\tvec4 outline_color;\n\tvec2 viewport_size;\n\tfloat depth_threshold;\n\tfloat sample_size;\n\tvec2 padding;\n} params;\n\nlayout(set = 0, binding = 1, rgba16f) uniform image2D color_image;\nlayout(set = 0, binding = 2) uniform sampler2D depth_texture;\n\nfloat get_linear_depth(vec2 uv) {\n\tfloat depth = texture(depth_texture, uv).r;\n\tvec4 view_position = params.inv_proj_mat * vec4(uv * 2.0 - 1.0, depth, 1.0);","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/outline.glsl","text":"#[compute]\n#version 450\n\nlayout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;\n\nlayout(set = 0, binding = 0, std430) readonly buffer Params {\n\tmat4 inv_proj_mat;\n\tvec4 outline_color;\n\tvec2 viewport_size;\n\tfloat depth_threshold;\n\tfloat sample_size;\n\tvec2 padding;\n} params;\n\nlayout(set = 0, binding = 1, rgba16f) uniform image2D color_image;\nlayout(set = 0, binding = 2) uniform sampler2D depth_texture;\n\nfloat get_linear_depth(vec2 uv) {\n\tfloat depth = texture(depth_texture, uv).r;\n\tvec4 view_position = params.inv_proj_mat * vec4(uv * 2.0 - 1.0, depth, 1.0);\n\treturn -view_position.z / view_position.w;\n}\n\nvoid main() {\n\tivec2 pixel = ivec2(gl_GlobalInvocationID.xy);\n\tivec2 viewport = ivec2(params.viewport_size);\n\tif (pixel.x >= viewport.x || pixel.y >= viewport.y) {\n\t\treturn;\n\t}\n\n\tvec2 uv = (vec2(pixel) + 0.5) / params.viewport_size;\n\tfloat center_depth = get_linear_depth(uv);\n\tbool is_outline = false;\n\n\tint radius = int(params.sample_size);\n\tfor (int y = -radius; y <= radius && !is_outline; y++) {\n\t\tfor (int x = -radius; x <= radius; x++) {\n\t\t\tif (x == 0 && y == 0) {\n\t\t\t\tcontinue;\n\t\t\t}\n\t\t\tvec2 neighbor_uv = (vec2(pixel + ivec2(x, y)) + 0.5) / params.viewport_size;\n\t\t\tif (neighbor_uv.x < 0.0 || neighbor_uv.x > 1.0 || neighbor_uv.y < 0.0 || neighbor_uv.y > 1.0) {\n\t\t\t\tcontinue;\n\t\t\t}\n\t\t\tfloat neighbor_depth = get_linear_depth(neighbor_uv);\n\t\t\tif (abs(neighbor_depth - center_depth) > params.depth_threshold) {\n\t\t\t\tis_outline = true;\n\t\t\t\tbreak;\n\t\t\t}\n\t\t}\n\t}\n\n\tif (is_outline) {\n\t\timageStore(color_image, pixel, params.outline_color);\n\t}\n}","lineStart":1,"lineEnd":56,"totalLines":56,"truncated":false}},"title":"workspace/outline.glsl","time":{"start":1790259625936,"end":1790259625960}},"metadata":{"openai":{"itemId":"fc_02aafba5639a83c3016ab531a6e6cc87d18dc68150084726d9"}},"id":"prt_0d3c9ffcd001aJSSKFZnE3eSUm","sessionID":"ses_f2c3d31bcffeeA5te3FZLhroep","messageID":"msg_0d3c92044001Bxl8lNnNkw3jwK"}}
