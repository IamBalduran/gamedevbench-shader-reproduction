{"type":"tool_use","timestamp":1790262827233,"sessionID":"ses_f2c0e458effeis5iBSwTK7Szq4","part":{"type":"tool","tool":"write","callID":"call_cc1a848dc9ec462db0d5bea9","state":{"status":"completed","input":{"filePath":"/workspace/setup_shader.gd","content":"@tool\nextends EditorScript\n\nfunc _run():\n\tvar packed_scene: PackedScene = load(\"res://scenes/main.tscn\")\n\tvar root: Control = packed_scene.instantiate()\n\tvar preview: TextureRect = root.get_node(\"DistortionPreview\")\n\n\tvar vs = VisualShader.new()\n\tvs.graph_offset = Vector2(-200, -100)\n\n\tconst ID_UV = 1\n\tconst ID_WAVE_X = 2\n\tconst ID_WAVE_Y = 3\n\tconst ID_DISTORT_X = 4\n\tconst ID_DISTORT_Y = 5\n\tconst ID_DISTORTION = 6\n\tconst ID_TEXTURE = 7\n\tconst ID_OUTPUT = 8\n\n\t# UV input node\n\tvar uv_node = VisualShaderNodeInput.new()\n\tuv_node.input_name = \"UV\"\n\tvs.add_node(VisualShaderNode.TYPE_CANVAS_ITEM, uv_node, Vector2(0, 0), ID_UV)\n\n\t# Float constants\n\tvar wave_x = VisualShaderNodeFloatConstant.new()\n\twave_x.constant = 7.0\n\tvs.add_node(VisualShaderNode.TYPE_FRAGMENT, wave_x, Vector2(-200, 100), ID_WAVE_X)\n\n\tvar wave_y = VisualShaderNodeFloatConstant.new()\n\twave_y.constant = 5.0\n\tvs.add_node(VisualShaderNode.TYPE_FRAGMENT, wave_y, Vector2(-200, 160), ID_WAVE_Y)\n\n\tvar distort_x = VisualShaderNodeFloatConstant.new()\n\tdistort_x.constant = 0.1\n\tvs.add_node(VisualShaderNode.TYPE_FRAGMENT, distort_x, Vector2(-200, 220), ID_DISTORT_X)\n\n\tvar distort_y = VisualShaderNodeFloatConstant.new()\n\tdistort_y.constant = 0.1\n\tvs.add_node(VisualShaderNode.TYPE_FRAGMENT, distort_y, Vector2(-200, 280), ID_DISTORT_Y)\n\n\t# DistortionUV custom node\n\tvar distortion = VisualShaderNodeUVdistortion.new()\n\tvs.add_node(VisualShaderNode.TYPE_FRAGMENT, distortion, Vector2(200, 100), ID_DISTORTION)\n\n\t# Texture sampler node\n\tvar tex_node = VisualShaderNodeTexture.new()\n\ttex_node.source = VisualShaderNodeTexture.SOURCE_TYPE_TEXTURE\n\ttex_node.texture_type = VisualShaderNodeTexture.TYPE_DATA\n\tvs.add_node(VisualShaderNode.TYPE_FRAGMENT, tex_node, Vector2(500, 100), ID_TEXTURE)\n\n\t# Find output node - it may be auto-created\n\tvar output = null\n\tfor node_id in vs.get_node_list(VisualShader.TYPE_FRAGMENT):\n\t\tif vs.get_node_type(VisualShader.TYPE_FRAGMENT, node_id) == VisualShaderNodeOutput:\n\t\t\toutput = vs.get_node(VisualShader.TYPE_FRAGMENT, node_id)\n\t\t\toutput.set_position(Vector2(800, 100))\n\t\t\tbreak\n\n\tif output == null:\n\t\toutput = VisualShaderNodeOutput.new()\n\t\tvs.add_node(VisualShaderNode.TYPE_FRAGMENT, output, Vector2(800, 100), ID_OUTPUT)\n\n\t# Connect: UV -> Distortion (port 0 = uv)\n\tvs.connect_nodes(VisualShader.TYPE_CANVAS_ITEM, ID_UV, 0, VisualShader.TYPE_FRAGMENT, ID_DISTORTION, 0)\n\n\t# Connect: Constants -> Distortion\n\tvs.connect_nodes(VisualShader.TYPE_FRAGMENT, ID_WAVE_X, 0, VisualShader.TYPE_FRAGMENT, ID_DISTORTION, 1)\n\tvs.connect_nodes(VisualShader.TYPE_FRAGMENT, ID_WAVE_Y, 0, VisualShader.TYPE_FRAGMENT, ID_DISTORTION, 2)\n\tvs.connect_nodes(VisualShader.TYPE_FRAGMENT, ID_DISTORT_X, 0, VisualShader.TYPE_FRAGMENT, ID_DISTORTION, 3)\n\tvs.connect_nodes(VisualShader.TYPE_FRAGMENT, ID_DISTORT_Y, 0, VisualShader.TYPE_FRAGMENT, ID_DISTORTION, 4)\n\n\t# Connect: Distortion output -> Texture UV input\n\tvs.connect_nodes(VisualShader.TYPE_FRAGMENT, ID_DISTORTION, 0, VisualShader.TYPE_FRAGMENT, ID_TEXTURE, 0)\n\n\t# Connect: Texture output -> Output node color input\n\tvs.connect_nodes(VisualShader.TYPE_FRAGMENT, ID_TEXTURE, 0, VisualShader.TYPE_FRAGMENT, vs.get_node_list(VisualShader.TYPE_FRAGMENT).back(), 0)\n\n\t# Create ShaderMaterial and assign\n\tvar sm = ShaderMaterial.new()\n\tsm.shader = vs\n\tpreview.material = sm\n\n\t# Save the visual shader as a .tres file\n\tResourceSaver.save(vs, \"res://distortion_visual_shader.tres\")\n\n\t# Re-pack and save scene\n\tvar new_packed = PackedScene.new()\n\tvar result = new_packed.pack(root)\n\tif result != OK:\n\t\tprinterr(\"Failed to pack scene: \", result)\n\t\treturn\n\n\tvar save_result = ResourceSaver.save(new_packed, \"res://scenes/main.tscn\")\n\tif save_result != OK:\n\t\tprinterr(\"Failed to save scene: \", save_result)\n\t\treturn\n\n\tprint(\"SUCCESS: Scene updated with VisualShader and DistortionUV node\")"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/setup_shader.gd","exists":false,"truncated":false},"title":"workspace/setup_shader.gd","time":{"start":1790262827206,"end":1790262827224}},"metadata":{"openai":{"itemId":"msg_b89886bd-9579-463f-8aa2-a796973894a6"}},"id":"prt_0d3fad8c0001biq5cINtf5hiBV","sessionID":"ses_f2c0e458effeis5iBSwTK7Szq4","messageID":"msg_0d3f8805d001hSrJprozh6FIOo"}}
