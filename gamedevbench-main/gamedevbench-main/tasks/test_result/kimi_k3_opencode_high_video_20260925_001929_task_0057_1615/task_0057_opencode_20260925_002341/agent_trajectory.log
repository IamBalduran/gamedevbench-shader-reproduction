{"type":"tool_use","timestamp":1790266833123,"sessionID":"ses_f2bc8bf9cffeih4PtW76ZM9XCp","part":{"type":"tool","tool":"write","callID":"write:11","state":{"status":"completed","input":{"content":"extends CharacterBody2D\n\n## Movement speed in pixels per second.\n@export var speed: float = 60.0\n\n## How close the unit needs to be to its target before it stops.\n@export var target_radius: float = 8.0\n\n## Whether this unit is currently selected (toggles the aura highlight).\nvar selected: bool = false:\n\tset = set_selected\n\n## Position the unit is moving toward.\nvar target: Vector2:\n\tset = set_target\n\n\nfunc _ready() -> void:\n\t# Give every instance its own ShaderMaterial so toggling the\n\t# selection aura on one unit never affects the others.\n\t$Sprite2D.material = $Sprite2D.material.duplicate()\n\tset_selected(selected)\n\tset_target(global_position)\n\n\nfunc _physics_process(delta: float) -> void:\n\tvar direction := Vector2.ZERO\n\tvar to_target := target - global_position\n\tif to_target.length() > target_radius:\n\t\tdirection = to_target.normalized()\n\tdirection += avoid()\n\tif direction != Vector2.ZERO:\n\t\tmove_and_collide(direction.normalized() * speed * delta)\n\n\nfunc set_selected(value: bool) -> void:\n\tselected = value\n\tvar sprite: Sprite2D = get_node_or_null(\"Sprite2D\")\n\tif sprite != null and sprite.material is ShaderMaterial:\n\t\t(sprite.material as ShaderMaterial).set_shader_parameter(\n\t\t\t\"aura_width\", 1.0 if value else 0.0\n\t\t)\n\n\nfunc set_target(value: Vector2) -> void:\n\ttarget = value\n\n\n## Repulsion force pushing this unit away from nearby units.\nfunc avoid() -> Vector2:\n\tvar push := Vector2.ZERO\n\tfor body in $Detect.get_overlapping_bodies():\n\t\tif body == self:\n\t\t\tcontinue\n\t\tvar away := global_position - body.global_position\n\t\tvar distance := away.length()\n\t\tif distance > 0.0:\n\t\t\tpush += away.normalized() / distance\n\treturn push\n","filePath":"/workspace/scripts/unit.gd"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/workspace/scripts/unit.gd","exists":true,"truncated":false},"title":"workspace/scripts/unit.gd","time":{"start":1790266833097,"end":1790266833111}},"metadata":{"openai":{"itemId":"fc_write:11"}},"id":"prt_0d437f8c6001pPE2lKpGvS1046","sessionID":"ses_f2bc8bf9cffeih4PtW76ZM9XCp","messageID":"msg_0d437abc4001yldtBuVt4tF686"}}
