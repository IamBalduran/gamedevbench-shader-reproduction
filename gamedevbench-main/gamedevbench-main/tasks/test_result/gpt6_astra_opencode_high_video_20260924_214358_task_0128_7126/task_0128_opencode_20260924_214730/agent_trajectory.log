;\n48: }\n49: \n50: \n51: /****** Color functions ******/\n52: \n53: vec4 alpha_blend (vec4 top, vec4 bot) {\t\n54: \treturn vec4( top.r * top.a + bot.r * bot.a * (1. - top.a),\n55: \t\t\t\t top.g * top.a + bot.g * bot.a * (1. - top.a),\n56: \t\t\t\t top.b * top.a + bot.b * bot.a * (1. - top.a),\n57: \t\t\t\t 1.0);\n58: } \n59: \n60: \n61: vec4 getColor(float i) {\n62: \tif(color_method == 1) {\n63: \t\tvec4 ramp;\n64: \t\tvec4 accent;\n65: \n66: \t\t// Create gradient\n67: \t\tramp = mix(gradient_start, gradient_end, i); \t\n68: \t\t\n69: \t\t//gaussian formula ae^( -(x-b)^2 / 2c^2 )\n70: \t\t// a = curve's peak = 1.0\n71: \t\t// b = center of peak position\n72: \t\t// c = standard deviation which controls width of bell\n73: \t\t\n74: \t\tfloat gaussianx = exp( -((i-accent_position)*(i-accent_position)) / (2.*accent_width*accent_width) );\n75: \t\taccent = vec4(gradient_accent.r*gaussianx,\n76: \t\t\t\t\t  gradient_accent.g*gaussianx,\n77: \t\t\t\t\t  gradient_accent.b*gaussianx,\n78: \t\t\t\t\t  gaussianx);\n79: \t\t\n80: \t\treturn alpha_blend(accent, ramp);\n81: \t}\n82: \t\n83: \telse {\n84: \t\t/* Sin/Cos creates a smooth wave between 1 and -1, offset from each other. \n85: \t\t*  You can have 4 evenly distributed offsets from sin, cos, -sin, -cos\n86: \t\t*  (sin(x) +1) / 2 -> changes the wave to go between 0 and 1 with the same frequency, +2../4 will go from 0.5 and 1.0\n87: \t\t*  Calculate full cycles with: sin(cycles*6.5*i)   or   (sin(cycles*5.4*i)+1.0)/2.0   or   (cos(cycles*3.8*i)+1.0)/2.0\n88: \t\t*/\n89:        \treturn vec4( (sin(red_frequency*6.5*i + red_phase) +1.0)/2.0,\n90: \t       \t\t\t (sin(green_frequency*6.5*i + green_phase) +1.0)/2.0,\n91:        \t\t\t\t (sin(blue_frequency*6.5*i + blue_phase) + 1.0)/2.0,\n92: \t\t\t\t\t 1.);\n93: \t}\n94: }\n95: \n96: \n97: /****** Fragement Main ******/\n98: \n99: void fragment() {\t\n100: \tfloat i = 0.0;\n101: \t\n102: \thighp vec2 c = seed;\n103: \t\n104: \thighp vec2 z;\n105: \tz.x = aspect_ratio * (UV.x - 0.5) / scale - position.x;\n106: \tz.y = (UV.y - 0.5) / scale + position.y;\n107: \t\n108: \tif(power==2.0)\n109: \t\twhile( i<iterations && length(z) <= escape ) { \n110: \t\t\tz = vec2(z.x*z.x - z.y*z.y, power*z.x*z.y) + c;\t\t//20fps\n111: \t\t\ti++;\t\t\n112: \t\t}\t\t\n113: \telse\n114: \t\twhile( i<iterations && length(z) <= escape ) { \n115: \t\t\tz = c_pow(z, power) + c;\t\t\t\t\t\t\t//6-7fps\t\t\t\t\n116: \t\t\ti++;\t\n117: \t\t}\n118: \n119: \n120: \tvec4 color;\n121: \n122: \tif (i >= iterations) \n123: \t\tcolor = vec4(0.0, 0.0, 0.0, 1.0);\n124: \telse { \n125: \t\tif(smoothing==1 && power>1.) i -= log(log(length(z))) / log(power);\t\t\n126: \t\tcolor = getColor(i/iterations);\n127: \t}\n128: \t\t\n129: \tCOLOR = color;\n130: }\n131: \n\n(End of file - total 131 lines)\n</content>","metadata":{"preview":"shader_type canvas_item;\n\nuniform int   color_method = 0;\nuniform int   smoothing = 1;\nuniform vec4  gradient_start : source_color = vec4(0.18, 0., 0.45, 1.);\nuniform vec4  gradient_end : source_color = vec4(1., 1., 0., 1.);\nuniform vec4  gradient_accent : source_color = vec4(1., 1., 0., 1.);\nuniform float accent_position = 0.65;\nuniform float accent_width = 0.34;\nuniform float red_frequency=1.6615;\nuniform float green_frequency=1.246;\nuniform float blue_frequency=0.831;\nuniform float red_phase=6.3;\nuniform float green_phase=6.3;\nuniform float blue_phase=6.3;\n\n\nuniform highp float scale = 0.5;\nuniform highp vec2  position = vec2(0.0, 0.0);\nuniform float aspect_ratio = 1.778;","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/materials/julia.gdshader","text":"shader_type canvas_item;\n\nuniform int   color_method = 0;\nuniform int   smoothing = 1;\nuniform vec4  gradient_start : source_color = vec4(0.18, 0., 0.45, 1.);\nuniform vec4  gradient_end : source_color = vec4(1., 1., 0., 1.);\nuniform vec4  gradient_accent : source_color = vec4(1., 1., 0., 1.);\nuniform float accent_position = 0.65;\nuniform float accent_width = 0.34;\nuniform float red_frequency=1.6615;\nuniform float green_frequency=1.246;\nuniform float blue_frequency=0.831;\nuniform float red_phase=6.3;\nuniform float green_phase=6.3;\nuniform float blue_phase=6.3;\n\n\nuniform highp float scale = 0.5;\nuniform highp vec2  position = vec2(0.0, 0.0);\nuniform float aspect_ratio = 1.778;\n\nuniform highp vec2 seed = vec2(-0.794084, 0.136444);\nuniform float power = 2.0;\nuniform float iterations = 50.0;\nuniform float escape = 4.0;\n\n\n/****** Math functions ******/\n \nhighp vec2 c_pol(highp vec2 c) { \t// Convert from rectangular to polar\n\thighp float radius = length(c);\n\thighp float theta = atan(c.y, c.x);\n\treturn vec2(radius, theta);\n}\n\nhighp vec2 c_rec(highp vec2 c) { \t// Convert from rectangular to Polar\n\thighp float radius = abs(c.x);\n\thighp float theta = c.y;\n\thighp float a = radius * cos(theta);\n\thighp float b = radius * sin(theta);\n\treturn vec2(a, b);\n}\n\n\nhighp vec2 c_pow(highp vec2 base, highp float ex) { // Calculate base ^ exponent\n\thighp vec2  b = c_pol(base);\n\treturn c_rec( vec2(pow(b.x, ex), b.y*ex) );\n}\n\n\n/****** Color functions ******/\n\nvec4 alpha_blend (vec4 top, vec4 bot) {\t\n\treturn vec4( top.r * top.a + bot.r * bot.a * (1. - top.a),\n\t\t\t\t top.g * top.a + bot.g * bot.a * (1. - top.a),\n\t\t\t\t top.b * top.a + bot.b * bot.a * (1. - top.a),\n\t\t\t\t 1.0);\n} \n\n\nvec4 getColor(float i) {\n\tif(color_method == 1) {\n\t\tvec4 ramp;\n\t\tvec4 accent;\n\n\t\t// Create gradient\n\t\tramp = mix(gradient_start, gradient_end, i); \t\n\t\t\n\t\t//gaussian formula ae^( -(x-b)^2 / 2c^2 )\n\t\t// a = curve's peak = 1.0\n\t\t// b = center of peak position\n\t\t// c = standard deviation which controls width of bell\n\t\t\n\t\tfloat gaussianx = exp( -((i-accent_position)*(i-accent_position)) / (2.*accent_width*accent_width) );\n\t\taccent = vec4(gradient_accent.r*gaussianx,\n\t\t\t\t\t  gradient_accent.g*gaussianx,\n\t\t\t\t\t  gradient_accent.b*gaussianx,\n\t\t\t\t\t  gaussianx);\n\t\t\n\t\treturn alpha_blend(accent, ramp);\n\t}\n\t\n\telse {\n\t\t/* Sin/Cos creates a smooth wave between 1 and -1, offset from each other. \n\t\t*  You can have 4 evenly distributed offsets from sin, cos, -sin, -cos\n\t\t*  (sin(x) +1) / 2 -> changes the wave to go between 0 and 1 with the same frequency, +2../4 will go from 0.5 and 1.0\n\t\t*  Calculate full cycles with: sin(cycles*6.5*i)   or   (sin(cycles*5.4*i)+1.0)/2.0   or   (cos(cycles*3.8*i)+1.0)/2.0\n\t\t*/\n       \treturn vec4( (sin(red_frequency*6.5*i + red_phase) +1.0)/2.0,\n\t       \t\t\t (sin(green_frequency*6.5*i + green_phase) +1.0)/2.0,\n       \t\t\t\t (sin(blue_frequency*6.5*i + blue_phase) + 1.0)/2.0,\n\t\t\t\t\t 1.);\n\t}\n}\n\n\n/****** Fragement Main ******/\n\nvoid fragment() {\t\n\tfloat i = 0.0;\n\t\n\thighp vec2 c = seed;\n\t\n\thighp vec2 z;\n\tz.x = aspect_ratio * (UV.x - 0.5) / scale - position.x;\n\tz.y = (UV.y - 0.5) / scale + position.y;\n\t\n\tif(power==2.0)\n\t\twhile( i<iterations && length(z) <= escape ) { \n\t\t\tz = vec2(z.x*z.x - z.y*z.y, power*z.x*z.y) + c;\t\t//20fps\n\t\t\ti++;\t\t\n\t\t}\t\t\n\telse\n\t\twhile( i<iterations && length(z) <= escape ) { \n\t\t\tz = c_pow(z, power) + c;\t\t\t\t\t\t\t//6-7fps\t\t\t\t\n\t\t\ti++;\t\n\t\t}\n\n\n\tvec4 color;\n\n\tif (i >= iterations) \n\t\tcolor = vec4(0.0, 0.0, 0.0, 1.0);\n\telse { \n\t\tif(smoothing==1 && power>1.) i -= log(log(length(z))) / log(power);\t\t\n\t\tcolor = getColor(i/iterations);\n\t}\n\t\t\n\tCOLOR = color;\n}\n","lineStart":1,"lineEnd":131,"totalLines":131,"truncated":false}},"title":"workspace/materials/julia.gdshader","time":{"start":1790257496089,"end":1790257496104}},"metadata":{"openai":{"itemId":"fc_05d65ebdc06ec7f0016ab52955a3088195af9e8a220512df69"}},"id":"prt_0d3a98015001yQFf0WTY5LEkIK","sessionID":"ses_f2c571880ffeEpQUgI8RYerNRH","messageID":"msg_0d3a96e86001pY97BCttPrO1ud"}}
