EX, 1.0);\n\tvec3 normal = normalize((INV_VIEW_MATRIX * vec4(NORMAL, 0.0)).xyz);\n\tvec3 adjusted_normal = abs(normal);\n\tvec3 weights = adjusted_normal / (adjusted_normal.x + adjusted_normal.y + adjusted_normal.z);\n\tvec2 uv_x = vertex.zy;\n\tvec2 uv_y = vertex.xz;\n\tvec2 uv_z = vertex.xy;\n\tvec4 color_x = texture(texture_x, uv_x) * weights.x;\n\tvec4 color_y = texture(texture_x, uv_y) * weights.y;\n\tvec4 color_z = texture(texture_x, uv_z) * weights.z;\n\tALBEDO = color_x.rgb + color_y.rgb + color_z.rgb;\n}","lineStart":1,"lineEnd":17,"totalLines":17,"truncated":false}},"title":"workspace/scripts/triplanar_basic.gdshader","time":{"start":1790263753863,"end":1790263753880}},"metadata":{"openai":{"itemId":"msg_e35c8b8c-d76d-4b41-9cda-6446c26169f7"}},"id":"prt_0d408fc84001sHWrmiFi0HZE74","sessionID":"ses_f2bfb2f7effe8eVFm35yWA1Yzg","messageID":"msg_0d408bd6e001AtP4EJXfaGscgp"}}
