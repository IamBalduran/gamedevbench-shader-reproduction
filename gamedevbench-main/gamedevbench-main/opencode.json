{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6-astra",
  "small_model": "openai/gpt-6-astra",
  "default_agent": "build",
  "enabled_providers": [
    "openai"
  ],
  "permission": "allow",
  "provider": {
    "openai": {
      "npm": "@ai-sdk/openai",
      "name": "Shubiaobiao",
      "options": {
        "baseURL": "https://api.shubiaobiao.cn/v1",
        "apiKey": "{env:OPENAI_API_KEY}",
        "timeout": false
      },
      "models": {
        "gpt-6-astra": {
          "name": "GPT-6 Astra"
        },
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol"
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro"
        },
        "gemini-3.1-pro-preview": {
          "name": "Gemini 3.1 Pro Preview"
        },
        "kimi-k3": {
          "name": "Kimi K3"
        }
      }
    }
  },
  "agent": {
    "build": {
      "model": "openai/gpt-6-astra",
      "steps": 30
    }
  },
  "autoupdate": false,
  "plugin": [
    "file:///REPLACE_WITH_LOCAL_REPO_PATH/gamedevbench/shubiaobiao_plugin.mjs"
  ]
}
